/*
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-jyDDNuvGOw9GKWbgrZDzC+xjYUZBse7JAudNCscuvxA=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; media-src https: blob:; frame-src https://embed.windy.com https://www.youtube-nocookie.com https://archive.org; connect-src 'self' https://cloudflareinsights.com https://de1.api.radio-browser.info https://api.open-meteo.com https://gutendex.com https://www.gutenberg.org https://ice1.somafm.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=(self), browsing-topics=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# `! Cache-Control` drops the /* value first: every matching rule otherwise
# joins its header onto the earlier ones (live assets sent both, 25/09/26).
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/og/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=604800

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/scripts/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

# Service worker must revalidate every load so new deploys propagate.
/sw.js
  ! Cache-Control
  Cache-Control: no-cache

/games/deep-swarm/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  ! Cache-Control
  Cache-Control: public, max-age=604800
