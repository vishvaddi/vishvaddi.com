{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vishvaddi-com",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // /api/tts: voice picked by name from the ElevenLabs premade set (Charlie, Australian),
  // monthly character budget before the pages fall back to the browser voice.
  // The key itself is a secret: `npx wrangler secret put ELEVENLABS_API_KEY`.
  "vars": {
    "TTS_VOICE_NAME": "Charlie",
    "TTS_MONTHLY_CHARS": "150000",
    // Pro (paywall experiment, docs/PRO_PLAN.md): Stripe price ids, empty until
    // Vish creates the product. Secrets (not vars): `npx wrangler secret put STRIPE_SECRET_KEY`
    // and `npx wrangler secret put STRIPE_WEBHOOK_SECRET`.
    "STRIPE_PRICE_YEAR": "price_1UFVis1069bHoZmxzK1fLzGN",
    "STRIPE_PRICE_MONTH": "price_1UFVlC1069bHoZmxr8aUEwl2",
    // Free-use quota addendum: gated actions per rolling 30 days before the upsell.
    "FREE_USES": "3"
  },
  "durable_objects": {
    "bindings": [
      { "name": "RL_DO", "class_name": "RateLimiter" },
      { "name": "PIN_ATTEMPTS", "class_name": "PinAttempts" }
    ]
  },
  "d1_databases": [
    {
      "binding": "DEEP_SWARM_DB",
      "database_name": "deep-swarm-saves",
      "database_id": "6ff4adb7-cdde-43cc-ac71-221e09389100",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["PinAttempts"] }
  ]
}
