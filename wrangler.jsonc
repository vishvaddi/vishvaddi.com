{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vishvaddi-com",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // /api/tts: voice picked by name from the ElevenLabs premade set (Charlie, Australian),
  // monthly character budget before the pages fall back to the browser voice.
  // The key itself is a secret: `npx wrangler secret put ELEVENLABS_API_KEY`.
  "vars": {
    "TTS_VOICE_NAME": "Charlie",
    "TTS_MONTHLY_CHARS": "150000",
    // Pro (paywall experiment, docs/PRO_PLAN.md): Stripe price ids for the A$100/year
    // and A$20/month subscriptions and the A$5 one-off 7-day pass (a one-time price,
    // not recurring). All three must be set or checkout reports "not configured".
    // These are the SANDBOX prices (acct ...1069bHoZmx); live mode needs its own ids.
    // The retired A$39/yr and A$5/mo prices must never be wired back. Secrets (not vars):
    // `npx wrangler secret put STRIPE_SECRET_KEY` and `npx wrangler secret put STRIPE_WEBHOOK_SECRET`.
    "STRIPE_PRICE_YEAR": "price_1UGFl41069bHoZmxsrKc9R9X",
    "STRIPE_PRICE_MONTH": "price_1UGFlg1069bHoZmxbvoF0yQN",
    "STRIPE_PRICE_PASS": "price_1UGFmV1069bHoZmxcxlhqgo3"
  },
  "durable_objects": {
    "bindings": [
      { "name": "RL_DO", "class_name": "RateLimiter" },
      { "name": "PIN_ATTEMPTS", "class_name": "PinAttempts" }
    ]
  },
  "d1_databases": [
    {
      "binding": "DEEP_SWARM_DB",
      "database_name": "deep-swarm-saves",
      "database_id": "6ff4adb7-cdde-43cc-ac71-221e09389100",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["PinAttempts"] }
  ]
}
