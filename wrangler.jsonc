{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vishvaddi-com",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "RL_DO", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }]
}
