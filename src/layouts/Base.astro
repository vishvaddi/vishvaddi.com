---
import "../styles/global.css";
import { SITE_TOOLS, SITE_TOOL_CATEGORIES } from "../data/site-tools";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  updatedDate?: Date;
  siteNav?: boolean;
  noindex?: boolean;
  immersive?: boolean;
  workspace?: boolean;
}

const {
  title = "Vish Vaddi",
  description = "Vish Vaddi — estimator, builder, writer.",
  ogImage = "/og/index.png",
  updatedDate,
  siteNav = false,
  noindex = false,
  immersive = false,
  workspace = false,
} = Astro.props;

const here = Astro.url.pathname.replace(/\/$/, "");
const activeToolHref = here === "/site/sheet" ? "/site/cut-list" : here;
const currentTool = SITE_TOOLS.find((tool) => tool.href === activeToolHref);

const navPrimary: [string, string][] = [
  ["/site", "Tools"],
  ["/prepping", "Prepping"],
];
const navMore: [string, string][] = [
  ["/notes", "Notes"],
  ["/radio", "Radio"],
  ["/feeds", "Feeds"],
  ["/reader", "Reader"],
  ["/studio", "Studio"],
  ["/games", "Games"],
  ["/music", "Music"],
  ["/tv", "TV"],
  ["/movies", "Movies"],
  ["/books", "Books"],
  ["/about", "About"],
];
const pathOnly = (href: string) => href.split("#")[0].split("?")[0].replace(/\/$/, "") || "/";
const isActive = (href: string) => {
  const path = pathOnly(href);
  return here === path || here.startsWith(path + "/");
};
const moreActive = navMore.some(([href]) => isActive(href));
const showRail = siteNav && here !== "/site";
const workspacePage = workspace || showRail;

const fullTitle = title === "Vish Vaddi" ? title : `${title} · Vish Vaddi`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const updatedFmt = updatedDate
  ? new Intl.DateTimeFormat("en-AU", { year: "numeric", month: "short", day: "numeric" }).format(updatedDate)
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
        } catch (_) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafaf7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#161613" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{fullTitle}</title>
  </head>
  <body class:list={[immersive && "immersive-page", workspacePage && "workspace-page"]}>
    {!immersive && <header>
      <nav class="topnav" aria-label="Primary">
        <a class="brand" href="/"><strong>Vish Vaddi</strong></a>
        <div class="navlinks">
          {navPrimary.map(([href, label]) => (
            <a href={href} class={isActive(href) ? "active" : ""}>{label}</a>
          ))}
          <details class="nav-more">
            <summary class={moreActive ? "active" : ""}>More</summary>
            <div class="nav-more-menu">
              {navMore.map(([href, label]) => (
                <a href={href} class={isActive(href) ? "active" : ""}>{label}</a>
              ))}
            </div>
          </details>
        </div>
        <button
          type="button"
          class="theme-toggle"
          id="standby-toggle"
          aria-label="Standby mode"
          title="Standby (Alt+S)"
        >◷</button>
        <button
          type="button"
          class="theme-toggle"
          id="theme-toggle"
          aria-label="Toggle dark mode"
        >◐</button>
      </nav>
      <hr />
    </header>}
    <main>
      {showRail && (
        <>
          <nav class="site-rail" aria-label="Site tools">
            <div class="site-nav-head">
              <span class="rail-title">Site tools</span>
              <a href="/site" class="site-nav-all">All</a>
            </div>
            <label class="site-tool-search-label">
              <span class="sr-only">Find a tool</span>
              <input class="site-tool-search" type="search" placeholder="Find a tool…" autocomplete="off" data-site-tool-search />
            </label>
            <div class="site-nav-groups">
              {SITE_TOOL_CATEGORIES.map((category) => (
                <section class="site-nav-group" data-site-tool-group>
                  <span class="site-nav-category">{category}</span>
                  {SITE_TOOLS.filter((tool) => tool.category === category).map((tool) => (
                    <a
                      href={tool.href}
                      class={activeToolHref === tool.href ? "active" : ""}
                      aria-current={activeToolHref === tool.href ? "page" : undefined}
                      data-site-tool-link
                      data-search={`${tool.title} ${tool.aliases}`}
                    >{tool.shortTitle}</a>
                  ))}
                </section>
              ))}
            </div>
          </nav>
          <details class="site-picker">
            <summary><span>Tools</span><strong>{currentTool?.shortTitle ?? "Choose a tool"}</strong></summary>
            <nav class="site-picker-panel" aria-label="Site tools">
              <div class="site-picker-top">
                <a href="/site">All tools</a>
                <label class="site-tool-search-label">
                  <span class="sr-only">Find a tool</span>
                  <input class="site-tool-search" type="search" placeholder="Find a tool…" autocomplete="off" data-site-tool-search />
                </label>
              </div>
              {SITE_TOOL_CATEGORIES.map((category) => (
                <section class="site-nav-group" data-site-tool-group>
                  <span class="site-nav-category">{category}</span>
                  <div class="site-picker-links">
                    {SITE_TOOLS.filter((tool) => tool.category === category).map((tool) => (
                      <a
                        href={tool.href}
                        class={activeToolHref === tool.href ? "active" : ""}
                        aria-current={activeToolHref === tool.href ? "page" : undefined}
                        data-site-tool-link
                        data-search={`${tool.title} ${tool.aliases}`}
                      >{tool.shortTitle}</a>
                    ))}
                  </div>
                </section>
              ))}
            </nav>
          </details>
        </>
      )}
      <slot />
      {!immersive && <aside class="site-quote" aria-live="polite">
        <span class="quote-mark" aria-hidden="true">“</span>
        <span id="site-quote-text">Prevention beats repair.</span>
        <span class="quote-mark quote-mark-close" aria-hidden="true">”</span>
      </aside>}
    </main>
    {!immersive && <footer>
      <hr />
      {updatedFmt && (
        <p style="font-size: 0.875rem; color: var(--muted);">
          Last updated {updatedFmt}.
        </p>
      )}
      <p style="font-size: 0.875rem; color: var(--muted);">
        © {new Date().getFullYear()} Vish Vaddi · Sydney ·
        <a href="mailto:vishvaddi@gmail.com">vishvaddi@gmail.com</a> ·
        <a href="/privacy">Privacy</a>
      </p>
    </footer>}
    <script src="/scripts/chrome.js" defer></script>
    <script src="/scripts/reveal.js" defer></script>
    <script src="/scripts/standby.js" defer></script>
    <script src="/scripts/quotes.js" defer></script>
  </body>
</html>
