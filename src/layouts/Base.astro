---
import "../styles/global.css";
import { SITE_TOOLS, SITE_TOOL_CATEGORIES } from "../data/site-tools";
import { AUDIO_TOOLS, AUDIO_TOOL_CATEGORIES } from "../data/audio-tools";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  updatedDate?: Date;
  siteNav?: boolean;
  audioNav?: boolean;
  noindex?: boolean;
  immersive?: boolean;
  workspace?: boolean;
}

const {
  title = "Vish Vaddi",
  description = "Vish Vaddi — estimator, builder, writer.",
  ogImage = "/og/index.png",
  updatedDate,
  siteNav = false,
  audioNav = false,
  noindex = false,
  immersive = false,
  workspace = false,
} = Astro.props;

const here = Astro.url.pathname.replace(/\/$/, "");
// Sheet and Notepad are modes of Cut List and Calculator, so the rail highlights the parent.
const activeToolHref = here === "/site/sheet" ? "/site/cut-list" : here === "/site/notepad" ? "/site/calc" : here;
// One rail component, two catalogues: /site tools and /audio tools share the markup.
const rail = audioNav
  ? { tools: AUDIO_TOOLS as readonly { href: string; title: string; shortTitle: string; aliases: string; category: string }[], categories: AUDIO_TOOL_CATEGORIES as readonly string[], hub: "/audio", title: "Audio tools" }
  : { tools: SITE_TOOLS as readonly { href: string; title: string; shortTitle: string; aliases: string; category: string }[], categories: SITE_TOOL_CATEGORIES as readonly string[], hub: "/site", title: "Site tools" };
const currentTool = rail.tools.find((tool) => tool.href === activeToolHref);

const navPrimary: [string, string][] = [
  ["/site", "Tools"],
  ["/prepping", "Prepping"],
];
// "More" is grouped so the menu reads as a map, not a list. /music is the
// listening log, so it is labelled by what it is to avoid two "Music" entries.
// The site is public; chrome.js hides [data-private] (owner-only links such as
// Lock site) for anyone without the vv_owner marker cookie.
const navMoreGroups: { label: string | null; links: [string, string][]; private?: boolean; collapsed?: boolean }[] = [
  { label: "Music", links: [["/studio", "Studio"], ["/audio", "Audio tools"], ["/radio", "Radio"]] },
  { label: "Read", links: [["/feeds", "Feeds"], ["/reader", "Reader"]] },
  // Life is hidden (owner-only) until it is developed further; the Worker 404s it for everyone else.
  { label: "Life", links: [["/kitchen", "Kitchen"], ["/money", "Money"], ["/training", "Training"]], private: true },
  { label: null, links: [["/games", "Games"], ["/tv", "TV"], ["/pro", "Pro"], ["/about", "About"], ["/logout", "Lock site"]] },
  // Logs are dormant, so they sit behind a second disclosure instead of taking menu space.
  { label: "Logs", links: [["/music", "Listening"], ["/movies", "Movies"], ["/books", "Books"], ["/notes", "Notes"]], collapsed: true },
];
const navMore: [string, string][] = navMoreGroups.flatMap((group) => group.links);

// Command-palette index (Ctrl+K), built once server-side and shipped as a JSON
// data block — see public/scripts/palette.js. Keyed by href so the same page
// linked from two places (e.g. /studio from both the nav and the extra-pages
// list below) only appears once.
interface PaletteEntry { href: string; title: string; group: string; keywords: string }
const paletteIndex = new Map<string, PaletteEntry>();
const addPalette = (href: string, title: string, group: string, keywords = "") => {
  if (!paletteIndex.has(href)) paletteIndex.set(href, { href, title, group, keywords });
};
SITE_TOOLS.forEach((tool) => addPalette(tool.href, tool.title, "Site tools", `${tool.shortTitle} ${tool.aliases}`));
AUDIO_TOOLS.forEach((tool) => addPalette(tool.href, tool.title, "Audio tools", `${tool.shortTitle} ${tool.aliases}`));
navPrimary.forEach(([href, label]) => addPalette(href, label, "Pages"));
// Life is owner-only and /logout isn't a destination worth finding — both excluded.
navMoreGroups
  .filter((group) => !group.private)
  .forEach((group) => group.links.forEach(([href, label]) => {
    if (href !== "/logout") addPalette(href, label, "Pages");
  }));
([
  ["/studio", "Studio"],
  ["/radio", "Radio"],
  ["/reader", "Reader"],
  ["/feeds", "Feeds"],
  ["/prepping/tools", "Prepping tools"],
] as [string, string][]).forEach(([href, label]) => addPalette(href, label, "Pages"));
// Games hub links to these but they aren't Astro pages under src/pages, so they
// need listing by hand (kept in sync with src/pages/games/index.astro).
([
  ["/games/deep-swarm/", "Deep Swarm", "deep sea horror survival sub"],
  ["/games/last-cast/", "Last Cast", "alien fishing survival"],
  ["/games/carromancy/", "Carromancy", "carrom roguelike"],
  ["/games/big2", "Big 2", "shedding card game roguelike"],
] as [string, string, string][]).forEach(([href, title, keywords]) => addPalette(href, title, "Games", keywords));
const paletteIndexJson = JSON.stringify(Array.from(paletteIndex.values())).replace(/</g, "\\u003c");

const pathOnly = (href: string) => href.split("#")[0].split("?")[0].replace(/\/$/, "") || "/";
const isActive = (href: string) => {
  const path = pathOnly(href);
  return here === path || here.startsWith(path + "/");
};
const moreActive = navMore.some(([href]) => isActive(href));
const showRail = (siteNav && here !== "/site") || (audioNav && here !== "/audio");
const workspacePage = workspace || showRail;

const fullTitle = title === "Vish Vaddi" ? title : `${title} · Vish Vaddi`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const updatedFmt = updatedDate
  ? new Intl.DateTimeFormat("en-AU", { year: "numeric", month: "short", day: "numeric" }).format(updatedDate)
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
        } catch (_) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafaf7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#161613" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{fullTitle}</title>
  </head>
  <body class:list={[immersive && "immersive-page", workspacePage && "workspace-page"]}>
    {!immersive && <header>
      <nav class="topnav" aria-label="Primary">
        <a class="brand" href="/"><strong>Vish Vaddi</strong></a>
        <div class="navlinks">
          {navPrimary.map(([href, label]) => (
            <a href={href} class={isActive(href) ? "active" : ""}>{label}</a>
          ))}
          <details class="nav-more">
            <summary class={moreActive ? "active" : ""}>More</summary>
            <div class="nav-more-menu">
              {navMoreGroups.map((group) => group.collapsed ? (
                <details class="nav-more-sub" open={group.links.some(([href]) => isActive(href)) || undefined}>
                  <summary class="nav-more-label">{group.label}</summary>
                  <div class="nav-more-group">
                    {group.links.map(([href, label]) => (
                      <a href={href} class={isActive(href) ? "active" : ""}>{label}</a>
                    ))}
                  </div>
                </details>
              ) : (
                <div class="nav-more-group" data-private={group.private ? "" : undefined}>
                  {group.label && <span class="nav-more-label">{group.label}</span>}
                  {group.links.map(([href, label]) => (
                    <a href={href} class={isActive(href) ? "active" : ""} data-private={href === "/logout" ? "" : undefined}>{label}</a>
                  ))}
                </div>
              ))}
            </div>
          </details>
        </div>
        <button
          type="button"
          class="theme-toggle"
          id="palette-toggle"
          aria-label="Go to (Ctrl+K)"
          title="Go to (Ctrl+K)"
        >⌕</button>
        <button
          type="button"
          class="theme-toggle"
          id="standby-toggle"
          aria-label="Standby mode"
          title="Standby (Alt+S)"
        >◷</button>
        <button
          type="button"
          class="theme-toggle"
          id="theme-toggle"
          aria-label="Toggle dark mode"
        >◐</button>
      </nav>
      <hr />
    </header>}
    <main>
      {showRail && (
        <>
          <nav class="site-rail" aria-label={rail.title}>
            <div class="site-nav-head">
              <span class="rail-title">{rail.title}</span>
              <a href={rail.hub} class="site-nav-all">All</a>
            </div>
            <label class="site-tool-search-label">
              <span class="sr-only">Find a tool</span>
              <input class="site-tool-search" type="search" placeholder="Find a tool…" autocomplete="off" data-site-tool-search />
            </label>
            <div class="site-nav-groups">
              {rail.categories.filter((category) => rail.tools.some((tool) => tool.category === category)).map((category) => (
                <section class="site-nav-group" data-site-tool-group>
                  <span class="site-nav-category">{category}</span>
                  {rail.tools.filter((tool) => tool.category === category).map((tool) => (
                    <a
                      href={tool.href}
                      class={activeToolHref === tool.href ? "active" : ""}
                      aria-current={activeToolHref === tool.href ? "page" : undefined}
                      data-site-tool-link
                      data-search={`${tool.title} ${tool.aliases}`}
                    >{tool.shortTitle}</a>
                  ))}
                </section>
              ))}
            </div>
          </nav>
          <details class="site-picker">
            <summary><span>Tools</span><strong>{currentTool?.shortTitle ?? "Choose a tool"}</strong></summary>
            <nav class="site-picker-panel" aria-label={rail.title}>
              <div class="site-picker-top">
                <a href={rail.hub}>All tools</a>
                <label class="site-tool-search-label">
                  <span class="sr-only">Find a tool</span>
                  <input class="site-tool-search" type="search" placeholder="Find a tool…" autocomplete="off" data-site-tool-search />
                </label>
              </div>
              {rail.categories.filter((category) => rail.tools.some((tool) => tool.category === category)).map((category) => (
                <section class="site-nav-group" data-site-tool-group>
                  <span class="site-nav-category">{category}</span>
                  <div class="site-picker-links">
                    {rail.tools.filter((tool) => tool.category === category).map((tool) => (
                      <a
                        href={tool.href}
                        class={activeToolHref === tool.href ? "active" : ""}
                        aria-current={activeToolHref === tool.href ? "page" : undefined}
                        data-site-tool-link
                        data-search={`${tool.title} ${tool.aliases}`}
                      >{tool.shortTitle}</a>
                    ))}
                  </div>
                </section>
              ))}
            </nav>
          </details>
        </>
      )}
      <slot />
      {!immersive && <aside class="site-quote" aria-live="polite">
        <span class="quote-mark" aria-hidden="true">“</span>
        <span id="site-quote-text">Prevention beats repair.</span>
        <span class="quote-mark quote-mark-close" aria-hidden="true">”</span>
      </aside>}
    </main>
    {!immersive && <footer>
      <hr />
      {updatedFmt && (
        <p style="font-size: 0.875rem; color: var(--muted);">
          Last updated {updatedFmt}.
        </p>
      )}
      <p style="font-size: 0.875rem; color: var(--muted);">
        © {new Date().getFullYear()} Vish Vaddi · Sydney ·
        <a href="mailto:vishvaddi@gmail.com">vishvaddi@gmail.com</a> ·
        <a href="/privacy">Privacy</a> · <a href="/logout" data-private>Lock site</a>
      </p>
    </footer>}
    {!immersive && (
      <div class="vv-palette" id="vv-palette" hidden role="dialog" aria-modal="true" aria-label="Go to">
        <div class="vv-palette-panel">
          <input
            class="vv-palette-input"
            id="vv-palette-input"
            type="text"
            placeholder="Go to a tool or page…"
            autocomplete="off"
            spellcheck="false"
            aria-label="Go to a tool or page"
            aria-controls="vv-palette-results"
            role="combobox"
            aria-expanded="false"
          />
          <ul class="vv-palette-results" id="vv-palette-results" role="listbox"></ul>
        </div>
      </div>
    )}
    <!-- JSON data block, not a script — the CSP's script-src has no 'unsafe-inline', so
         palette.js (a plain /public asset) fetches this by id rather than running inline. -->
    <script type="application/json" id="vv-palette-index" set:html={paletteIndexJson} />
    <script src="/scripts/chrome.js" defer></script>
    <script src="/scripts/install.js" defer></script>
    <script src="/scripts/reveal.js" defer></script>
    <script src="/scripts/standby.js" defer></script>
    <script src="/scripts/quotes.js" defer></script>
    <script src="/scripts/palette.js" defer></script>
  </body>
</html>
