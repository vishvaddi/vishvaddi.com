---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  updatedDate?: Date;
  siteNav?: boolean;
}

const {
  title = "Vish Vaddi",
  description = "Vish Vaddi — senior estimator, builder, writer.",
  ogImage = "/og/index.png",
  updatedDate,
  siteNav = false,
} = Astro.props;

const siteTools: [string, string][] = [
  ["/site", "All tools"],
  ["/site/cut-list", "Cut List"],
  ["/site/sheet", "2D Sheet"],
  ["/site/materials", "Materials"],
  ["/site/geometry", "Geometry"],
  ["/site/convert", "Converter"],
  ["/site/rate", "Rate Builder"],
  ["/site/sketch", "Sketchpad"],
  ["/site/voice", "Voice Notes"],
  ["/site/pdf", "PDF Editor"],
  ["/site/resources", "Resources"],
  ["/prepping", "Field Survival"],
];
const here = Astro.url.pathname.replace(/\/$/, "");

const navPrimary: [string, string][] = [
  ["/work", "Work"],
  ["/notes", "Notes"],
  ["/blog", "Blog"],
  ["/prepping", "Prepping"],
  ["/site", "Site"],
  ["/about", "About"],
];
const navMore: [string, string][] = [
  ["/latest", "Latest"],
  ["/studio", "Studio"],
  ["/music", "Music"],
  ["/movies", "Movies"],
  ["/books", "Books"],
];
const isActive = (href: string) => here === href || here.startsWith(href + "/");
const showRail = siteNav && here !== "/site";

const fullTitle = title === "Vish Vaddi" ? title : `${title} · Vish Vaddi`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const updatedFmt = updatedDate
  ? new Intl.DateTimeFormat("en-AU", { year: "numeric", month: "short", day: "numeric" }).format(updatedDate)
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
        } catch (_) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafaf7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#161613" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Vish Vaddi — Notes" href="/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header>
      <nav class="topnav" aria-label="Primary">
        <a class="brand" href="/"><strong>Vish Vaddi</strong></a>
        <div class="navlinks">
          {navPrimary.map(([href, label]) => (
            <a href={href} class={isActive(href) ? "active" : ""}>{label}</a>
          ))}
          <details class="nav-more">
            <summary>More</summary>
            <div class="nav-more-menu">
              {navMore.map(([href, label]) => (
                <a href={href} class={isActive(href) ? "active" : ""}>{label}</a>
              ))}
            </div>
          </details>
        </div>
        <button
          type="button"
          class="theme-toggle"
          id="theme-toggle"
          aria-label="Toggle dark mode"
        >◐</button>
      </nav>
      <hr />
    </header>
    <main>
      {showRail && (
        <>
          <nav class="site-rail" aria-label="Site tools">
            <span class="rail-title">Site Tools</span>
            {siteTools.map(([href, label]) => (
              <a href={href} class={here === href.replace(/\/$/, "") ? "active" : ""}>{label}</a>
            ))}
          </nav>
          <nav class="site-chips" aria-label="Site tools">
            {siteTools.map(([href, label]) => (
              <a href={href} class={here === href.replace(/\/$/, "") ? "active" : ""}>{label}</a>
            ))}
          </nav>
        </>
      )}
      <slot />
    </main>
    <footer>
      <hr />
      {updatedFmt && (
        <p style="font-size: 0.875rem; color: var(--muted);">
          Last updated {updatedFmt}.
        </p>
      )}
      <p style="font-size: 0.875rem; color: var(--muted);">
        © {new Date().getFullYear()} Vish Vaddi · Sydney ·
        <a href="mailto:vishvaddi@gmail.com">vishvaddi@gmail.com</a>
      </p>
    </footer>
    <script src="/scripts/chrome.js" defer></script>
  </body>
</html>
