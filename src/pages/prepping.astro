---
import Base from "../layouts/Base.astro";
import { getEntry, render } from "astro:content";
import "../styles/site.css";

const entry = await getEntry("pages", "prepping");
if (!entry) throw new Error("pages/prepping.md not found");
const { Content } = await render(entry);
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  updatedDate={entry.data.updatedDate}
>
  <Content />

  <section id="prep-tools" class="blueprint">
    <p class="eyebrow">Interactive</p>
    <h2>Field tools</h2>
    <p>
      The working version of the notes above — reserve calculators, a get-home
      estimate, a live nearby map, a kit-maintenance tracker and an SOS
      signaller. Everything runs in your browser; only the map's location lookup
      leaves your device.
    </p>
    <div id="prep-app"></div>
  </section>

  <script>
    import { initPrepping, buildPreppingNav } from "../scripts/site/prepping";
    initPrepping();
    buildPreppingNav();
  </script>
</Base>

<style>
  /* A clearly delineated "tools" zone: editorial hairline frame with an accent
     top stripe and a faint accent wash, so the switch from notes to app is
     deliberate rather than abrupt. */
  #prep-tools {
    margin-top: 3.5rem;
    padding: 1.25rem 1.25rem 1.5rem;
    border: 1px solid var(--rule);
    border-top: 3px solid var(--site-accent, #2c63d6);
    border-radius: 10px;
    background: color-mix(in srgb, var(--site-accent, #2c63d6) 3.5%, transparent);
  }
  #prep-tools > h2 { margin-top: 0.35rem; }
  /* This embed borrows the blueprint tool styling but not its fixed graph-paper backdrop. */
  #prep-tools.blueprint::before {
    display: none;
  }
</style>

<style is:global>
  /* On-this-page TOC. Mobile dropdown by default; fixed rail on wide screens. */
  .prep-toc { display: none; }
  .prep-toc-m {
    margin: 0 0 1.75rem;
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 8px;
    padding: 0.4rem 0.8rem;
  }
  .prep-toc-m summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
    font-family: var(--font-mono, monospace);
  }
  .prep-toc-m ul {
    list-style: none;
    margin: 0.6rem 0 0.2rem;
    padding: 0;
    columns: 2;
    column-gap: 1.2rem;
    font-size: 0.82rem;
  }
  .prep-toc-m li { margin: 0; break-inside: avoid; }
  .prep-toc-m a {
    display: block;
    padding: 0.18rem 0;
    color: var(--muted);
    text-decoration: none;
  }
  .prep-toc-m a.active { color: var(--fg); }
  .prep-toc-m-group {
    font-family: var(--font-mono, monospace);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0.6rem 0 0.2rem;
  }
  .prep-toc-m ul + .prep-toc-m-group { margin-top: 0.85rem; }

  @media (min-width: 1100px) {
    .prep-toc-m { display: none; }
    .prep-toc {
      display: block;
      position: fixed;
      top: 5.5rem;
      left: max(1rem, calc((100vw - 38rem) / 2 - 14rem));
      width: 12rem;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
      font-size: 0.82rem;
      line-height: 1.3;
      scrollbar-width: thin;
    }
    .prep-toc-title {
      font-family: var(--font-mono, monospace);
      font-size: 0.66rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.5rem;
    }
    .prep-toc ul { list-style: none; margin: 0; padding: 0; }
    .prep-toc ul + .prep-toc-title { margin-top: 1rem; }
    .prep-toc li { margin: 0; }
    .prep-toc a {
      display: block;
      color: var(--muted);
      text-decoration: none;
      padding: 0.22rem 0.5rem;
      border-left: 2px solid transparent;
      border-radius: 4px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .prep-toc a:hover { color: var(--fg); }
    .prep-toc a.active {
      color: var(--fg);
      border-left-color: #2c63d6;
      background: color-mix(in srgb, currentColor 7%, transparent);
    }
    :root[data-theme="dark"] .prep-toc a.active,
    :root:not([data-theme="light"]) .prep-toc a.active { border-left-color: #6ea0ff; }
  }
  @media print { .prep-toc, .prep-toc-m { display: none !important; } }
</style>
