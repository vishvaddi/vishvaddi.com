---
import Base from "../layouts/Base.astro";
import { getEntry, render } from "astro:content";
import "../styles/prepping.css";

const entry = await getEntry("pages", "prepping");
if (!entry) throw new Error("pages/prepping.md not found");
const { Content } = await render(entry);
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  updatedDate={entry.data.updatedDate}
>
  <nav class="prep-modes" aria-label="Prepping sections">
    <a href="/prepping" class="active">Knowledge</a>
    <a href="/prepping/tools">Tools</a>
  </nav>

  <div id="prep-knowledge">
    <Content />
  </div>

  <script>
    import { buildPreppingNav } from "../scripts/site/prepping";
    buildPreppingNav();
  </script>
</Base>
