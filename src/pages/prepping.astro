---
import Base from "../layouts/Base.astro";
import { getEntry, render } from "astro:content";
import "../styles/prepping.css";

const entry = await getEntry("pages", "prepping");
if (!entry) throw new Error("pages/prepping.md not found");
const { Content } = await render(entry);
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  updatedDate={entry.data.updatedDate}
>
  <nav class="prep-modes" aria-label="Prepping sections">
    <a href="/prepping" class="active">Knowledge</a>
    <a href="/prepping/tools">Tools</a>
  </nav>

  <div id="prep-knowledge">
    <Content />
  </div>

  <section id="prep-weather" style="margin-top:2.5rem">
    <h2>Live weather</h2>
    <p style="font-size:0.9rem;color:var(--muted);margin-bottom:0.75rem">
      Surface wind and pressure — southern Australia. Powered by Windy / ECMWF.
      Full screen: <a href="/tv">TV → Wind channel</a>.
    </p>
    <div style="border-radius:10px;overflow:hidden;border:1px solid var(--rule)">
      <iframe
        src="https://embed.windy.com/embed2.html?lat=-33.87&lon=151.21&zoom=4&level=surface&overlay=wind&product=ecmwf&menu=&message=true&marker=&calendar=now&pressure=&type=map&location=coordinates&detail=&metricWind=km%2Fh&metricTemp=%C2%B0C&radarRange=-1"
        width="100%" height="420" frameborder="0" title="Windy live weather map"
        style="display:block"
      ></iframe>
    </div>
  </section>

  <script>
    import { buildPreppingNav } from "../scripts/site/prepping";
    buildPreppingNav();
  </script>
</Base>
