---
import Base from "../../layouts/Base.astro";
import "../../styles/site.css";
import "../../styles/audio.css";
---

<Base
  title="BPM Maths — Delay Times, LFO Rates, Bars to Seconds, Hz to Note"
  description="Tap or type a tempo and read every note value in milliseconds and hertz for delays and LFOs, reverb pre-delay and decay starting points, bars to seconds and samples, and Hz to note, MIDI and cents. Runs in your browser."
  audioNav
>
  <div class="blueprint tool">
    <p class="eyebrow"><a href="/audio" style="color:inherit;text-decoration:none">Audio</a> / BPM maths</p>
    <h1>BPM Maths</h1>
    <p>
      The numbers you keep working out on a phone calculator mid-session: note
      values in milliseconds for delays, in hertz for LFOs, reverb times that
      land on the grid, and how long eight bars actually is.
    </p>

    <div class="bm-tempo">
      <label>Tempo <input id="bm-bpm" type="number" min="20" max="400" step="0.1" value="120" inputmode="decimal" /></label>
      <button type="button" class="btn" id="bm-tap">Tap tempo</button>
      <span class="au-muted" id="bm-tap-count"></span>
      <button type="button" class="btn btn-ghost btn-sm" id="bm-half">½×</button>
      <button type="button" class="btn btn-ghost btn-sm" id="bm-double">2×</button>
      <label>Time signature
        <select id="bm-sig"><option value="4/4">4/4</option><option value="3/4">3/4</option><option value="6/8">6/8</option><option value="2/4">2/4</option><option value="5/4">5/4</option><option value="7/8">7/8</option></select>
      </label>
    </div>

    <h2>Note values</h2>
    <div class="au-table-wrap">
      <table class="au-table bm-table">
        <thead><tr><th>Note</th><th>Straight</th><th>Dotted</th><th>Triplet</th><th>LFO rate</th></tr></thead>
        <tbody id="bm-notes"></tbody>
      </table>
    </div>

    <h2>Reverb starting points</h2>
    <div class="au-table-wrap">
      <table class="au-table bm-table">
        <thead><tr><th>Character</th><th>Pre-delay</th><th>Decay</th></tr></thead>
        <tbody id="bm-reverb"></tbody>
      </table>
    </div>
    <p class="au-muted">Conventions, not rules: pre-delay keeps the transient in front of the wash, decay in whole bars keeps the tail rhythmic. Tune by ear from here.</p>

    <h2>Length converters</h2>
    <div class="bm-grid">
      <label class="bm-field">Bars <input id="bm-bars" type="number" min="0" step="1" value="8" inputmode="numeric" /><output id="bm-bars-out"></output></label>
      <label class="bm-field">Seconds <input id="bm-seconds" type="number" min="0" step="0.01" value="30" inputmode="decimal" /><output id="bm-seconds-out"></output></label>
      <label class="bm-field">Samples <input id="bm-samples" type="number" min="0" step="1" value="44100" inputmode="numeric" /><output id="bm-samples-out"></output></label>
      <label class="bm-field">Sample rate <select id="bm-rate"><option value="44100">44.1 kHz</option><option value="48000">48 kHz</option><option value="96000">96 kHz</option></select></label>
    </div>

    <h2>Pitch converter</h2>
    <label class="bm-field bm-pitch">Hz, note or MIDI <input id="bm-pitch" type="text" placeholder="55 · A1 · F#3 · m45" autocomplete="off" /><output id="bm-pitch-out"></output></label>
    <p class="note-foot">A4 = 440 Hz. Wavelength assumes 343 m/s, handy for room modes and mic placement.</p>
  </div>

  <script>
    import { initBpmMaths } from "../../scripts/site/audio/bpm";
    initBpmMaths();
  </script>
</Base>
