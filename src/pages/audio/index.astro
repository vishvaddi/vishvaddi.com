---
import Base from "../../layouts/Base.astro";
import "../../styles/site.css";
import { AUDIO_TOOLS, AUDIO_TOOL_CATEGORIES } from "../../data/audio-tools";
---

<Base
  title="Audio Tools"
  description="Free browser-based tools for producers and DJs: track analysis, loudness, key and BPM, MIDI, sample prep and ear training. Audio never leaves your device."
  audioNav
>
  <div class="blueprint">
    <p class="eyebrow">Producer tools</p>
    <h1>Audio Tools</h1>
    <p>
      Utilities for producers and DJs that run entirely in your browser — no
      account, no upload, no server ever hears your audio. The full workstation
      lives at <a href="/studio">/studio</a>; these are the tools around it.
    </p>
    <p class="hub-related" aria-label="Related music pages">Also in Music: <a href="/studio">Studio</a> <a href="/radio">Radio</a></p>

    <label class="hub-search-label" for="site-hub-search">Find a tool</label>
    <input id="site-hub-search" class="hub-search" type="search" placeholder="Try ‘lufs’, ‘key’, ‘midi’…" autocomplete="off" />
    <p id="site-search-empty" class="note-foot" hidden>No matching tools.</p>

    <section id="site-recent" class="site-recent" hidden>
      <h2 class="site-group-title">Recently used</h2>
      <ul class="tool-grid" id="site-recent-grid"></ul>
    </section>

    {AUDIO_TOOL_CATEGORIES.filter((category) => AUDIO_TOOLS.some((tool) => tool.category === category)).map((category) => (
      <section class="site-tool-section" data-tool-group>
        <h2 class="site-group-title">{category}</h2>
        <ul class="tool-grid">
          {AUDIO_TOOLS.filter((tool) => tool.category === category).map((tool) => (
            <li data-tool-item data-search={`${tool.title} ${tool.aliases}`}>
              <a class="tool-card" href={tool.href} data-tool={tool.href}>
                <span class="tool-ico" aria-hidden="true">{tool.icon}</span>
                <span class="t">{tool.title}</span>
                <span class="d"><strong>Problem:</strong> {tool.problem}</span>
                <span class="d"><strong>Does:</strong> {tool.promise}</span>
                <span class="tool-privacy">Private · {tool.privacy}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="note-foot">
      Nothing you load leaves your browser. <a href="/">← vishvaddi.com</a>
    </p>
  </div>

  <script src="/scripts/site-hub.js" defer></script>
</Base>
