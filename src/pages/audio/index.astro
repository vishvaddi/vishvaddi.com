---
import Base from "../../layouts/Base.astro";
import "../../styles/site.css";
import { AUDIO_TOOLS, AUDIO_TOOL_CATEGORIES } from "../../data/audio-tools";
import { TOOL_ICONS, TOOL_ICON_FALLBACK } from "../../data/tool-icons";
---

<Base
  title="Audio Tools"
  description="Free browser-based tools for producers and DJs: track analysis, loudness, key and BPM, MIDI, sample prep and ear training."
  audioNav
>
  <div class="blueprint">
    <p class="eyebrow">Producer tools</p>
    <h1>Audio Tools</h1>
    <p>
      Free browser-based audio tools for producers and DJs — a chord and scale
      lab with MIDI export, batch sample prep, BPM maths, a tuner and
      metronome, a lo-fi effects processor, ear training and a track analyser
      for LUFS, key and BPM. No account, no upload, no server ever hears your
      audio. The full workstation lives at <a href="/studio">/studio</a>; these
      are the tools around it.
    </p>
    <p class="hub-related" aria-label="Related music pages">Also in Music: <a href="/studio">Studio</a> <a href="/radio">Radio</a></p>

    <label class="hub-search-label" for="site-hub-search">Find a tool</label>
    <input id="site-hub-search" class="hub-search" type="search" placeholder="Try ‘lufs’, ‘key’, ‘midi’…" autocomplete="off" />
    <p id="site-search-empty" class="note-foot" hidden>No matching tools.</p>

    <section class="vv-resume" id="vv-resume" hidden aria-labelledby="vv-resume-title">
      <h2 id="vv-resume-title" class="vv-resume-title">Pick up where you left off</h2>
      <div class="vv-resume-grid" id="vv-resume-grid" data-scope="audio"></div>
    </section>

    {AUDIO_TOOL_CATEGORIES.filter((category) => AUDIO_TOOLS.some((tool) => tool.category === category)).map((category) => (
      <section class="site-tool-section" data-tool-group>
        <h2 class="site-group-title">{category}</h2>
        <ul class="tool-grid">
          {AUDIO_TOOLS.filter((tool) => tool.category === category).map((tool, i) => (
            <li class="reveal" style={`--i: ${i}`} data-tool-item data-search={`${tool.title} ${tool.aliases}`}>
              <a class="tool-card" href={tool.href} data-tool={tool.href}>
                <span class="tool-ico" aria-hidden="true" set:html={TOOL_ICONS[tool.href] ?? TOOL_ICON_FALLBACK} />
                <span class="t">{tool.title}</span>
                <span class="d">{tool.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="site-faq" aria-labelledby="audio-faq-title">
      <h2 id="audio-faq-title" class="site-group-title">FAQ</h2>
      <details class="tool-faq-item">
        <summary>Are these audio tools free?</summary>
        <p>Yes — every tool here is free and unlimited. Pro only adds MP3 and stem export in Studio and batch/format extras noted on individual tool pages.</p>
      </details>
      <details class="tool-faq-item">
        <summary>Is my audio uploaded anywhere?</summary>
        <p>No — every tool decodes and processes audio entirely in your browser; nothing is sent to a server.</p>
      </details>
      <details class="tool-faq-item">
        <summary>What's the difference between these tools and Studio?</summary>
        <p>These are focused single-purpose tools. <a href="/studio">Studio</a> is the full workstation — drum machine, synth, mixer and export — that they sit around.</p>
      </details>
      <details class="tool-faq-item">
        <summary>Do I need an account?</summary>
        <p>No — no sign-up, no account. Open a tool and start using it.</p>
      </details>
    </section>

    <p class="note-foot">
      <a href="/">← vishvaddi.com</a>
    </p>
  </div>

  <script src="/scripts/resume.js" defer></script>
  <script src="/scripts/site-hub.js" defer></script>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      { "@type": "Question", name: "Are these audio tools free?", acceptedAnswer: { "@type": "Answer", text: "Yes — every tool here is free and unlimited. Pro only adds MP3 and stem export in Studio and batch/format extras noted on individual tool pages." } },
      { "@type": "Question", name: "Is my audio uploaded anywhere?", acceptedAnswer: { "@type": "Answer", text: "No — every tool decodes and processes audio entirely in your browser; nothing is sent to a server." } },
      { "@type": "Question", name: "What's the difference between these tools and Studio?", acceptedAnswer: { "@type": "Answer", text: "These are focused single-purpose tools. Studio is the full workstation — drum machine, synth, mixer and export — that they sit around." } },
      { "@type": "Question", name: "Do I need an account?", acceptedAnswer: { "@type": "Answer", text: "No — no sign-up, no account. Open a tool and start using it." } },
    ],
  })} />
</Base>
