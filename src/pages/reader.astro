---
import Base from "../layouts/Base.astro";
---

<Base title="Reader" description="Read classic books from Project Gutenberg.">
  <style is:global>
    .reader-wrap { max-width: 1100px; margin: 0 auto; padding: 1.5rem 1rem; }

    .search-bar {
      display: flex; gap: 0.5rem; margin-bottom: 2rem;
    }
    .search-bar input,
    .search-bar select {
      flex: 1; padding: 0.5rem 0.75rem; border: 1px solid var(--rule);
      background: var(--bg); color: var(--fg); font-family: var(--font-sans);
      font-size: 0.95rem; border-radius: 4px;
    }
    .search-bar select {
      flex: 0 0 13rem;
    }
    .search-bar button {
      padding: 0.5rem 1rem; background: var(--fg); color: var(--bg);
      border: none; border-radius: 4px; cursor: pointer; font-family: var(--font-sans);
      font-size: 0.95rem;
    }
    .search-bar .shuffle-btn {
      background: var(--code-bg);
      color: var(--fg);
      border: 1px solid var(--rule);
    }

    .book-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 1.25rem;
    }
    .book-card {
      cursor: pointer; text-align: center;
      transition: transform 0.15s;
    }
    .book-card:hover { transform: translateY(-3px); }
    .book-card img {
      width: 100%; aspect-ratio: 2/3; object-fit: cover;
      border-radius: 3px; border: 1px solid var(--rule);
      background: var(--code-bg);
    }
    .book-card .bk-title {
      font-size: 0.78rem; margin-top: 0.4rem; line-height: 1.3;
      color: var(--fg); font-family: var(--font-serif);
    }
    .book-card .bk-author { font-size: 0.7rem; color: var(--muted); margin-top: 0.15rem; }

    /* ── Reader UI ── */
    #reader-ui { display: none; }

    .reader-header {
      display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; flex-wrap: wrap;
    }
    .reader-header button {
      background: none; border: 1px solid var(--rule); color: var(--fg);
      padding: 0.3rem 0.6rem; border-radius: 4px; cursor: pointer;
      font-family: var(--font-sans); font-size: 0.85rem;
    }
    .reader-header h2 {
      flex: 1; font-size: 1rem; color: var(--muted); font-weight: 400; margin: 0;
      min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .reader-tools { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
    .reader-header .rh-icon {
      font-family: var(--font-mono); font-weight: 700; min-width: 2.1rem;
      padding: 0.3rem 0.5rem; text-align: center;
    }
    .reader-header .rh-font {
      background: var(--bg); color: var(--fg); border: 1px solid var(--rule);
      border-radius: 4px; padding: 0.3rem 0.4rem; font-size: 0.85rem;
      font-family: var(--font-sans); cursor: pointer;
    }

    /* Full-screen / immersive reading — works on every device (CSS-driven, so
       iOS Safari is covered even though it lacks element fullscreen). */
    /* display:flex must beat the inline style.display="block" the reader sets
       when a book opens — hence !important. Without it #reader-ui stayed block
       and the spread collapsed to the top instead of filling the screen. */
    body.reader-immersive #reader-ui {
      position: fixed; inset: 0; z-index: 9999; margin: 0; max-width: none;
      padding: 0.8rem clamp(0.75rem, 4vw, 2.5rem) 1rem;
      background: var(--bg); overflow: hidden;
      display: flex !important; flex-direction: column;
    }
    body.reader-immersive .reader-header { flex: 0 0 auto; }
    body.reader-immersive .reader-settings.open { flex: 0 0 auto; }
    body.reader-immersive .spread-wrap { flex: 1 1 auto; min-height: 0; width: 100%; max-width: 50rem; margin: 0 auto; }
    body.reader-immersive .spread { height: 100%; max-width: none; margin: 0; }
    body.reader-immersive .nav-row { flex: 0 0 auto; max-width: 50rem; width: 100%; margin: 0.6rem auto 0; }

    /* Settings panel */
    .reader-settings {
      background: var(--code-bg); border: 1px solid var(--rule); border-radius: 6px;
      padding: 0.75rem 1rem; margin-bottom: 1rem;
      display: none; gap: 1.5rem; align-items: center; flex-wrap: wrap;
    }
    .reader-settings.open { display: flex; }
    .rs-group { display: flex; align-items: center; gap: 0.5rem; }
    .rs-group label { font-size: 0.8rem; color: var(--muted); font-family: var(--font-sans); white-space: nowrap; }
    .rs-group input[type=range] { width: 90px; accent-color: var(--fg); }
    .rs-group span { font-size: 0.8rem; color: var(--fg); font-family: monospace; min-width: 2.5rem; }
    .rs-group select {
      font-size: 0.8rem; font-family: var(--font-sans); background: var(--bg);
      color: var(--fg); border: 1px solid var(--rule); border-radius: 3px; padding: 2px 4px;
    }

    /* Spread — single page (Kindle style): one panel, no spine, no flip. */
    .spread-wrap {
      position: relative; user-select: none;
      max-width: 44rem; margin: 0 auto;
    }
    .spread {
      display: block;
      background: #faf7f0; border-radius: 6px;
      box-shadow: 0 2px 20px rgba(0,0,0,0.18);
      height: clamp(500px, 74vh, 880px); position: relative;
    }
    .spread::after { display: none; }
    .page-panel.right, .page-flipper { display: none; }

    .page-panel {
      padding: 2.25rem 2.25rem; font-family: var(--font-serif); font-size: 0.95rem;
      line-height: 1.75; color: #3a2e20; overflow: hidden;
      position: relative; height: 100%; box-sizing: border-box;
      hyphens: auto; -webkit-hyphens: auto;
      text-rendering: optimizeLegibility;
    }
    .page-panel.left { border-radius: 6px; }
    .page-num {
      position: absolute; bottom: 1rem;
      font-size: 0.75rem; color: #9a8a72; font-family: var(--font-sans);
    }
    .page-panel.left .page-num { left: 2rem; }
    .page-panel.right .page-num { right: 2rem; }

    /* 3D flip */
    .page-flipper {
      position: absolute; top: 0; left: 50%; bottom: 0; width: 50%;
      transform-origin: left center;
      transform-style: preserve-3d;
      transition: transform 0.5s ease;
      pointer-events: none; z-index: 5;
    }
    .page-flipper.flip-fwd { transform: rotateY(-180deg); }
    .page-flipper.flip-back { transform: rotateY(0deg); }
    .flipper-face, .flipper-back {
      position: absolute; inset: 0;
      background: #faf7f0; backface-visibility: hidden;
      padding: 2.5rem 2rem; font-family: var(--font-serif); font-size: 0.95rem;
      line-height: 1.75; color: #3a2e20; overflow: hidden;
      hyphens: auto; -webkit-hyphens: auto;
    }
    .flipper-back { transform: rotateY(180deg); }

    .nav-row {
      display: flex; justify-content: space-between; align-items: center;
      margin-top: 1rem;
    }
    .nav-row button {
      background: none; border: 1px solid var(--rule); color: var(--fg);
      padding: 0.4rem 1rem; border-radius: 4px; cursor: pointer;
      font-family: var(--font-sans); font-size: 0.9rem;
    }
    .nav-row button:disabled { opacity: 0.3; cursor: default; }
    .nav-row .page-info { font-size: 0.85rem; color: var(--muted); }

    /* Mobile: single page */
    @media (max-width: 640px) {
      .spread { grid-template-columns: 1fr; }
      .page-panel.right { display: none; }
      .spread::after { display: none; }
      .page-flipper { display: none; }
    }

    /* Annotations */
    .note-btn {
      position: fixed; background: #f5c542; color: #222;
      border: none; border-radius: 4px; padding: 0.3rem 0.7rem;
      cursor: pointer; font-size: 0.85rem; display: none; z-index: 100;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
    .note-popup {
      position: fixed; background: var(--bg); border: 1px solid var(--rule);
      border-radius: 6px; padding: 1rem; z-index: 101; width: 260px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.15); display: none;
    }
    .note-popup textarea {
      width: 100%; height: 80px; resize: none; border: 1px solid var(--rule);
      background: var(--code-bg); color: var(--fg); font-family: var(--font-sans);
      font-size: 0.85rem; border-radius: 3px; padding: 0.4rem; box-sizing: border-box;
    }
    .note-colors { display: flex; gap: 0.4rem; margin: 0.5rem 0; }
    .note-colors button {
      width: 22px; height: 22px; border-radius: 50%; border: 2px solid transparent;
      cursor: pointer;
    }
    .note-colors button.active { border-color: var(--fg); }
    .note-popup-btns { display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.5rem; }
    .note-popup-btns button {
      background: none; border: 1px solid var(--rule); color: var(--fg);
      padding: 0.25rem 0.6rem; border-radius: 3px; cursor: pointer; font-size: 0.8rem;
    }
    .note-popup-btns button.save { background: var(--fg); color: var(--bg); }

    mark.ann-yellow { background: #ffe66a; color: inherit; border-radius: 2px; }
    mark.ann-green  { background: #b4f0a0; color: inherit; border-radius: 2px; }
    mark.ann-pink   { background: #fbb6ce; color: inherit; border-radius: 2px; }

    .load-more-row { display: flex; justify-content: center; margin: 1.75rem 0 0.5rem; }
    .load-more-row button {
      padding: 0.55rem 1.4rem; background: var(--code-bg); color: var(--fg);
      border: 1px solid var(--rule); border-radius: 4px; cursor: pointer;
      font-family: var(--font-sans); font-size: 0.9rem;
    }
    .load-more-row button:disabled { opacity: 0.5; cursor: default; }

    .loading { color: var(--muted); font-size: 0.9rem; padding: 2rem 0; }
    .error-msg { color: #c0392b; font-size: 0.9rem; padding: 1rem 0; }

    .audio-reader {
      display: none; max-width: 52rem; margin: 1.5rem auto 0;
      border: 1px solid var(--rule); border-radius: 10px; padding: 1rem;
      background: var(--code-bg);
    }
    .audio-reader.open { display: block; }
    .audio-reader audio { width: 100%; margin: 0.75rem 0; }
    .audio-meta { color: var(--muted); font-size: 0.86rem; margin: 0; }
    .chapter-list { display: grid; gap: 0.45rem; margin-top: 1rem; max-height: 52vh; overflow: auto; }
    .chapter-btn {
      text-align: left; border: 1px solid var(--rule); border-radius: 6px;
      background: var(--bg); color: var(--fg); padding: 0.55rem 0.7rem;
      cursor: pointer; font-family: var(--font-sans);
    }
    .chapter-btn.active { border-color: var(--accent); }
  </style>

  <div class="reader-wrap">
    <div id="library-ui">
      <div class="search-bar">
        <select id="source-select" aria-label="Library source">
          <option value="gutenberg">Project Gutenberg</option>
          <option value="librivox">LibriVox audiobooks</option>
        </select>
        <input type="text" id="search-input" placeholder="Search Project Gutenberg…" />
        <button id="search-btn">Search</button>
      </div>
      <div id="status" class="loading">Loading classics…</div>
      <div id="book-grid" class="book-grid"></div>
      <div class="load-more-row">
        <button id="load-more" style="display:none">Load more</button>
      </div>
    </div>

    <div id="reader-ui">
      <div class="reader-header">
        <button id="back-btn">← Library</button>
        <h2 id="book-title-label"></h2>
        <div class="reader-tools">
          <select id="font-sel" class="rh-font" title="Font" aria-label="Reading font">
            <option value="'Source Serif 4',Georgia,serif">Book</option>
            <option value="Georgia,serif">Georgia</option>
            <option value="'Palatino Linotype',serif">Palatino</option>
            <option value="system-ui,sans-serif">Sans</option>
          </select>
          <button id="font-dec" class="rh-icon" title="Smaller text" aria-label="Smaller text">A−</button>
          <button id="font-inc" class="rh-icon" title="Larger text" aria-label="Larger text">A+</button>
          <button id="fs-btn" title="Full screen">⛶ Full screen</button>
          <button id="dl-btn" title="Download the book as a text file">⬇ Download</button>
          <button id="settings-btn" title="Display settings">Aa</button>
        </div>
      </div>

      <div class="reader-settings" id="reader-settings">
        <div class="rs-group">
          <label for="rs-size">Size</label>
          <input type="range" id="rs-size" min="80" max="220" step="5" value="100">
          <span id="rs-size-val">100%</span>
        </div>
        <div class="rs-group">
          <label for="rs-lh">Spacing</label>
          <input type="range" id="rs-lh" min="140" max="220" step="10" value="175">
          <span id="rs-lh-val">1.75</span>
        </div>
        <div class="rs-group">
          <label for="rs-font">Font</label>
          <select id="rs-font">
            <option value="'Source Serif 4',Georgia,serif">Book</option>
            <option value="Georgia,serif">Georgia</option>
            <option value="'Palatino Linotype',serif">Palatino</option>
            <option value="system-ui,sans-serif">Sans</option>
          </select>
        </div>
        <div class="rs-group">
          <label for="rs-theme">Theme</label>
          <select id="rs-theme">
            <option value="#faf7f0,#3a2e20">Parchment</option>
            <option value="#fff,#1a1a1a">White</option>
            <option value="#1c1c14,#d4c9a8">Dark</option>
          </select>
        </div>
      </div>

      <div class="spread-wrap">
        <div class="spread" id="spread">
          <div class="page-panel left" id="left-panel">
            <span class="page-num" id="left-num"></span>
          </div>
          <div class="page-panel right" id="right-panel">
            <span class="page-num" id="right-num"></span>
          </div>
          <div class="page-flipper" id="page-flipper">
            <div class="flipper-face" id="flipper-face"></div>
            <div class="flipper-back" id="flipper-back"></div>
          </div>
        </div>
      </div>

      <div class="nav-row">
        <button id="prev-btn">← Prev</button>
        <span class="page-info" id="page-info"></span>
        <button id="next-btn">Next →</button>
      </div>

      <div class="audio-reader" id="audio-reader">
        <p class="audio-meta" id="audio-meta"></p>
        <audio id="audio-player" controls preload="metadata"></audio>
        <div class="chapter-list" id="chapter-list"></div>
      </div>
    </div>
  </div>

  <button class="note-btn" id="note-btn">Note</button>
  <div class="note-popup" id="note-popup">
    <textarea id="note-text" placeholder="Add a note…"></textarea>
    <div class="note-colors">
      <button style="background:#ffe66a" data-color="yellow" class="active" title="Yellow"></button>
      <button style="background:#b4f0a0" data-color="green" title="Green"></button>
      <button style="background:#fbb6ce" data-color="pink" title="Pink"></button>
    </div>
    <div class="note-popup-btns">
      <button id="note-cancel">Cancel</button>
      <button class="save" id="note-save">Save</button>
    </div>
  </div>
</Base>

<script src="/scripts/reader.js" defer></script>
