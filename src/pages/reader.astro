---
import Base from "../layouts/Base.astro";
---

<Base title="Reader" description="Read classic books from Project Gutenberg.">
  <style>
    .reader-wrap { max-width: 1100px; margin: 0 auto; padding: 1.5rem 1rem; }

    .search-bar {
      display: flex; gap: 0.5rem; margin-bottom: 2rem;
    }
    .search-bar input {
      flex: 1; padding: 0.5rem 0.75rem; border: 1px solid var(--rule);
      background: var(--bg); color: var(--fg); font-family: var(--font-sans);
      font-size: 0.95rem; border-radius: 4px;
    }
    .search-bar button {
      padding: 0.5rem 1rem; background: var(--fg); color: var(--bg);
      border: none; border-radius: 4px; cursor: pointer; font-family: var(--font-sans);
      font-size: 0.95rem;
    }

    .book-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 1.25rem;
    }
    .book-card {
      cursor: pointer; text-align: center;
      transition: transform 0.15s;
    }
    .book-card:hover { transform: translateY(-3px); }
    .book-card img {
      width: 100%; aspect-ratio: 2/3; object-fit: cover;
      border-radius: 3px; border: 1px solid var(--rule);
      background: var(--code-bg);
    }
    .book-card .bk-title {
      font-size: 0.78rem; margin-top: 0.4rem; line-height: 1.3;
      color: var(--fg); font-family: var(--font-serif);
    }
    .book-card .bk-author { font-size: 0.7rem; color: var(--muted); margin-top: 0.15rem; }

    /* ── Reader UI ── */
    #reader-ui { display: none; }

    .reader-header {
      display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem;
    }
    .reader-header button {
      background: none; border: 1px solid var(--rule); color: var(--fg);
      padding: 0.3rem 0.6rem; border-radius: 4px; cursor: pointer;
      font-family: var(--font-sans); font-size: 0.85rem;
    }
    .reader-header h2 { flex: 1; font-size: 1rem; color: var(--muted); font-weight: 400; margin: 0; }

    /* Spread */
    .spread-wrap {
      position: relative; perspective: 2000px; user-select: none;
    }
    .spread {
      display: grid; grid-template-columns: 1fr 1fr;
      background: #faf7f0; border-radius: 3px;
      box-shadow: 0 2px 20px rgba(0,0,0,0.18);
      min-height: 520px; position: relative;
    }
    /* Spine shadow */
    .spread::after {
      content: ""; position: absolute; left: 50%; top: 0; bottom: 0; width: 1px;
      background: linear-gradient(to right, rgba(0,0,0,0.18) 0%, rgba(0,0,0,0.05) 6px, transparent 6px);
      transform: translateX(-50%);
      box-shadow: 2px 0 8px rgba(0,0,0,0.10), -2px 0 8px rgba(0,0,0,0.10);
    }

    .page-panel {
      padding: 2.5rem 2rem; font-family: var(--font-serif); font-size: 0.95rem;
      line-height: 1.75; color: #3a2e20; overflow: hidden;
      position: relative; min-height: 520px;
    }
    .page-panel.left { border-radius: 3px 0 0 3px; }
    .page-panel.right { border-radius: 0 3px 3px 0; }
    .page-num {
      position: absolute; bottom: 1rem;
      font-size: 0.75rem; color: #9a8a72; font-family: var(--font-sans);
    }
    .page-panel.left .page-num { left: 2rem; }
    .page-panel.right .page-num { right: 2rem; }

    /* 3D flip */
    .page-flipper {
      position: absolute; top: 0; left: 50%; bottom: 0; width: 50%;
      transform-origin: left center;
      transform-style: preserve-3d;
      transition: transform 0.5s ease;
      pointer-events: none; z-index: 5;
    }
    .page-flipper.flip-fwd { transform: rotateY(-180deg); }
    .page-flipper.flip-back { transform: rotateY(0deg); }
    .flipper-face, .flipper-back {
      position: absolute; inset: 0;
      background: #faf7f0; backface-visibility: hidden;
      padding: 2.5rem 2rem; font-family: var(--font-serif); font-size: 0.95rem;
      line-height: 1.75; color: #3a2e20; overflow: hidden;
    }
    .flipper-back { transform: rotateY(180deg); }

    .nav-row {
      display: flex; justify-content: space-between; align-items: center;
      margin-top: 1rem;
    }
    .nav-row button {
      background: none; border: 1px solid var(--rule); color: var(--fg);
      padding: 0.4rem 1rem; border-radius: 4px; cursor: pointer;
      font-family: var(--font-sans); font-size: 0.9rem;
    }
    .nav-row button:disabled { opacity: 0.3; cursor: default; }
    .nav-row .page-info { font-size: 0.85rem; color: var(--muted); }

    /* Mobile: single page */
    @media (max-width: 640px) {
      .spread { grid-template-columns: 1fr; }
      .page-panel.right { display: none; }
      .spread::after { display: none; }
      .page-flipper { display: none; }
    }

    /* Annotations */
    .note-btn {
      position: fixed; background: #f5c542; color: #222;
      border: none; border-radius: 4px; padding: 0.3rem 0.7rem;
      cursor: pointer; font-size: 0.85rem; display: none; z-index: 100;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
    .note-popup {
      position: fixed; background: var(--bg); border: 1px solid var(--rule);
      border-radius: 6px; padding: 1rem; z-index: 101; width: 260px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.15); display: none;
    }
    .note-popup textarea {
      width: 100%; height: 80px; resize: none; border: 1px solid var(--rule);
      background: var(--code-bg); color: var(--fg); font-family: var(--font-sans);
      font-size: 0.85rem; border-radius: 3px; padding: 0.4rem; box-sizing: border-box;
    }
    .note-colors { display: flex; gap: 0.4rem; margin: 0.5rem 0; }
    .note-colors button {
      width: 22px; height: 22px; border-radius: 50%; border: 2px solid transparent;
      cursor: pointer;
    }
    .note-colors button.active { border-color: var(--fg); }
    .note-popup-btns { display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.5rem; }
    .note-popup-btns button {
      background: none; border: 1px solid var(--rule); color: var(--fg);
      padding: 0.25rem 0.6rem; border-radius: 3px; cursor: pointer; font-size: 0.8rem;
    }
    .note-popup-btns button.save { background: var(--fg); color: var(--bg); }

    mark.ann-yellow { background: #ffe66a; color: inherit; border-radius: 2px; }
    mark.ann-green  { background: #b4f0a0; color: inherit; border-radius: 2px; }
    mark.ann-pink   { background: #fbb6ce; color: inherit; border-radius: 2px; }

    .loading { color: var(--muted); font-size: 0.9rem; padding: 2rem 0; }
    .error-msg { color: #c0392b; font-size: 0.9rem; padding: 1rem 0; }
  </style>

  <div class="reader-wrap">
    <div id="library-ui">
      <div class="search-bar">
        <input type="text" id="search-input" placeholder="Search Gutenberg…" />
        <button id="search-btn">Search</button>
      </div>
      <div id="status" class="loading">Loading classics…</div>
      <div id="book-grid" class="book-grid"></div>
    </div>

    <div id="reader-ui">
      <div class="reader-header">
        <button id="back-btn">← Library</button>
        <h2 id="book-title-label"></h2>
      </div>

      <div class="spread-wrap">
        <div class="spread" id="spread">
          <div class="page-panel left" id="left-panel">
            <span class="page-num" id="left-num"></span>
          </div>
          <div class="page-panel right" id="right-panel">
            <span class="page-num" id="right-num"></span>
          </div>
          <div class="page-flipper" id="page-flipper">
            <div class="flipper-face" id="flipper-face"></div>
            <div class="flipper-back" id="flipper-back"></div>
          </div>
        </div>
      </div>

      <div class="nav-row">
        <button id="prev-btn">← Prev</button>
        <span class="page-info" id="page-info"></span>
        <button id="next-btn">Next →</button>
      </div>
    </div>
  </div>

  <button class="note-btn" id="note-btn">Note</button>
  <div class="note-popup" id="note-popup">
    <textarea id="note-text" placeholder="Add a note…"></textarea>
    <div class="note-colors">
      <button style="background:#ffe66a" data-color="yellow" class="active" title="Yellow"></button>
      <button style="background:#b4f0a0" data-color="green" title="Green"></button>
      <button style="background:#fbb6ce" data-color="pink" title="Pink"></button>
    </div>
    <div class="note-popup-btns">
      <button id="note-cancel">Cancel</button>
      <button class="save" id="note-save">Save</button>
    </div>
  </div>
</Base>

<script src="/scripts/reader.js" defer></script>
