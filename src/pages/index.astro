---
import Base from "../layouts/Base.astro";
import { isPublished } from "../data/pages";

// Three front doors for three audiences (25/09/26 audit): the tools product,
// the field/prepping side and the portfolio. Play sits in a quieter strip.
const doors = [
  {
    href: "/site",
    eyebrow: "Tools",
    title: "Site and audio tools",
    desc: "Cut lists, programmes, rates, PDFs and material calculators for estimators and trades, plus audio analysis and prep. Free, no account.",
    links: [["/site", "Site tools"], ["/audio", "Audio tools"], ["/pro", "Pro"]],
  },
  {
    href: "/prepping",
    eyebrow: "Field",
    title: "Prepping and self-reliance",
    desc: "Notes on bushcraft, gear and readiness, with field calculators, knots, weather and maps that work on a phone.",
    links: [["/prepping", "Notes"], ["/prepping/tools", "Field tools"], ["/prepping/gear", "Gear lists"], ["/prepping/knots", "Knots"]],
  },
  {
    href: "/studio",
    eyebrow: "Studio",
    title: "VishAmp browser studio",
    desc: "A drum machine, sample pads, wavetable synth, clip arranger, mixer and DJ decks that run entirely in the browser. WAV export is free; Pro adds MP3 and stems.",
    links: [["/studio", "Open Studio"], ["/audio", "Audio tools"], ["/music", "Listening"]],
  },
] as const;

// "Smoko" (Vish, 01/10/26): the things here for a break, most useful first.
const smoko = [
  ["/games", "Games", "Four small browser games."],
  ["/radio", "Radio", "Hundreds of live stations, local and worldwide."],
  ["/feeds", "Feeds", "News, finance and construction headlines in one place."],
  ["/reader", "Reader", "Free books, read or listened to."],
  ["/tv", "TV", "Free films, old and new, on a channel-surfing set."],
] as const;

// Owner-only cards: the Worker strips [data-private] for anonymous visitors.
const life = [
  { href: "/kitchen", title: "Kitchen", desc: "Recipes, fortnight plan, shopping list." },
  { href: "/money", title: "Money", desc: "Budget, bank import, net worth, debt payoff." },
  { href: "/training", title: "Training", desc: "Programme, session log, progression." },
];

const more: [string, string][] = ([
  ["/prepping/health", "Health & wellbeing"],
  ["/music", "Listening"],
  ["/now", "Now"],
  ["/blog", "Blog"],
  ["/movies", "Movies"],
  ["/books", "Books"],
  ["/notes", "Notes"],
] as [string, string][]).filter(([href]) => isPublished(href));
---

<Base ogImage="/og/index.png">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-text">
      <p class="eyebrow">Sydney</p>
      <h1 id="home-title" class="home-title">Vish Vaddi. Estimator. I&nbsp;make small free&nbsp;tools.</h1>
      <p class="home-intro">
        Most of these started as a spreadsheet that kept breaking. They run in
        your browser, cost nothing, and your data stays on your device.
      </p>
      <p class="home-sub">cut lists · programmes · rates · pdfs · audio · studio</p>
    </div>
    <div class="home-instrument" aria-hidden="true">
      <svg viewBox="0 0 480 300" xmlns="http://www.w3.org/2000/svg">
        <defs><clipPath id="hero-clip"><rect x="0" y="24" width="480" height="232" /></clipPath></defs>
        <g clip-path="url(#hero-clip)">
          <line class="iso" x1="0" y1="-400" x2="480" y2="-123" /><line class="iso" x1="0" y1="-400" x2="480" y2="-677" /><line class="iso" x1="0" y1="-364" x2="480" y2="-87" /><line class="iso" x1="0" y1="-364" x2="480" y2="-641" /><line class="iso" x1="0" y1="-328" x2="480" y2="-51" /><line class="iso" x1="0" y1="-328" x2="480" y2="-605" /><line class="iso" x1="0" y1="-292" x2="480" y2="-15" /><line class="iso" x1="0" y1="-292" x2="480" y2="-569" /><line class="iso" x1="0" y1="-256" x2="480" y2="21" /><line class="iso" x1="0" y1="-256" x2="480" y2="-533" /><line class="iso" x1="0" y1="-220" x2="480" y2="57" /><line class="iso" x1="0" y1="-220" x2="480" y2="-497" /><line class="iso" x1="0" y1="-184" x2="480" y2="93" /><line class="iso" x1="0" y1="-184" x2="480" y2="-461" /><line class="iso" x1="0" y1="-148" x2="480" y2="129" /><line class="iso" x1="0" y1="-148" x2="480" y2="-425" /><line class="iso" x1="0" y1="-112" x2="480" y2="165" /><line class="iso" x1="0" y1="-112" x2="480" y2="-389" /><line class="iso" x1="0" y1="-76" x2="480" y2="201" /><line class="iso" x1="0" y1="-76" x2="480" y2="-353" /><line class="iso" x1="0" y1="-40" x2="480" y2="237" /><line class="iso" x1="0" y1="-40" x2="480" y2="-317" /><line class="iso" x1="0" y1="-4" x2="480" y2="273" /><line class="iso" x1="0" y1="-4" x2="480" y2="-281" /><line class="iso" x1="0" y1="32" x2="480" y2="309" /><line class="iso" x1="0" y1="32" x2="480" y2="-245" /><line class="iso" x1="0" y1="68" x2="480" y2="345" /><line class="iso" x1="0" y1="68" x2="480" y2="-209" /><line class="iso" x1="0" y1="104" x2="480" y2="381" /><line class="iso" x1="0" y1="104" x2="480" y2="-173" /><line class="iso" x1="0" y1="140" x2="480" y2="417" /><line class="iso" x1="0" y1="140" x2="480" y2="-137" /><line class="iso" x1="0" y1="176" x2="480" y2="453" /><line class="iso" x1="0" y1="176" x2="480" y2="-101" /><line class="iso" x1="0" y1="212" x2="480" y2="489" /><line class="iso" x1="0" y1="212" x2="480" y2="-65" /><line class="iso" x1="0" y1="248" x2="480" y2="525" /><line class="iso" x1="0" y1="248" x2="480" y2="-29" /><line class="iso" x1="0" y1="284" x2="480" y2="561" /><line class="iso" x1="0" y1="284" x2="480" y2="7" /><line class="iso" x1="0" y1="320" x2="480" y2="597" /><line class="iso" x1="0" y1="320" x2="480" y2="43" /><line class="iso" x1="0" y1="356" x2="480" y2="633" /><line class="iso" x1="0" y1="356" x2="480" y2="79" /><line class="iso" x1="0" y1="392" x2="480" y2="669" /><line class="iso" x1="0" y1="392" x2="480" y2="115" /><line class="iso" x1="0" y1="428" x2="480" y2="705" /><line class="iso" x1="0" y1="428" x2="480" y2="151" /><line class="iso" x1="0" y1="464" x2="480" y2="741" /><line class="iso" x1="0" y1="464" x2="480" y2="187" /><line class="iso" x1="0" y1="500" x2="480" y2="777" /><line class="iso" x1="0" y1="500" x2="480" y2="223" /><line class="iso" x1="0" y1="536" x2="480" y2="813" /><line class="iso" x1="0" y1="536" x2="480" y2="259" /><line class="iso" x1="0" y1="572" x2="480" y2="849" /><line class="iso" x1="0" y1="572" x2="480" y2="295" /><line class="iso" x1="0" y1="608" x2="480" y2="885" /><line class="iso" x1="0" y1="608" x2="480" y2="331" /><line class="iso" x1="0" y1="644" x2="480" y2="921" /><line class="iso" x1="0" y1="644" x2="480" y2="367" /><line class="iso" x1="0" y1="680" x2="480" y2="957" /><line class="iso" x1="0" y1="680" x2="480" y2="403" />
          <rect class="sweep-band" x="-60" y="0" width="56" height="256" />
          <line class="sweep" x1="0" y1="0" x2="0" y2="256" />
        </g>
        <line class="rule" x1="40" y1="274" x2="440" y2="274" />
        <line class="tick" x1="40" y1="262" x2="40" y2="274" /><text class="readout" x="40" y="290" text-anchor="middle">0</text><line class="tick" x1="60" y1="268" x2="60" y2="274" /><line class="tick" x1="80" y1="268" x2="80" y2="274" /><line class="tick" x1="100" y1="268" x2="100" y2="274" /><line class="tick" x1="120" y1="268" x2="120" y2="274" /><line class="tick" x1="140" y1="262" x2="140" y2="274" /><text class="readout" x="140" y="290" text-anchor="middle">600</text><line class="tick" x1="160" y1="268" x2="160" y2="274" /><line class="tick" x1="180" y1="268" x2="180" y2="274" /><line class="tick" x1="200" y1="268" x2="200" y2="274" /><line class="tick" x1="220" y1="268" x2="220" y2="274" /><line class="tick" x1="240" y1="262" x2="240" y2="274" /><text class="readout" x="240" y="290" text-anchor="middle">1200</text><line class="tick" x1="260" y1="268" x2="260" y2="274" /><line class="tick" x1="280" y1="268" x2="280" y2="274" /><line class="tick" x1="300" y1="268" x2="300" y2="274" /><line class="tick" x1="320" y1="268" x2="320" y2="274" /><line class="tick" x1="340" y1="262" x2="340" y2="274" /><text class="readout" x="340" y="290" text-anchor="middle">1800</text><line class="tick" x1="360" y1="268" x2="360" y2="274" /><line class="tick" x1="380" y1="268" x2="380" y2="274" /><line class="tick" x1="400" y1="268" x2="400" y2="274" /><line class="tick" x1="420" y1="268" x2="420" y2="274" /><line class="tick" x1="440" y1="262" x2="440" y2="274" /><text class="readout" x="440" y="290" text-anchor="middle">2400</text>
        <text class="readout" x="0" y="14">SCAN · 1:20 · MM</text>
        <circle class="live-dot" cx="432" cy="10" r="3" />
        <text class="readout" x="480" y="14" text-anchor="end">LIVE</text>
      </svg>
    </div>
  </section>

  <section class="vv-resume" id="vv-resume" hidden aria-labelledby="vv-resume-title">
    <h2 id="vv-resume-title" class="vv-resume-title">Pick up where you left off</h2>
    <div class="vv-resume-grid" id="vv-resume-grid" data-scope="home"></div>
  </section>

  <section class="home-doors" aria-label="Main sections">
    {doors.map((door, i) => (
      <article class="home-door reveal" style={`--i: ${i}`} data-glow>
        <a class="home-door-main" href={door.href}>
          <span class="eyebrow">{door.eyebrow}</span>
          <strong>{door.title}</strong>
          <span class="home-door-desc">{door.desc}</span>
        </a>
        <nav class="home-door-links" aria-label={`${door.eyebrow} pages`}>
          {door.links.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
      </article>
    ))}
  </section>

  <section class="home-section home-play" aria-labelledby="smoko-title">
    <h2 id="smoko-title">Smoko</h2>
    <ul class="home-play-list">
      {smoko.map(([href, title, desc]) => (
        <li><a href={href}><strong>{title}</strong><span>{desc}</span></a></li>
      ))}
    </ul>
  </section>

  <section class="home-section" aria-labelledby="life-title" data-private>
    <h2 id="life-title">Life</h2>
    <div class="home-grid">
      {life.map((item) => (
        <a class="home-card" href={item.href}>
          <strong>{item.title}</strong>
          <span>{item.desc}</span>
        </a>
      ))}
    </div>
  </section>

  {more.length > 0 && (
    <section class="home-section" aria-labelledby="more-title">
      <h2 id="more-title">More</h2>
      <nav class="home-links" aria-label="More sections">
        {more.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
    </section>
  )}

  <script src="/scripts/resume.js" defer></script>
  <script src="/scripts/hero.js" defer></script>
</Base>
