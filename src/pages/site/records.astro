---
import Base from "../../layouts/Base.astro";
import "../../styles/site.css";
---

<Base
  title="Site Records"
  description="Running site registers — variations, punch list, deliveries, contacts and a daily log. Add, edit and export to CSV. Runs entirely in your browser."
  siteNav
>
  <div class="blueprint tool">
    <p class="eyebrow"><a href="/site" style="color:inherit;text-decoration:none">Site Tools</a> / Records</p>
    <h1>Site Records</h1>
    <p>
      Running registers for a job — variations, punch list, deliveries, contacts
      and a daily log. Add and edit entries, see live totals, and export any
      register to CSV. Everything is saved in this browser only; nothing is
      uploaded.
    </p>

    <div id="rec-app"></div>

    <p class="disclosure">
      Stored only in this browser (localStorage). Export to CSV to keep a copy or
      move it to another device.
    </p>
    <p class="note-foot"><a href="/site">← all tools</a></p>
  </div>

  <script>
    import { initRecords } from "../../scripts/site/records";
    initRecords();
  </script>
</Base>
