---
import Base from "../../layouts/Base.astro";
import ToolIntro from "../../components/ToolIntro.astro";
import "../../styles/site.css";
---

<Base
  title="Charge-Out Rate Calculator — sole trader (AU)"
  description="Work out your hourly charge-out rate from wage, super, overheads, billable hours and margin — free, for Australian sole traders and subbies."
  siteNav
>
  <div class="blueprint tool">
    <p class="eyebrow"><a href="/site" style="color:inherit;text-decoration:none">Site</a> / Charge-out rate</p>
    <h1>Charge-Out Rate Calculator</h1>
    <p>
      The hourly rate you need so the wage you want is left after super, overheads
      and unbilled time — then your margin on top. Charging your "wage" as your
      rate is the classic way to go broke.
    </p>

    <div id="calcs"></div>

    <div id="cr-confirm" class="pad-confirm no-print" hidden>
      <span id="cr-confirm-text"></span>
      <button type="button" class="btn btn-sm" id="cr-confirm-yes">Yes</button>
      <button type="button" class="btn btn-ghost btn-sm" id="cr-confirm-no">Cancel</button>
    </div>

    <div class="btn-row no-print">
      <button type="button" class="btn" id="print">Save as PDF</button>
      <button type="button" class="btn btn-ghost" id="email">Email to myself</button>
      <button type="button" class="btn btn-ghost" id="cr-copy-link">Copy link</button>
      <span id="cr-copied" style="align-self:center;font-size:0.85rem;color:var(--muted)" hidden>Link copied ✓</span>
    </div>
    <ToolIntro href="/site/charge-rate" />
    <p class="note-foot">
      Estimates only — set your own overheads and check tax/super with your
      accountant. <a href="/site/rate">Build a unit rate →</a>
    </p>
  </div>

  <script>
    import { mountCalcs, wireActions, type CalcSpec } from "../../scripts/site/calc";
    import { brandedExport } from "../../scripts/site/export-brand";

    const f2 = (n: number) => n.toLocaleString("en-AU", { style: "currency", currency: "AUD" });
    const f0 = (n: number) => n.toLocaleString("en-AU", { maximumFractionDigits: 0 });

    const specs: CalcSpec[] = [
      {
        id: "charge",
        title: "Charge-out rate",
        blurb: "Your target wage, grossed up for super and overheads, divided by the hours you can actually bill — plus margin.",
        fields: [
          { id: "wage", label: "Wage you want ($/yr, take-home target)", def: "90000", min: "0", step: "1000" },
          { id: "super", label: "Super on top (%)", def: "11.5", min: "0", step: "0.5" },
          { id: "oh", label: "Annual overheads ($) — insurance, vehicle, tools, phone, software", def: "20000", min: "0", step: "500" },
          { id: "weeks", label: "Weeks worked / year", def: "46", min: "1", step: "1" },
          { id: "days", label: "Days / week", def: "5", min: "1", step: "0.5" },
          { id: "billable", label: "Billable hours / day (the rest is quoting, travel, admin)", def: "6", min: "0.5", step: "0.5" },
          { id: "margin", label: "Profit margin (%)", def: "15", min: "0", step: "1" },
        ],
        compute: (v) => {
          const billableHrs = v.weeks * v.days * v.billable;
          if (billableHrs <= 0) return null;
          const costBase = v.wage * (1 + v.super / 100) + v.oh;
          const breakeven = costBase / billableHrs;
          const charge = breakeven * (1 + v.margin / 100);
          return {
            rows: [
              [f2(charge) + " /hr", "charge-out rate (ex GST)"],
              [f2(charge * 1.1) + " /hr", "with 10% GST"],
              [f2(charge * v.billable) + " /day", "day rate (ex GST)"],
              [f2(breakeven) + " /hr", "break-even (no profit)"],
              [f0(billableHrs) + " hrs", "billable hours / year"],
              [f2(costBase), "total cost to cover / year"],
            ],
            warn: v.billable > 7
              ? "Billing 7+ hours every day is optimistic — quoting, travel and admin usually eat 25–35%."
              : undefined,
          };
        },
      },
      {
        id: "markup",
        title: "Markup ↔ margin",
        blurb: "These are not the same. Markup is on cost; margin is on price. Mixing them up quietly erodes profit.",
        fields: [
          { id: "cost", label: "Cost ($)", def: "1000", min: "0", step: "10" },
          { id: "markup", label: "Markup (%)", def: "20", min: "0", step: "1" },
        ],
        compute: (v) => {
          const price = v.cost * (1 + v.markup / 100);
          const margin = price > 0 ? ((price - v.cost) / price) * 100 : 0;
          return {
            rows: [
              [f2(price), "sell price"],
              [margin.toFixed(1) + " %", "actual margin (on price)"],
              [f2(price - v.cost), "gross profit"],
            ],
          };
        },
      },
    ];

    const root = document.getElementById("calcs")!;
    mountCalcs(root, specs);
    wireActions(root, "Charge-out rate", (run, anchor) => brandedExport("charge-rate-print", run, { anchor, print: true }));

    // Share-link state: every field of every calc, keyed by spec id — same
    // base64url-hash pattern as the notepad's Copy link (see notepad.ts).
    function toBase64Url(text: string): string {
      const bytes = new TextEncoder().encode(text);
      let bin = "";
      bytes.forEach((b) => { bin += String.fromCharCode(b); });
      return btoa(bin).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
    }
    function fromBase64Url(encoded: string): string {
      const bin = atob(encoded.replace(/-/g, "+").replace(/_/g, "/"));
      const bytes = Uint8Array.from(bin, (c) => c.charCodeAt(0));
      return new TextDecoder().decode(bytes);
    }
    const fieldInput = (specId: string, fieldId: string) =>
      document.getElementById(`${specId}-${fieldId}`) as HTMLInputElement | null;

    function buildState(): Record<string, unknown> {
      const state: Record<string, unknown> = { v: 1 };
      for (const spec of specs) {
        const values: Record<string, number> = {};
        for (const f of spec.fields) {
          const n = parseFloat(fieldInput(spec.id, f.id)?.value ?? "");
          values[f.id] = Number.isFinite(n) ? n : 0;
        }
        state[spec.id] = values;
      }
      return state;
    }
    function normalizeShared(raw: any): Record<string, unknown> {
      const state: Record<string, unknown> = { v: 1 };
      for (const spec of specs) {
        const values: Record<string, number> = {};
        const src = raw?.[spec.id];
        for (const f of spec.fields) {
          const n = parseFloat(src?.[f.id]);
          values[f.id] = Number.isFinite(n) ? n : 0;
        }
        state[spec.id] = values;
      }
      return state;
    }
    function applyShared(state: Record<string, any>): void {
      for (const spec of specs) {
        const values = state[spec.id];
        if (!values || typeof values !== "object") continue;
        for (const f of spec.fields) {
          const el = fieldInput(spec.id, f.id);
          if (!el) continue;
          el.value = String(values[f.id]);
          el.dispatchEvent(new Event("input", { bubbles: true }));
        }
      }
    }

    const confirmBar = document.getElementById("cr-confirm");
    const confirmText = document.getElementById("cr-confirm-text");
    const confirmYes = document.getElementById("cr-confirm-yes");
    const confirmNo = document.getElementById("cr-confirm-no");
    let pendingAction: (() => void) | null = null;
    function askConfirm(message: string, action: () => void): void {
      pendingAction = action;
      if (confirmText) confirmText.textContent = message;
      if (confirmBar) confirmBar.hidden = false;
    }
    confirmYes?.addEventListener("click", () => {
      if (confirmBar) confirmBar.hidden = true;
      const action = pendingAction;
      pendingAction = null;
      action?.();
    });
    confirmNo?.addEventListener("click", () => {
      if (confirmBar) confirmBar.hidden = true;
      pendingAction = null;
    });

    const copyLinkBtn = document.getElementById("cr-copy-link");
    const copiedEl = document.getElementById("cr-copied");
    copyLinkBtn?.addEventListener("click", async () => {
      const url = `${location.origin}${location.pathname}#${toBase64Url(JSON.stringify(buildState()))}`;
      try {
        await navigator.clipboard.writeText(url);
        if (copiedEl) { copiedEl.hidden = false; setTimeout(() => { copiedEl.hidden = true; }, 1800); }
      } catch { /* clipboard is optional */ }
    });

    function applyHash(): void {
      const hash = location.hash.slice(1);
      if (!hash) return;
      let raw: any;
      try { raw = JSON.parse(fromBase64Url(hash)); } catch { return; }
      if (!raw || typeof raw !== "object") return;
      const incoming = normalizeShared(raw);
      const current = JSON.stringify(buildState());
      if (current !== JSON.stringify(incoming)) {
        askConfirm("Replace the current values with the ones from this link?", () => applyShared(incoming));
      } else {
        applyShared(incoming);
      }
    }
    applyHash();
  </script>
</Base>
