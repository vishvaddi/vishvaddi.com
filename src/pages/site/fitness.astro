---
// Fitness calculators have moved to Prepping → Fitness.
const dest = "/prepping/fitness";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${dest}`} />
    <link rel="canonical" href={dest} />
    <meta name="robots" content="noindex" />
    <title>Moved — Fitness &amp; Nutrition</title>
  </head>
  <body>
    <p>Fitness &amp; nutrition calculators have moved to <a href={dest}>Prepping → Fitness</a>.</p>
    <script is:inline set:html={`location.replace(${JSON.stringify(dest)});`}></script>
  </body>
</html>
