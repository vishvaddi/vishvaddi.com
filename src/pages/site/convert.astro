---
import Base from "../../layouts/Base.astro";
import "../../styles/site.css";
---

<Base
  title="Unit Converter"
  description="Free trade unit converter — length, area and volume, metric and imperial. Runs entirely in your browser."
  siteNav
>
  <div class="blueprint tool">
    <p class="eyebrow"><a href="/site" style="color:inherit;text-decoration:none">Site</a> / Convert</p>
    <h1>Unit Converter</h1>
    <p>Length, area and volume — metric and imperial. Updates as you type.</p>

    <div class="field">
      <label for="cat">Type</label>
      <select id="cat"></select>
    </div>
    <div class="field">
      <label for="val">Value</label>
      <input type="number" id="val" value="1" inputmode="decimal" step="any" />
    </div>
    <div class="conv-grid">
      <div class="field"><label for="from">From</label><select id="from"></select></div>
      <button type="button" class="btn btn-ghost conv-swap" id="swap" aria-label="Swap units">⇄</button>
      <div class="field"><label for="to">To</label><select id="to"></select></div>
    </div>
    <div class="conv-out" id="out" aria-live="polite"></div>

    <p class="note-foot"><a href="/site">← all tools</a></p>
  </div>

  <script>
    import { initConverter } from "../../scripts/site/calc";
    initConverter();
  </script>
</Base>
