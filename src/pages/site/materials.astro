---
import Base from "../../layouts/Base.astro";
import "../../styles/site.css";
---

<Base
  title="Material Calculators"
  description="Free material calculators — paint, tiles, plasterboard, concrete and skirting quantities. Runs entirely in your browser."
  siteNav
>
  <div class="blueprint tool">
    <p class="eyebrow"><a href="/site" style="color:inherit;text-decoration:none">Site</a> / Materials</p>
    <h1>Material Calculators</h1>
    <p>Quick quantities by trade. Everything updates as you type and stays in your browser. Save the page to PDF below.</p>

    <div class="mat-layout">
      <nav class="mat-tabs no-print" id="mat-tabs" role="tablist" aria-label="Trades"></nav>
      <div id="calcs" class="mat-content"></div>
    </div>

    <div class="btn-row no-print">
      <button type="button" class="btn" id="print">Save as PDF</button>
      <button type="button" class="btn btn-ghost" id="email">Email to myself</button>
    </div>
    <p class="note-foot">Estimates only — allow for laps, cuts and site conditions. <a href="/site">← all tools</a></p>
  </div>

  <script>
    import { mountCalcs, wireActions, type CalcSpec } from "../../scripts/site/calc";

    const f2 = (n: number) => n.toLocaleString("en-AU", { maximumFractionDigits: 2 });
    const f0 = (n: number) => n.toLocaleString("en-AU", { maximumFractionDigits: 0 });
    const up = (n: number) => Math.max(0, Math.ceil(n));

    const pct = (waste: number) => 1 + (waste || 0) / 100;
    const groups: { trade: string; specs: CalcSpec[] }[] = [
      {
        trade: "Painting & coatings",
        specs: [
          {
            id: "paint", title: "Paint",
            blurb: "Litres for one surface. Typical coverage is ~11 m²/L per coat.",
            fields: [
              { id: "area", label: "Surface area (m²)", def: "12", min: "0", step: "0.1" },
              { id: "openings", label: "Subtract openings (m²)", def: "2", min: "0", step: "0.1" },
              { id: "coats", label: "Coats", def: "2", min: "1", step: "1" },
              { id: "cov", label: "Coverage (m²/L)", def: "11", min: "0.1", step: "0.5" },
            ],
            compute: (v) => {
              const net = Math.max(0, v.area - v.openings);
              if (v.cov <= 0) return null;
              return { rows: [[f2((net * v.coats) / v.cov) + " L", "paint needed"], [f0(net) + " m²", "net area × " + (v.coats || 0) + " coats"]] };
            },
          },
          {
            id: "wallpaper", title: "Wallpaper",
            blurb: "Standard roll ≈ 5 m² usable after pattern match.",
            fields: [
              { id: "area", label: "Wall area (m²)", def: "20", min: "0", step: "0.1" },
              { id: "roll", label: "Usable per roll (m²)", def: "5", min: "0.1", step: "0.1" },
              { id: "waste", label: "Wastage (%)", def: "15", min: "0", step: "1" },
            ],
            compute: (v) => (v.roll <= 0 || v.area <= 0 ? null : { rows: [[f0(up((v.area * pct(v.waste)) / v.roll)), "rolls"]] }),
          },
        ],
      },
      {
        trade: "Tiling",
        specs: [
          {
            id: "tiles", title: "Tile / plank count",
            blurb: "Tiles or planks for a floor or wall, including cut wastage.",
            fields: [
              { id: "area", label: "Area (m²)", def: "10", min: "0", step: "0.1" },
              { id: "w", label: "Tile width (mm)", def: "300", min: "1", step: "1" },
              { id: "h", label: "Tile length (mm)", def: "600", min: "1", step: "1" },
              { id: "waste", label: "Wastage (%)", def: "10", min: "0", step: "1" },
            ],
            compute: (v) => {
              const tileArea = (v.w / 1000) * (v.h / 1000);
              if (tileArea <= 0 || v.area <= 0) return null;
              return { rows: [[f0(up((v.area * pct(v.waste)) / tileArea)), "tiles (incl. wastage)"], [f2(1 / tileArea), "tiles / m²"]] };
            },
          },
          {
            id: "adhesive", title: "Adhesive & grout",
            blurb: "Bagged tile adhesive and grout. Rates vary with tile size and notch.",
            fields: [
              { id: "area", label: "Area (m²)", def: "10", min: "0", step: "0.1" },
              { id: "akg", label: "Adhesive (kg/m²)", def: "4", min: "0.1", step: "0.1" },
              { id: "bag", label: "Adhesive bag (kg)", def: "20", min: "1", step: "1" },
              { id: "gkg", label: "Grout (kg/m²)", def: "0.5", min: "0", step: "0.1" },
            ],
            compute: (v) => {
              if (v.area <= 0 || v.bag <= 0) return null;
              return { rows: [[f0(up((v.area * v.akg) / v.bag)), "× adhesive bags"], [f2(v.area * v.gkg) + " kg", "grout"]] };
            },
          },
          {
            id: "waterproof", title: "Waterproofing membrane",
            blurb: "Two coats over floor + walls to code height. Typical coverage ~1 L/m² for two coats.",
            fields: [
              { id: "area", label: "Area incl. walls (m²)", def: "8", min: "0", step: "0.1" },
              { id: "rate", label: "L per m² (2 coats)", def: "1", min: "0.1", step: "0.1" },
              { id: "pail", label: "Pail size (L)", def: "15", min: "1", step: "1" },
            ],
            compute: (v) => {
              if (v.area <= 0 || v.pail <= 0) return null;
              const litres = v.area * v.rate;
              return { rows: [[f1(litres) + " L", "membrane"], [f0(up(litres / v.pail)), "pails"]] };
            },
          },
        ],
      },
      {
        trade: "Joinery & shopfitting",
        specs: [
          {
            id: "board", title: "Board sheets",
            blurb: "Melamine/MDF/ply sheets from total panel area. Standard sheet 2400 × 1200 mm (2.88 m²).",
            fields: [
              { id: "area", label: "Total panel area (m²)", def: "8", min: "0", step: "0.1" },
              { id: "w", label: "Sheet width (mm)", def: "1200", min: "1", step: "1" },
              { id: "h", label: "Sheet length (mm)", def: "2400", min: "1", step: "1" },
              { id: "waste", label: "Cutting wastage (%)", def: "20", min: "0", step: "1" },
            ],
            compute: (v) => {
              const sheetArea = (v.w / 1000) * (v.h / 1000);
              if (sheetArea <= 0 || v.area <= 0) return null;
              return {
                rows: [[f0(up((v.area * pct(v.waste)) / sheetArea)), "sheets"], [f2(sheetArea) + " m²", "per sheet"]],
                warn: "Board wastage runs high — nested cutting rarely beats 20% on mixed panel sizes. Use the Cut List tool for the real layout.",
              };
            },
          },
          {
            id: "edging", title: "Edge banding",
            blurb: "Lineal metres of edging with an application wastage allowance.",
            fields: [
              { id: "lm", label: "Edges to band (m)", def: "24", min: "0", step: "0.5" },
              { id: "roll", label: "Roll length (m)", def: "50", min: "1", step: "1" },
              { id: "waste", label: "Wastage (%)", def: "10", min: "0", step: "1" },
            ],
            compute: (v) => {
              if (v.lm <= 0 || v.roll <= 0) return null;
              const need = v.lm * pct(v.waste);
              return { rows: [[f2(need) + " m", "banding needed"], [f0(up(need / v.roll)), "rolls"]] };
            },
          },
          {
            id: "silicone", title: "Sealant / silicone",
            blurb: "Cartridges from joint length and bead size. 300 mL cartridge.",
            fields: [
              { id: "lm", label: "Joint length (m)", def: "12", min: "0", step: "0.5" },
              { id: "bead", label: "Bead width (mm)", def: "6", min: "1", step: "1" },
              { id: "depth", label: "Bead depth (mm)", def: "6", min: "1", step: "1" },
            ],
            compute: (v) => {
              if (v.lm <= 0) return null;
              const mlPerM = v.bead * v.depth; // mm² section ≈ mL per metre
              const metresPerCart = 300 / mlPerM;
              return { rows: [[f0(up(v.lm / metresPerCart)), "× 300 mL cartridges"], [f1(metresPerCart) + " m", "per cartridge at this bead"]] };
            },
          },
          {
            id: "glass", title: "Glass weight",
            blurb: "Glass ≈ 2.5 kg per m² per mm of thickness — check your lifting plan.",
            fields: [
              { id: "w", label: "Width (mm)", def: "2000", min: "1", step: "1" },
              { id: "h", label: "Height (mm)", def: "2100", min: "1", step: "1" },
              { id: "t", label: "Thickness (mm)", def: "10", min: "1", step: "1" },
            ],
            compute: (v) => {
              const area = (v.w / 1000) * (v.h / 1000);
              if (area <= 0 || v.t <= 0) return null;
              const kg = area * v.t * 2.5;
              return {
                rows: [[f1(kg) + " kg", "panel weight"], [f2(area) + " m²", "area"]],
                warn: kg > 60 ? "Over 60 kg — two-person or mechanical lift territory." : undefined,
              };
            },
          },
        ],
      },
      {
        trade: "Plastering & linings",
        specs: [
          {
            id: "sheet", title: "Plasterboard sheets",
            blurb: "Standard sheet 1200 × 2400 mm (2.88 m²).",
            fields: [
              { id: "area", label: "Area to line (m²)", def: "30", min: "0", step: "0.1" },
              { id: "w", label: "Sheet width (mm)", def: "1200", min: "1", step: "1" },
              { id: "h", label: "Sheet length (mm)", def: "2400", min: "1", step: "1" },
              { id: "waste", label: "Wastage (%)", def: "10", min: "0", step: "1" },
            ],
            compute: (v) => {
              const sheetArea = (v.w / 1000) * (v.h / 1000);
              if (sheetArea <= 0 || v.area <= 0) return null;
              return { rows: [[f0(up((v.area * pct(v.waste)) / sheetArea)), "sheets"], [f2(sheetArea) + " m²", "per sheet"]] };
            },
          },
          {
            id: "cornice", title: "Cornice / linear trim",
            blurb: "Lengths to buy for cornice, skirting or architrave.",
            fields: [
              { id: "perim", label: "Run / perimeter (m)", def: "20", min: "0", step: "0.1" },
              { id: "open", label: "Subtract openings (m)", def: "0.9", min: "0", step: "0.1" },
              { id: "stock", label: "Stock length (m)", def: "5.4", min: "0.1", step: "0.1" },
              { id: "waste", label: "Wastage (%)", def: "10", min: "0", step: "1" },
            ],
            compute: (v) => {
              const net = Math.max(0, v.perim - v.open) * pct(v.waste);
              if (v.stock <= 0 || net <= 0) return null;
              return { rows: [[f2(net) + " m", "total length"], [f0(up(net / v.stock)), "lengths to buy"]] };
            },
          },
          {
            id: "compound", title: "Jointing compound",
            blurb: "Rough set/finish compound for board joints (~1 × 20 kg bag per 40 m²).",
            fields: [
              { id: "area", label: "Board area (m²)", def: "60", min: "0", step: "1" },
              { id: "rate", label: "m² per 20 kg bag", def: "40", min: "1", step: "1" },
            ],
            compute: (v) => (v.area <= 0 || v.rate <= 0 ? null : { rows: [[f0(up(v.area / v.rate)), "× 20 kg bags"]] }),
          },
          {
            id: "steelstud", title: "Steel stud & track",
            blurb: "Partition framing: studs at spacing plus top and bottom track.",
            fields: [
              { id: "len", label: "Wall length (m)", def: "6", min: "0", step: "0.1" },
              { id: "spc", label: "Stud spacing (mm)", def: "600", min: "100", step: "50" },
              { id: "ht", label: "Wall height (m)", def: "2.7", min: "0.1", step: "0.1" },
              { id: "stock", label: "Track stock length (m)", def: "3", min: "0.5", step: "0.5" },
            ],
            compute: (v) => {
              if (v.len <= 0 || v.spc <= 0 || v.stock <= 0) return null;
              const studs = up((v.len * 1000) / v.spc) + 1;
              const trackM = v.len * 2;
              return {
                rows: [
                  [f0(studs), "studs @ " + f0(v.spc) + " mm"],
                  [f2(studs * v.ht) + " m", "stud lineal metres"],
                  [f2(trackM) + " m", "track (top + bottom)"],
                  [f0(up(trackM / v.stock)), "track lengths to buy"],
                ],
              };
            },
          },
          {
            id: "screws", title: "Board screws",
            blurb: "Rough guide ≈ 15 screws per m² on walls (300 mm centres in the field).",
            fields: [
              { id: "area", label: "Board area (m²)", def: "60", min: "0", step: "1" },
              { id: "rate", label: "Screws / m²", def: "15", min: "1", step: "1" },
              { id: "box", label: "Screws per box", def: "1000", min: "1", step: "100" },
            ],
            compute: (v) => {
              if (v.area <= 0 || v.box <= 0) return null;
              const n = v.area * v.rate;
              return { rows: [[f0(n), "screws"], [f0(up(n / v.box)), "boxes"]] };
            },
          },
        ],
      },
      {
        trade: "Concrete & formwork",
        specs: [
          {
            id: "concrete", title: "Concrete volume",
            blurb: "Volume and 20 kg bags (≈ 0.0108 m³ yield per bag).",
            fields: [
              { id: "l", label: "Length (m)", def: "3", min: "0", step: "0.1" },
              { id: "w", label: "Width (m)", def: "3", min: "0", step: "0.1" },
              { id: "d", label: "Depth (mm)", def: "100", min: "0", step: "1" },
              { id: "waste", label: "Wastage (%)", def: "5", min: "0", step: "1" },
            ],
            compute: (v) => {
              const vol = v.l * v.w * (v.d / 1000) * pct(v.waste);
              if (vol <= 0) return null;
              return {
                rows: [[f2(vol) + " m³", "concrete"], [f0(up(vol / 0.0108)), "× 20 kg bags"]],
                warn: vol > 1.5 ? "Over ~1.5 m³ — pre-mixed delivery is usually cheaper than bags." : undefined,
              };
            },
          },
          {
            id: "mesh", title: "Reo mesh",
            blurb: "SL-grade sheets are 6.0 × 2.4 m (14.4 m²); allow ~200 mm laps.",
            fields: [
              { id: "area", label: "Slab area (m²)", def: "20", min: "0", step: "0.1" },
              { id: "lap", label: "Lap allowance (%)", def: "15", min: "0", step: "1" },
            ],
            compute: (v) => (v.area <= 0 ? null : { rows: [[f0(up((v.area * pct(v.lap)) / 14.4)), "× SL sheets (6.0 × 2.4)"]] }),
          },
          {
            id: "formply", title: "Form ply",
            blurb: "Form face sheets at 1800 × 1200 mm (2.16 m²).",
            fields: [
              { id: "area", label: "Form face area (m²)", def: "12", min: "0", step: "0.1" },
              { id: "waste", label: "Wastage (%)", def: "10", min: "0", step: "1" },
            ],
            compute: (v) => (v.area <= 0 ? null : { rows: [[f0(up((v.area * pct(v.waste)) / 2.16)), "× form ply sheets"]] }),
          },
          {
            id: "piers", title: "Footings / piers",
            blurb: "Cylindrical pier volume × count — for post footings and bored piers.",
            fields: [
              { id: "dia", label: "Diameter (mm)", def: "450", min: "1", step: "10" },
              { id: "depth", label: "Depth (mm)", def: "900", min: "1", step: "10" },
              { id: "n", label: "Number of piers", def: "6", min: "1", step: "1" },
            ],
            compute: (v) => {
              const r = v.dia / 2000;
              const vol = Math.PI * r * r * (v.depth / 1000) * v.n;
              if (vol <= 0) return null;
              return {
                rows: [[f2(vol) + " m³", "total concrete"], [f0(up(vol / 0.0108)), "× 20 kg bags"]],
                warn: vol > 1.5 ? "Over ~1.5 m³ — pre-mixed delivery is usually cheaper than bags." : undefined,
              };
            },
          },
        ],
      },
      {
        trade: "Roofing",
        specs: [
          {
            id: "roofsheets", title: "Roof sheets",
            blurb: "Sheet count from roof width and sheet cover (corrugated 762 mm, Trimdek 762, Klip-Lok 700).",
            fields: [
              { id: "w", label: "Roof width (m)", def: "12", min: "0", step: "0.1" },
              { id: "cover", label: "Sheet cover (mm)", def: "762", min: "100", step: "1" },
            ],
            compute: (v) => (v.w <= 0 || v.cover <= 0 ? null : { rows: [[f0(up((v.w * 1000) / v.cover)), "sheets across"]] }),
          },
          {
            id: "battens", title: "Battens / purlins",
            blurb: "Rows of battens up the rafter length at a given spacing, × roof width.",
            fields: [
              { id: "rafter", label: "Rafter length (m)", def: "5", min: "0", step: "0.1" },
              { id: "spc", label: "Batten spacing (mm)", def: "900", min: "100", step: "50" },
              { id: "w", label: "Roof width (m)", def: "12", min: "0", step: "0.1" },
            ],
            compute: (v) => {
              if (v.rafter <= 0 || v.spc <= 0 || v.w <= 0) return null;
              const rows = up((v.rafter * 1000) / v.spc) + 1;
              return { rows: [[f0(rows), "batten rows"], [f2(rows * v.w) + " m", "total batten length"]] };
            },
          },
        ],
      },
      {
        trade: "Landscaping",
        specs: [
          {
            id: "soil", title: "Soil / mulch / gravel volume",
            blurb: "Volume from area and depth; tonnage at a bulk density (soil ~1.2, gravel ~1.5 t/m³).",
            fields: [
              { id: "area", label: "Area (m²)", def: "20", min: "0", step: "0.1" },
              { id: "depth", label: "Depth (mm)", def: "100", min: "1", step: "5" },
              { id: "dens", label: "Density (t/m³)", def: "1.2", min: "0.1", step: "0.1" },
            ],
            compute: (v) => {
              const vol = v.area * (v.depth / 1000);
              if (vol <= 0) return null;
              return { rows: [[f2(vol) + " m³", "volume"], [f2(vol * v.dens) + " t", "approx. tonnage"]] };
            },
          },
          {
            id: "turf", title: "Turf",
            blurb: "Rolls or slabs for a lawn area. Standard roll ≈ 1 m² (2.4 × 0.42 m).",
            fields: [
              { id: "area", label: "Lawn area (m²)", def: "40", min: "0", step: "0.5" },
              { id: "per", label: "Coverage per roll (m²)", def: "1", min: "0.1", step: "0.1" },
              { id: "waste", label: "Wastage (%)", def: "5", min: "0", step: "1" },
            ],
            compute: (v) => (v.area <= 0 || v.per <= 0 ? null : { rows: [[f0(up((v.area * pct(v.waste)) / v.per)), "rolls"]] }),
          },
          {
            id: "pavers", title: "Pavers + bedding sand",
            blurb: "Paver count for an area plus a 30 mm bedding sand layer.",
            fields: [
              { id: "area", label: "Area (m²)", def: "12", min: "0", step: "0.1" },
              { id: "w", label: "Paver width (mm)", def: "230", min: "1", step: "1" },
              { id: "h", label: "Paver length (mm)", def: "190", min: "1", step: "1" },
              { id: "waste", label: "Wastage (%)", def: "5", min: "0", step: "1" },
            ],
            compute: (v) => {
              const pArea = (v.w / 1000) * (v.h / 1000);
              if (pArea <= 0 || v.area <= 0) return null;
              return {
                rows: [
                  [f0(up((v.area * pct(v.waste)) / pArea)), "pavers"],
                  [f2(v.area * 0.03) + " m³", "bedding sand (30 mm)"],
                ],
              };
            },
          },
        ],
      },
      {
        trade: "Carpentry & framing",
        specs: [
          {
            id: "studs", title: "Stud wall",
            blurb: "Studs at spacing, plus top/bottom plates. Add noggin rows separately.",
            fields: [
              { id: "len", label: "Wall length (m)", def: "6", min: "0", step: "0.1" },
              { id: "spc", label: "Stud spacing (mm)", def: "450", min: "100", step: "50" },
              { id: "ht", label: "Wall height (m)", def: "2.4", min: "0.1", step: "0.1" },
            ],
            compute: (v) => {
              if (v.len <= 0 || v.spc <= 0) return null;
              const studs = up((v.len * 1000) / v.spc) + 1;
              return { rows: [[f0(studs), "studs @ " + f0(v.spc) + " mm"], [f2(v.len * 2) + " m", "top + bottom plate"], [f2(studs * v.ht) + " m", "stud lineal metres"]] };
            },
          },
          {
            id: "decking", title: "Decking boards",
            blurb: "Lineal metres of board for a deck area, incl. board gap.",
            fields: [
              { id: "area", label: "Deck area (m²)", def: "15", min: "0", step: "0.1" },
              { id: "bw", label: "Board cover width (mm)", def: "90", min: "10", step: "1" },
              { id: "gap", label: "Gap (mm)", def: "3", min: "0", step: "1" },
              { id: "waste", label: "Wastage (%)", def: "10", min: "0", step: "1" },
            ],
            compute: (v) => {
              const cover = (v.bw + v.gap) / 1000;
              if (cover <= 0 || v.area <= 0) return null;
              return { rows: [[f2((v.area / cover) * pct(v.waste)) + " m", "board lineal metres"]] };
            },
          },
        ],
      },
      {
        trade: "Flooring",
        specs: [
          {
            id: "floating", title: "Floating floor",
            blurb: "Packs of laminate/hybrid for an area, including cut wastage.",
            fields: [
              { id: "area", label: "Floor area (m²)", def: "20", min: "0", step: "0.1" },
              { id: "pack", label: "Pack coverage (m²)", def: "2.1", min: "0.1", step: "0.1" },
              { id: "waste", label: "Wastage (%)", def: "8", min: "0", step: "1" },
            ],
            compute: (v) => (v.pack <= 0 || v.area <= 0 ? null : { rows: [[f0(up((v.area * pct(v.waste)) / v.pack)), "packs"]] }),
          },
          {
            id: "underlay", title: "Underlay",
            blurb: "Rolls of acoustic/foam underlay (roll ≈ 10–15 m²).",
            fields: [
              { id: "area", label: "Floor area (m²)", def: "20", min: "0", step: "0.1" },
              { id: "roll", label: "Roll coverage (m²)", def: "10", min: "0.1", step: "0.5" },
            ],
            compute: (v) => (v.roll <= 0 || v.area <= 0 ? null : { rows: [[f0(up(v.area / v.roll)), "rolls"]] }),
          },
        ],
      },
      {
        trade: "Bricks & blocks",
        specs: [
          {
            id: "bricks", title: "Bricks",
            blurb: "Standard face brick ≈ 50 / m² of single-skin wall.",
            fields: [
              { id: "area", label: "Wall area (m²)", def: "15", min: "0", step: "0.1" },
              { id: "per", label: "Bricks / m²", def: "50", min: "1", step: "1" },
              { id: "waste", label: "Wastage (%)", def: "5", min: "0", step: "1" },
            ],
            compute: (v) => (v.area <= 0 ? null : { rows: [[f0(up(v.area * v.per * pct(v.waste))), "bricks"]] }),
          },
          {
            id: "blocks", title: "Besser blocks",
            blurb: "200-series block ≈ 12.5 / m² of wall.",
            fields: [
              { id: "area", label: "Wall area (m²)", def: "15", min: "0", step: "0.1" },
              { id: "per", label: "Blocks / m²", def: "12.5", min: "0.1", step: "0.1" },
              { id: "waste", label: "Wastage (%)", def: "5", min: "0", step: "1" },
            ],
            compute: (v) => (v.area <= 0 ? null : { rows: [[f0(up(v.area * v.per * pct(v.waste))), "blocks"]] }),
          },
          {
            id: "mortar", title: "Mortar (premix)",
            blurb: "Rough guide ≈ 0.6 × 20 kg bags per m² of brickwork.",
            fields: [
              { id: "area", label: "Brickwork area (m²)", def: "15", min: "0", step: "0.1" },
              { id: "rate", label: "Bags / m²", def: "0.6", min: "0.05", step: "0.05" },
            ],
            compute: (v) => (v.area <= 0 ? null : { rows: [[f0(up(v.area * v.rate)), "× 20 kg bags"]] }),
          },
          {
            id: "render", title: "Render",
            blurb: "Bagged render at a coat thickness. ~1.7 kg/m² per mm of thickness.",
            fields: [
              { id: "area", label: "Wall area (m²)", def: "15", min: "0", step: "0.1" },
              { id: "t", label: "Thickness (mm)", def: "10", min: "1", step: "1" },
              { id: "bag", label: "Bag size (kg)", def: "20", min: "1", step: "1" },
            ],
            compute: (v) => {
              if (v.area <= 0 || v.bag <= 0) return null;
              const kg = v.area * v.t * 1.7;
              return { rows: [[f0(kg) + " kg", "render"], [f0(up(kg / v.bag)), "bags"]] };
            },
          },
        ],
      },
      {
        trade: "Insulation",
        specs: [
          {
            id: "batts", title: "Wall / ceiling batts",
            blurb: "Packs of batts for an area (pack coverage varies by R-value).",
            fields: [
              { id: "area", label: "Area (m²)", def: "30", min: "0", step: "0.1" },
              { id: "pack", label: "Pack coverage (m²)", def: "5.4", min: "0.1", step: "0.1" },
              { id: "waste", label: "Wastage (%)", def: "5", min: "0", step: "1" },
            ],
            compute: (v) => (v.pack <= 0 || v.area <= 0 ? null : { rows: [[f0(up((v.area * pct(v.waste)) / v.pack)), "packs"]] }),
          },
        ],
      },
    ];

    const root = document.getElementById("calcs")!;
    const tabBar = document.getElementById("mat-tabs")!;
    const slug = (s: string) => s.toLowerCase().replace(/[^a-z]+/g, "-").replace(/^-|-$/g, "");
    const panels: HTMLElement[] = [];
    const buttons: HTMLButtonElement[] = [];

    groups.forEach((g, i) => {
      const panel = document.createElement("div");
      panel.className = "mat-panel";
      panel.hidden = i !== 0;
      panel.dataset.panel = slug(g.trade);
      mountCalcs(panel, g.specs);
      root.append(panel);
      panels.push(panel);

      const b = document.createElement("button");
      b.type = "button";
      b.className = "mat-tab" + (i === 0 ? " active" : "");
      b.textContent = g.trade;
      b.addEventListener("click", () => {
        panels.forEach((p, j) => (p.hidden = j !== i));
        buttons.forEach((btn, j) => btn.classList.toggle("active", j === i));
        history.replaceState(null, "", "#" + slug(g.trade));
      });
      tabBar.append(b);
      buttons.push(b);
    });

    const want = location.hash.slice(1);
    const idx = groups.findIndex((g) => slug(g.trade) === want);
    if (idx > 0) buttons[idx].click();

    wireActions(root, "Material calculators");
  </script>

  <style>
    .mat-layout { display: grid; grid-template-columns: 12rem 1fr; gap: 1.5rem; align-items: start; margin-top: 0.5rem; }
    .mat-tabs { display: flex; flex-direction: column; gap: 0.25rem; position: sticky; top: 5rem; }
    .mat-tab {
      padding: 0.5rem 0.9rem; font-size: 0.9rem; font-family: var(--font-sans); cursor: pointer; text-align: left;
      color: var(--muted); background: transparent; border: 1px solid transparent; border-left: 2px solid var(--rule); border-radius: 0;
    }
    .mat-tab:hover { color: var(--fg); }
    .mat-tab.active { color: var(--fg); font-weight: 600; border-left-color: var(--fg); }
    .mat-panel[hidden] { display: none; }
    @media (max-width: 720px) {
      .mat-layout { display: block; }
      .mat-tabs { flex-direction: row; flex-wrap: wrap; gap: 0.4rem; position: static; margin-bottom: 1.25rem; }
      .mat-tab { border: 1px solid var(--rule); border-radius: 999px; padding: 0.45rem 1rem; text-align: center; }
      .mat-tab.active { background: var(--fg); color: var(--bg); border-color: var(--fg); }
    }
  </style>
</Base>
