---
import Base from "../../layouts/Base.astro";
import ToolIntro from "../../components/ToolIntro.astro";
import "../../styles/site.css";
---

<Base
  title="Programme Builder — free CPM Gantt tool (Australia)"
  description="Build a critical-path construction programme with FS/SS/FF links, working-day calendars and a fitout trade sequence."
  siteNav
>
  <div class="blueprint tool programme">
    <p class="eyebrow"><a href="/site" style="color:inherit;text-decoration:none">Site</a> / Programme</p>
    <h1>Programme Builder</h1>
    <p>
      Generate a construction programme from a template, or build one task by
      task. Proper critical-path scheduling — FS/SS/FF links with lag, working-day
      calendar, float — with the fitout trade sequence built in.
    </p>

    <div id="programme-root" aria-live="polite"></div>

    <ToolIntro href="/site/programme" />
    <p class="note-foot">Indicative programme only — validate durations against your own benchmarks. <a href="/site">← all tools</a></p>
  </div>

  <script>
    import { initProgramme } from "../../scripts/site/programme";
    initProgramme(document.getElementById("programme-root")!);
  </script>

  <style>
    .programme {
      --prog-crit: #c0392b;
      --prog-today: #2c9c4a;
    }
    :global([data-theme="dark"]) .programme {
      --prog-crit: #ff7a6b;
      --prog-today: #58c97a;
    }
    /* Phones use a viewport-wide editor beneath the compact tool picker. */
    .programme :global(#programme-root) {
      position: relative;
      left: 50%;
      width: min(90rem, calc(100vw - 2rem));
      transform: translateX(-50%);
    }
    /* Desktop is a true two-column workspace: navigation at the viewport edge,
       then the programme consuming every remaining pixel. */
    @media (min-width: 1100px) {
      .programme > p:not(.eyebrow):not(.note-foot) { max-width: 58rem; }
      .programme :global(#programme-root) {
        left: auto;
        width: 100%;
        transform: none;
      }
    }
    .programme :global(.prog-split),
    .programme :global(.prog-toolbar),
    .programme :global(.prog-stats) { max-width: none; }

    .programme :global(.prog-card) { border: 1px solid var(--rule); border-radius: var(--radius); padding: 1rem 1.1rem; margin: 1rem 0; }
    .programme :global(.prog-card-title) { font-family: var(--font-sans); font-size: 0.72rem; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 0.35rem; }
    .programme :global(.prog-blurb) { font-size: 0.85rem; color: var(--muted); margin: 0.2rem 0 0.6rem; }
    .programme :global(.prog-row) { display: flex; align-items: center; gap: var(--gap-1); border-bottom: 1px solid var(--rule); }
    .programme :global(.prog-open) { flex: 1; min-width: 0; text-align: left; background: none; border: none; cursor: pointer; padding: 0.6rem 0; font: inherit; color: var(--fg); display: flex; flex-direction: column; }
    .programme :global(.prog-name) { font-weight: 600; }
    .programme :global(.prog-sub) { font-size: 0.78rem; color: var(--muted); }
    .programme :global(.prog-del) { background: none; border: none; color: var(--prog-crit); cursor: pointer; font-size: 1rem; min-width: 44px; min-height: 44px; }
    .programme :global(.prog-gen) { display: flex; gap: 1rem; flex-wrap: wrap; margin: 0.4rem 0 0.8rem; }
    .programme :global(.prog-gen .field) { display: flex; flex-direction: column; gap: 0.25rem; }
    .programme :global(.prog-gen label) { font-size: 0.78rem; color: var(--muted); }
    .programme :global(.prog-gen input) { background: var(--bg); border: 1px solid var(--rule); border-radius: var(--radius-sm); color: var(--fg); font: inherit; padding: 0.4rem 0.6rem; }
    .programme :global(.prog-tpl-wrap) { display: flex; flex-wrap: wrap; gap: var(--gap-1); }
    .programme :global(.prog-tpl) { text-align: left; background: var(--code-bg); border: 1px solid var(--rule); border-radius: var(--radius); padding: 0.5rem 0.75rem; cursor: pointer; font: inherit; color: var(--fg); transition: border-color var(--dur-fast) var(--ease); }
    .programme :global(.prog-tpl:hover) { border-color: var(--accent); }
    .programme :global(.prog-tpl-name) { font-size: 0.9rem; font-weight: 600; }
    .programme :global(.prog-tpl-blurb) { font-size: 0.72rem; color: var(--muted); }

    .programme :global(.prog-toolbar) { display: flex; align-items: center; gap: 0.4rem; padding: 0.6rem 0 0.4rem; flex-wrap: wrap; }
    .programme :global(.prog-tb) { background: var(--code-bg); border: 1px solid var(--rule); border-radius: var(--radius-sm); color: var(--fg); font: inherit; font-size: 0.85rem; min-height: 40px; padding: 0.3rem 0.7rem; cursor: pointer; }
    .programme :global(.prog-title) { background: none; border: none; border-bottom: 1px dashed transparent; color: var(--fg); font: inherit; font-size: 1rem; font-weight: 600; max-width: 34%; padding: 0.3rem 0.4rem; }
    .programme :global(.prog-title:focus) { outline: none; border-bottom-color: var(--accent); }
    .programme :global(.prog-date) { cursor: auto; }
    .programme :global(.prog-spacer) { flex: 1; }
    .programme :global(.prog-stats) { display: flex; gap: 1.2rem; flex-wrap: wrap; font-size: 0.85rem; color: var(--muted); padding: 0.2rem 0 0.6rem; }
    .programme :global(.prog-stats strong) { color: var(--fg); }

    .programme :global(.prog-split) { display: grid; grid-template-columns: minmax(340px, 46%) 1fr; gap: 0; border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; align-items: stretch; }
    @media (max-width: 900px) { .programme :global(.prog-split) { grid-template-columns: 1fr; } }
    .programme :global(.prog-resize-handle) { background: var(--rule); cursor: col-resize; touch-action: none; }
    .programme :global(.prog-resize-handle:hover), .programme :global(.prog-resize-handle:active) { background: var(--accent); }
    .programme :global(.prog-table-pane) { display: flex; flex-direction: column; min-width: 0; border-right: 1px solid var(--rule); }
    .programme :global(.prog-table-toolbar) { display: flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--rule); }
    .programme :global(.prog-table-footer) { display: flex; gap: var(--gap-1); padding: 0.5rem; }
    .programme :global(.prog-tb-secondary) { opacity: 0.75; }
    .programme :global(.prog-cols), .programme :global(.prog-kbd) { position: relative; }
    .programme :global(.prog-cols summary), .programme :global(.prog-kbd summary) { list-style: none; }
    .programme :global(.prog-cols summary::-webkit-details-marker), .programme :global(.prog-kbd summary::-webkit-details-marker) { display: none; }
    .programme :global(.prog-cols-list), .programme :global(.prog-kbd-list) {
      position: absolute; top: calc(100% + 4px); left: 0; z-index: 20;
      background: var(--bg); border: 1px solid var(--rule); border-radius: var(--radius);
      padding: 0.5rem; box-shadow: 0 8px 24px rgba(0,0,0,0.2); min-width: 13rem;
    }
    .programme :global(.prog-kbd-list) { right: 0; left: auto; min-width: 18rem; }
    .programme :global(.prog-cols-item) { display: flex; align-items: center; gap: var(--gap-1); padding: 0.3rem 0.2rem; font-size: 0.82rem; min-height: 28px; }
    .programme :global(.prog-cols-item input) { width: 16px; height: 16px; }
    .programme :global(.prog-cols-reset) { width: 100%; margin-top: 0.4rem; }
    .programme :global(.prog-kbd-row) { display: flex; justify-content: space-between; gap: var(--gap-2); padding: 0.3rem 0; font-size: 0.78rem; border-bottom: 1px solid var(--rule); }
    .programme :global(.prog-kbd-row:last-child) { border-bottom: none; }
    .programme :global(.prog-kbd-row kbd) { font-family: var(--font-mono); background: var(--code-bg); border: 1px solid var(--rule); border-radius: var(--radius-sm); padding: 0.05rem 0.35rem; font-size: 0.72rem; white-space: nowrap; }
    .programme :global(.prog-table-wrap) { overflow-x: auto; flex: 1; }
    .programme :global(.prog-table) { border-collapse: collapse; table-layout: fixed; font-size: 0.76rem; }
    .programme :global(.prog-table th) { position: relative; text-align: left; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.06em; color: var(--muted); padding: 0.4rem 0.3rem; border-bottom: 1px solid var(--rule); height: 44px; box-sizing: border-box; }
    .programme :global(.pc-resize) { position: absolute; top: 0; right: -4px; width: 8px; height: 100%; cursor: col-resize; touch-action: none; z-index: 2; }
    .programme :global(.pc-resize:hover) { background: color-mix(in srgb, var(--accent) 40%, transparent); }
    .programme :global(.prog-table td) { border-bottom: 1px solid var(--rule); padding: 0 0.12rem; height: 30px; box-sizing: border-box; overflow: hidden; }
    .programme :global(.prog-table input) { width: 100%; background: none; border: none; color: var(--fg); font: inherit; font-size: 0.76rem; padding: 0.2rem; box-sizing: border-box; min-height: 28px; }
    .programme :global(.prog-table input:focus) { outline: 1px solid var(--accent); border-radius: 3px; }
    .programme :global(.prog-bad) { outline: 1px solid var(--prog-crit) !important; }
    .programme :global(.pc-pred input.prog-invalid) { border: 1px solid color-mix(in srgb, var(--prog-crit) 55%, transparent) !important; border-radius: 3px; }
    .programme :global(.pc-num) { width: 1.6rem; color: var(--muted); text-align: right; font-family: var(--font-mono); font-size: 0.68rem; }
    .programme :global(.pc-date) { white-space: nowrap; color: var(--muted); font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis; }
    .programme :global(.pc-x) { width: 2rem; }
    .programme :global(.pc-x button) { background: none; border: none; color: var(--muted); cursor: pointer; min-width: 28px; min-height: 28px; opacity: 0.6; }
    .programme :global(.pc-x button:hover), .programme :global(.pc-x button:focus-visible) { color: var(--prog-crit); opacity: 1; }
    .programme :global(.prog-crit-row .pc-name input) { color: var(--prog-crit); }
    .programme :global(.prog-ms-row .pc-name input) { font-weight: 600; }

    .programme :global(.prog-gantt-wrap) { overflow-x: auto; background: var(--bg); }
    .programme :global(.prog-gantt) { display: block; }
    .programme :global(.pg-offday) { fill: color-mix(in srgb, var(--fg) 5%, transparent); }
    .programme :global(.pg-rowband) { fill: transparent; }
    .programme :global(.pg-rowband-alt) { fill: color-mix(in srgb, var(--fg) 2.5%, transparent); }
    .programme :global(.pg-weekline) { fill: var(--rule); }
    .programme :global(.pg-month) { font-size: 11px; font-weight: 600; fill: var(--fg); font-family: var(--font-mono); }
    .programme :global(.pg-day) { font-size: 9px; fill: var(--muted); font-family: var(--font-mono); }
    .programme :global(.pg-today) { fill: var(--prog-today); }
    .programme :global(.pg-bar) { rx: 3; opacity: 0.9; }
    .programme :global(.pg-crit) { stroke: var(--prog-crit); stroke-width: 1.5; }
    .programme :global(.pg-night) { fill: color-mix(in srgb, var(--fg) 55%, transparent); }
    .programme :global(.pg-milestone) { fill: var(--fg); }
    .programme :global(.pg-mslabel) { font-size: 10px; fill: var(--muted); }
    :global(.prog-toast) { position: fixed; bottom: 1.2rem; left: 50%; transform: translateX(-50%); background: var(--fg); color: var(--bg); font-size: 0.85rem; padding: 0.5rem 1rem; border-radius: var(--radius); z-index: 50; }
    :global(.prog-undochip) { position: fixed; bottom: 1.2rem; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: var(--gap-2); background: var(--fg); color: var(--bg); font-size: 0.85rem; padding: 0.5rem 0.6rem 0.5rem 1rem; border-radius: var(--radius); z-index: 55; }
    :global(.prog-undochip button) { background: color-mix(in srgb, var(--bg) 20%, transparent); color: inherit; border: 1px solid color-mix(in srgb, var(--bg) 40%, transparent); border-radius: var(--radius-sm); padding: 0.25rem 0.6rem; cursor: pointer; min-height: 28px; font: inherit; }

    .programme :global(.pg-link) { fill: none; stroke: var(--muted); stroke-width: 1.2; opacity: 0.55; cursor: pointer; }
    .programme :global(.pg-link:hover) { stroke: var(--accent); opacity: 1; stroke-width: 2; }
    .programme :global(.pg-linkhead) { fill: var(--muted); opacity: 0.7; }
    .programme :global(.pg-linkdot) { fill: var(--bg); stroke: var(--muted); stroke-width: 1.2; cursor: crosshair; }
    .programme :global(.pg-linkdot:hover) { stroke: var(--accent); fill: var(--accent); }
    .programme :global(.pg-handle) { fill: transparent; cursor: ew-resize; }
    .programme :global(.pg-bar) { cursor: grab; }
    .programme :global(.pg-ghostbar) { fill: none; stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 4 3; }
    .programme :global(.pg-linkdraft) { stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 4 3; }
    .programme :global(.pg-float) { fill: var(--muted); opacity: 0.7; }
    .programme :global(.pg-phase) { fill: var(--accent); opacity: 0.65; }
    .programme :global(.pg-phaselabel) { font-size: 9px; fill: var(--accent); font-family: var(--font-mono); }
    .programme :global(.pg-hist) { fill: var(--accent); opacity: 0.45; }
    .programme :global(.pg-pin) { font-size: 10px; }

    /* renderTimeline() tears down and rebuilds the whole <svg> on every edit
       commit, so every bar/milestone/link is a fresh element each time —
       gate on the split staying out of focus so only the first paint (or a
       re-render while nothing in the editor is focused) plays the entry. */
    .programme :global(.prog-split:not(:focus-within) .pg-bar) {
      transform-box: fill-box;
      transform-origin: left center;
      transition: transform 320ms var(--ease);
    }
    @starting-style {
      .programme :global(.prog-split:not(:focus-within) .pg-bar) { transform: scaleX(0); }
    }
    .programme :global(.prog-split:not(:focus-within) .pg-milestone) {
      transition: opacity 320ms var(--ease);
    }
    @starting-style {
      .programme :global(.prog-split:not(:focus-within) .pg-milestone) { opacity: 0; }
    }
    .programme :global(.prog-split:not(:focus-within) .pg-link),
    .programme :global(.prog-split:not(:focus-within) .pg-linkhead) {
      transition: opacity 320ms var(--ease) 200ms;
    }
    @starting-style {
      .programme :global(.prog-split:not(:focus-within) .pg-link),
      .programme :global(.prog-split:not(:focus-within) .pg-linkhead) { opacity: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      .programme :global(.pg-bar),
      .programme :global(.pg-milestone),
      .programme :global(.pg-link),
      .programme :global(.pg-linkhead) { transition: none; }
    }

    :global(.prog-linkedit) { position: fixed; z-index: 60; display: flex; gap: 0.3rem; background: var(--bg); border: 1px solid var(--rule); border-radius: var(--radius); padding: 0.4rem; box-shadow: 0 4px 18px rgba(0,0,0,0.25); }
    :global(.prog-linkedit select), :global(.prog-linkedit input) { background: var(--code-bg); border: 1px solid var(--rule); border-radius: var(--radius-sm); color: var(--fg); font: inherit; font-size: 0.8rem; padding: 0.2rem; width: 4rem; }
    :global(.prog-linkedit select) { width: auto; }
    :global(.prog-linkedit button) { background: var(--code-bg); border: 1px solid var(--rule); border-radius: var(--radius-sm); color: var(--fg); cursor: pointer; font-size: 0.8rem; padding: 0.2rem 0.5rem; }
    .programme :global(.prog-proc) { border-collapse: collapse; width: 100%; font-size: 0.8rem; margin-top: 0.4rem; }
    .programme :global(.prog-proc th) { text-align: left; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.06em; color: var(--muted); padding: 0.3rem 0.5rem 0.3rem 0; border-bottom: 1px solid var(--rule); }
    .programme :global(.prog-proc td) { padding: 0.35rem 0.5rem 0.35rem 0; border-bottom: 1px solid var(--rule); }
    .programme :global(.prog-late) { color: var(--prog-crit); font-weight: 600; }
    .programme :global(.prog-critchip) { color: var(--accent); font-size: 0.72rem; }
    .programme :global(.pg-ghost) { fill: color-mix(in srgb, var(--fg) 40%, transparent); }
    .programme :global(.prog-rebase-input) { background: var(--bg); border: 1px solid var(--prog-crit); border-radius: var(--radius-sm); color: var(--fg); font: inherit; font-size: 0.85rem; padding: 0.35rem 0.6rem; min-width: 16rem; }

    .programme :global(.prog-seg) { display: flex; gap: 0.4rem; padding: 0 0 0.5rem; }
    .programme :global(.prog-seg-on) { border-color: var(--accent); color: var(--accent); }
    .programme :global(.prog-hintchip) { display: flex; align-items: center; gap: 0.6rem; background: var(--code-bg); border: 1px solid var(--rule); border-radius: 99px; font-size: 0.8rem; color: var(--muted); padding: 0.35rem 0.5rem 0.35rem 0.9rem; margin-bottom: 0.5rem; width: fit-content; }
    .programme :global(.prog-hintchip button) { background: none; border: none; color: var(--muted); cursor: pointer; min-width: 32px; min-height: 32px; }
    .programme :global(.pg-barlabel-in) { font-size: 10px; fill: #fff; font-family: var(--font-mono); }
    @media (max-width: 900px) {
      .programme :global(.prog-chart-only .prog-table-pane) { display: none; }
      .programme :global(.prog-chart-only) { grid-template-columns: 1fr; }
      .programme :global(.prog-table-only .prog-gantt-wrap) { display: none; }
      .programme :global(.prog-table-only) { grid-template-columns: 1fr; }
      .programme :global(.prog-table input), .programme :global(.prog-gen input), .programme :global(.prog-title) { font-size: 16px; }
      .programme :global(.prog-date) { max-width: 8.5rem; }
    }
    /* Fullscreen and the API fallback share one app-mode contract. */
    .programme :global(#programme-root:fullscreen),
    .programme :global(#programme-root.prog-app-mode) {
      left: auto; width: 100%; height: 100dvh; transform: none; box-sizing: border-box;
      background: var(--bg); padding: 0.5rem 0.75rem; overflow: auto;
    }
    .programme :global(#programme-root.prog-app-mode) { position: fixed; inset: 0; z-index: 200; }
    :global(body.prog-app-open) { overflow: hidden; }
    .programme :global(#programme-root:fullscreen .prog-toolbar),
    .programme :global(#programme-root.prog-app-mode .prog-toolbar) {
      position: sticky; top: -0.5rem; z-index: 12; margin: 0 -.75rem;
      padding: .5rem .75rem; background: color-mix(in srgb, var(--bg) 96%, transparent);
      border-bottom: 1px solid var(--rule); backdrop-filter: blur(10px);
    }
    .programme :global(#programme-root:fullscreen .prog-split),
    .programme :global(#programme-root.prog-app-mode .prog-split) {
      grid-template-columns: minmax(280px, 30%) 1fr;
      min-height: calc(100dvh - 8.5rem);
    }
    .programme :global(#programme-root:fullscreen .prog-gantt-wrap),
    .programme :global(#programme-root.prog-app-mode .prog-gantt-wrap),
    .programme :global(#programme-root:fullscreen .prog-table-wrap),
    .programme :global(#programme-root.prog-app-mode .prog-table-wrap) { max-height: none; overflow: auto; }
    @media (max-width: 900px) {
      .programme :global(#programme-root:fullscreen .prog-split),
      .programme :global(#programme-root.prog-app-mode .prog-split) { grid-template-columns: 1fr; min-height: calc(100dvh - 11.5rem); }
      .programme :global(#programme-root:fullscreen .prog-gantt-wrap),
      .programme :global(#programme-root.prog-app-mode .prog-gantt-wrap) { min-height: calc(100dvh - 12rem); }
    }

    :global(.prog-tut) { position: static; pointer-events: none; }
    :global(.prog-tut-shade) { position: fixed; inset: 0; z-index: 1000; pointer-events: auto; background: rgba(5,8,13,.48); backdrop-filter: blur(2px); }
    :global(.prog-tut-card) {
      position: fixed; right: 1rem; bottom: 1rem; z-index: 1003; pointer-events: auto;
      width: min(30rem, calc(100vw - 2rem)); max-height: calc(100dvh - 2rem); overflow: auto;
      color: var(--fg); background: var(--bg); border: 1px solid var(--rule); border-radius: var(--radius);
      padding: 1rem; box-shadow: 0 18px 60px rgba(0,0,0,.38);
    }
    :global(.prog-tut-step), :global(.prog-tut-section) { font: 700 .68rem/1.2 var(--font-sans); letter-spacing: .12em; color: var(--site-accent); }
    :global(.prog-tut-title) { margin: .35rem 0 .5rem; font-size: 1.15rem; }
    :global(.prog-tut-text) { margin: .25rem 0 .75rem; font-size: .9rem; line-height: 1.5; color: var(--muted); }
    :global(.prog-tut-actions) { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .4rem; border-top: 1px solid var(--rule); padding-top: .75rem; }
    :global(.prog-tut-btn) { min-height: 40px; padding: .4rem .75rem; color: var(--fg); background: var(--code-bg); border: 1px solid var(--rule); border-radius: var(--radius-sm); cursor: pointer; }
    :global(.prog-tut-search) { width: 100%; min-height: 44px; padding: .55rem .7rem; color: var(--fg); background: var(--bg); border: 1px solid var(--rule); border-radius: 7px; font: inherit; }
    :global(.prog-tut-topics) { margin: .75rem 0; }
    :global(.prog-tut-section) { margin: 1rem 0 .35rem; }
    :global(.prog-tut-topic) { padding: .6rem 0; border-bottom: 1px solid var(--rule); }
    :global(.prog-tut-topic-title) { margin: 0; font-size: .95rem; }
    :global(.prog-tut-target) { position: relative; z-index: 1002 !important; outline: 3px solid var(--site-accent) !important; outline-offset: 4px; background-color: var(--bg); }
    @media (max-width: 700px) {
      :global(.prog-tut-card) { left: .5rem; right: .5rem; bottom: .5rem; width: auto; max-height: calc(100dvh - 1rem); }
      :global(.prog-tut-btn) { min-height: 44px; }
    }

    @page { size: A3 landscape; margin: 10mm; }
    @media print {
      :global(nav), :global(.site-rail), :global(.eyebrow), :global(.note-foot),
      .programme :global(.prog-toolbar), .programme :global(.prog-card:has(.prog-tpl)),
      .programme :global(.pc-x), .programme :global(.pg-linkdot),
      .programme :global(.prog-table-toolbar), .programme :global(.prog-table-footer),
      .programme :global(.prog-resize-handle), .programme :global(.pc-resize) { display: none !important; }
      .programme :global(.prog-split) { grid-template-columns: 34% 1fr !important; border: none; }
      .programme :global(#programme-root) { left: auto; width: 100%; transform: none; }
      .programme :global(.prog-gantt-wrap), .programme :global(.prog-table-wrap) { overflow: visible; }
      :global(body) { max-width: none; padding: 0; }
    }
  </style>
</Base>
