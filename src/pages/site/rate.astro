---
import Base from "../../layouts/Base.astro";
import "../../styles/site.css";
---

<Base
  title="Rate Builder"
  description="Build up a unit rate line by line — materials, labour, plant and margin. Save your own rates locally. Runs entirely in your browser."
  siteNav
>
  <div class="blueprint tool">
    <p class="eyebrow"><a href="/site" style="color:inherit;text-decoration:none">Site Tools</a> / Rate builder</p>
    <h1>Rate Builder</h1>
    <p>Add a line for each cost, pick its type, and set quantity and unit cost. Add a margin and you have a unit rate. No rates ship with this tool; anything you save stays on your device.</p>

    <div class="field" style="max-width:28rem;">
      <label for="r-desc">Rate name</label>
      <input type="text" id="r-desc" maxlength="60" placeholder="e.g. Install 100x100 SHS bracket" />
    </div>

    <h2 style="font-size:1rem;margin-top:1.25rem;">Build-up lines</h2>
    <div id="r-lines"></div>
    <div class="btn-row no-print">
      <button type="button" class="btn btn-ghost btn-sm" id="r-addline">+ Add line</button>
    </div>

    <div class="field" style="max-width:10rem;">
      <label for="r-margin">Margin (%)</label>
      <input type="number" id="r-margin" min="0" step="1" inputmode="decimal" value="15" />
    </div>

    <div id="r-out" class="result" aria-live="polite"></div>

    <div class="btn-row no-print">
      <button type="button" class="btn" id="r-save">Save rate</button>
      <button type="button" class="btn btn-ghost" id="r-export">Email my rates</button>
      <button type="button" class="btn btn-ghost" id="r-clear">Clear saved</button>
    </div>

    <h2 style="font-size:1rem;margin-top:1.5rem;">Saved rates</h2>
    <div id="r-saved"></div>
    <p class="disclosure">Saved rates are stored only in this browser (localStorage) — never uploaded. Clear them any time.</p>

    <p class="note-foot">Estimates only. <a href="/site">← all tools</a></p>
  </div>

  <script>
    import { initRate } from "../../scripts/site/rate";
    initRate();
  </script>
</Base>
