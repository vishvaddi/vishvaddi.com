    </p>

    <div id="prep-app"></div>

    <p class="note-foot">
      Reference only — not a substitute for first-aid training or official
      warnings. <a href="/site">← all tools</a>
    </p>
  </div>

  <script>
    import { initPrepping } from "../../scripts/site/prepping";
    initPrepping();
