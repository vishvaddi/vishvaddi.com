---
// The periodic table has moved to Prepping → Science.
const dest = "/prepping/science";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${dest}`} />
    <link rel="canonical" href={dest} />
    <meta name="robots" content="noindex" />
    <title>Moved — Periodic Table</title>
  </head>
  <body>
    <p>The periodic table has moved to <a href={dest}>Prepping → Science</a>.</p>
    <script is:inline set:html={`location.replace(${JSON.stringify(dest)});`}></script>
  </body>
</html>
