---
import Base from "../../layouts/Base.astro";
import "../../styles/site.css";

// Keep ids in sync with workers/votes OPTIONS.
const items = [
  { id: "2d-sheet", title: "2D sheet / panel optimiser", desc: "Nest rectangular parts into sheets (ply, melamine) — the big one." },
  { id: "timber-span", title: "Timber span / joist sizer", desc: "Quick span checks for joists, bearers and rafters." },
  { id: "beam-point-load", title: "Beam reactions", desc: "Reactions and max moment for simple point/UDL loads." },
  { id: "concrete-mix", title: "Concrete mix", desc: "Cement / sand / aggregate by ratio and volume." },
  { id: "fastener-spacing", title: "Fastener spacing", desc: "Screws or nails per board / sheet at a given spacing." },
  { id: "reno-budget", title: "Renovation budget splitter", desc: "Allocate a budget across trades with contingency." },
  { id: "fall-setout", title: "Drainage set-out", desc: "Invert levels and string lengths along a run." },
  { id: "stair-stringer", title: "Stair stringer layout", desc: "Mark-out dimensions for cutting a stringer." },
];
---

<Base
  title="Roadmap"
  description="Vote for the next free Site tool on vishvaddi.com."
>
  <div class="blueprint tool">
    <p class="eyebrow"><a href="/site" style="color:inherit;text-decoration:none">Site</a> / Roadmap</p>
    <h1>What should I build next?</h1>
    <p>Candidate tools — vote for the ones you'd actually use. No login; one vote per tool per day, counted by an isolated service that stores nothing about you.</p>

    <ul id="roadmap" class="tool-grid" style="grid-template-columns:1fr;">
      {items.map((it) => (
        <li class="tool-card" data-option={it.id} style="display:flex;justify-content:space-between;align-items:center;gap:1rem;">
          <span>
            <span class="t">{it.title}</span>
            <span class="d">{it.desc}</span>
          </span>
          <span style="display:flex;align-items:center;gap:0.6rem;white-space:nowrap;">
            <span class="n" data-count={it.id} hidden style="font-size:1.1rem;font-family:var(--font-mono)"></span>
            <button type="button" class="btn btn-sm vote-btn">👍 Vote</button>
          </span>
        </li>
      ))}
    </ul>

    <p class="note-foot">Or just email me: <a href="mailto:vishvaddi@gmail.com">vishvaddi@gmail.com</a>. <a href="/site">← all tools</a></p>
  </div>

  <script>
    import { initRoadmap } from "../../scripts/site/calc";
    // Set this to your deployed votes Worker once live, e.g.
    // "https://vishvaddi-votes.<subdomain>.workers.dev/api/votes"
    const ENDPOINT = "";
    initRoadmap(ENDPOINT);
  </script>
</Base>
