---
import Base from "../../layouts/Base.astro";
import "../../styles/site.css";
import { SITE_TOOLS, SITE_TOOL_CATEGORIES } from "../../data/site-tools";
---

<Base
  title="Site Tools"
  description="Free browser-based tools for trades and estimators. Nothing leaves your device."
  siteNav
>
  <div class="blueprint">
    <p class="eyebrow">Field tools</p>
    <h1>Site Tools</h1>
    <p>
      Free calculators for shopfitting, construction and DIY. Everything runs
      entirely in your browser — no account, no sign-up, nothing uploaded. Print
      to PDF or email a copy to yourself.
    </p>

    <label class="hub-search-label" for="site-hub-search">Find the right tool</label>
    <input id="site-hub-search" class="hub-search" type="search" placeholder="Try ‘convert’, ‘programme’, ‘variation’…" autocomplete="off" />
    <p id="site-search-empty" class="note-foot" hidden>No matching tools.</p>

    <section id="site-recent" class="site-recent" hidden>
      <h2 class="site-group-title">Recently used</h2>
      <ul class="tool-grid" id="site-recent-grid"></ul>
    </section>

    {SITE_TOOL_CATEGORIES.map((category) => (
      <section class="site-tool-section" data-tool-group>
        <h2 class="site-group-title">{category}</h2>
        <ul class="tool-grid">
          {SITE_TOOLS.filter((tool) => tool.category === category).map((tool) => (
            <li data-tool-item data-search={`${tool.title} ${tool.aliases}`}>
              <a class="tool-card" href={tool.href} data-tool={tool.href}>
                <span class="tool-ico" aria-hidden="true">{tool.icon}</span>
                <span class="t">{tool.title}</span>
                <span class="d"><strong>Problem:</strong> {tool.problem}</span>
                <span class="d"><strong>Does:</strong> {tool.promise}</span>
                <span class="tool-privacy">Private · {tool.privacy}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="note-foot">
      Nothing you type leaves your browser. <a href="/">← vishvaddi.com</a>
    </p>
  </div>

  <script src="/scripts/site-hub.js" defer></script>
</Base>
