---
import Base from "../../layouts/Base.astro";
import "../../styles/site.css";

const groups = [
  {
    name: "Calculators & optimisers",
    tools: [
      { href: "/site/calc", icon: "🧮", title: "Calculator", desc: "Expressions, functions, constants and your own variables. Deg/rad, history." },
      { href: "/site/cut-list", icon: "✂️", title: "Cut List Optimizer", desc: "Pack pieces into stock lengths, minimise waste, print a cut plan." },
      { href: "/site/sheet", icon: "▦", title: "2D Sheet Optimizer", desc: "Nest parts onto ply / MDF / melamine sheets; minimise offcut." },
      { href: "/site/materials", icon: "🧱", title: "Material Calculators", desc: "Paint, tiles, plasterboard, concrete and linear quantities." },
      { href: "/site/geometry", icon: "📐", title: "Geometry & Setout", desc: "3-4-5 square check, stairs, fall/gradient, area, roof pitch." },
      { href: "/site/triangle", icon: "🔺", title: "Triangle Solver & Trig", desc: "Solve any triangle (SSS/SAS/ASA/AAS/SSA); sin/cos/tan calculator." },
      { href: "/site/convert", icon: "🔁", title: "Unit Converter", desc: "Length, area and volume — metric and imperial." },
      { href: "/site/rate", icon: "💰", title: "Rate Builder", desc: "Build a unit rate from material, labour, plant and margin." },
    ],
  },
  {
    name: "Utilities",
    tools: [
      { href: "/site/sketch", icon: "✏️", title: "Sketchpad", desc: "Quick marks and mark-ups; export a PNG." },
      { href: "/site/voice", icon: "🎙️", title: "Voice Notes", desc: "Speak and it transcribes; record audio; export." },
      { href: "/site/pdf", icon: "📄", title: "PDF Editor", desc: "Merge, reorder, rotate, stamp and number PDF pages." },
    ],
  },
  {
    name: "Reference",
    tools: [
      { href: "/site/periodic", icon: "⚛️", title: "Periodic Table", desc: "Interactive table of the elements — categories, masses, search." },
      { href: "/site/resources", icon: "📋", title: "Resources", desc: "Standards, the NCC, and rules of thumb." },
    ],
  },
];
---

<Base
  title="Site Tools"
  description="Free browser-based tools for trades and estimators. Nothing leaves your device."
  siteNav
>
  <div class="blueprint">
    <p class="eyebrow">Field tools</p>
    <h1>Site Tools</h1>
    <p>
      Free calculators for shopfitting, construction and DIY. Everything runs
      entirely in your browser — no account, no sign-up, nothing uploaded. Print
      to PDF or email a copy to yourself.
    </p>

    <section id="site-recent" class="site-recent" hidden>
      <h2 class="site-group-title">Recently used</h2>
      <ul class="tool-grid" id="site-recent-grid"></ul>
    </section>

    {groups.map((g) => (
      <section>
        <h2 class="site-group-title">{g.name}</h2>
        <ul class="tool-grid">
          {g.tools.map((t) => (
            <li>
              <a class="tool-card" href={t.href} data-tool={t.href}>
                <span class="tool-ico" aria-hidden="true">{t.icon}</span>
                <span class="t">{t.title}</span>
                <span class="d">{t.desc}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="note-foot">
      Nothing you type leaves your browser. <a href="/">← vishvaddi.com</a>
    </p>
  </div>

  <script src="/scripts/site-hub.js" defer></script>
</Base>
