---
import Base from "../../layouts/Base.astro";
import "../../styles/site.css";

const tools = [
  { href: "/site/cut-list", tag: "Optimiser", title: "Cut List Optimizer", desc: "Pack pieces into stock lengths, minimise waste, print a cut plan.", live: true },
  { href: "/site/materials", tag: "Calculator", title: "Material Calculators", desc: "Paint, tiles, plasterboard, concrete and linear quantities.", live: true },
  { href: "/site/geometry", tag: "Setout", title: "Geometry & Setout", desc: "3-4-5 square check, stairs, fall/gradient, area, roof pitch.", live: true },
  { href: "/site/convert", tag: "Convert", title: "Unit Converter", desc: "Length, area and volume — metric and imperial.", live: true },
];
---

<Base
  title="Site"
  description="Free browser-based tools for trades and estimators. Nothing leaves your device."
>
  <div class="blueprint">
    <p class="eyebrow">Site · field tools</p>
    <h1>Site</h1>
    <p>
      Free calculators for shopfitting, construction and DIY. Everything runs
      entirely in your browser — no account, no sign-up, nothing uploaded. Print
      to PDF or email a copy to yourself.
    </p>

    <ul class="tool-grid">
      {tools.map((t) => (
        t.live ? (
          <li>
            <a class="tool-card" href={t.href}>
              <span class="tag">{t.tag}</span>
              <span class="t">{t.title}</span>
              <span class="d">{t.desc}</span>
            </a>
          </li>
        ) : (
          <li>
            <span class="tool-card" aria-disabled="true">
              <span class="tag">Soon</span>
              <span class="t">{t.title}</span>
              <span class="d">{t.desc}</span>
            </span>
          </li>
        )
      ))}
    </ul>

    <p style="margin-top:1.5rem"><a href="/site/roadmap"><strong>Vote on what I build next →</strong></a></p>

    <p class="note-foot">
      Nothing you type leaves your browser. <a href="/">← vishvaddi.com</a>
    </p>
  </div>
</Base>
