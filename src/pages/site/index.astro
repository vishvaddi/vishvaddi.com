---
import Base from "../../layouts/Base.astro";
import "../../styles/site.css";

const groups = [
  {
    name: "Calculators & optimisers",
    tools: [
      { href: "/site/calc", icon: "🧮", title: "Calculator", desc: "Expressions, functions, constants and your own variables. Deg/rad, history." },
      { href: "/site/notepad", icon: "🧾", title: "Calculation Notepad", desc: "Soulver-style takeoff notes: variables, GST, percentages, currency and metric units." },
      { href: "/site/cut-list", icon: "✂️", title: "Cut List Optimizer", desc: "Linear (1D) and sheet (2D) nesting in one tool — minimise waste, print a cut plan." },
      { href: "/site/materials", icon: "🧱", title: "Material Calculators", desc: "Paint, tiles, plasterboard, concrete and linear quantities." },
      { href: "/site/geometry", icon: "📐", title: "Geometry & Setout", desc: "Square check, stairs, fall, area, roof pitch, triangle solver and trig." },
      { href: "/site/convert", icon: "🔁", title: "Unit Converter", desc: "15+ unit types incl. temperature, pressure, data — plus live currency rates." },
      { href: "/site/programme", icon: "📊", title: "Programme Builder", desc: "Generate a construction programme — critical path, FS/SS/FF links, baseline ghosts, Gantt exports. Fitout templates built in." },
      { href: "/site/rate", icon: "💰", title: "Rate Builder", desc: "Build a unit rate from material, labour, plant and margin." },
      { href: "/site/charge-rate", icon: "⏱️", title: "Charge-Out Rate", desc: "What to charge per hour — wage, super, overheads, billable hours and margin." },
      { href: "/site/span", icon: "🪵", title: "Timber Span Lookup", desc: "Indicative joist, ceiling-joist and rafter spans for estimating member counts." },
      { href: "/site/prices", icon: "📈", title: "Materials Price Tracker", desc: "Copper, aluminium, lumber, steel, diesel and AUD/USD trend charts." },
    ],
  },
  {
    name: "Utilities",
    tools: [
      { href: "/site/sketch", icon: "✏️", title: "Sketchpad", desc: "Quick marks and mark-ups; export a PNG." },
      { href: "/site/voice", icon: "🎙️", title: "Voice Notes", desc: "Speak and it transcribes; record audio; export." },
      { href: "/site/pdf", icon: "📄", title: "PDF Editor", desc: "Merge, reorder, rotate, stamp and number PDF pages." },
      { href: "/site/gauges", icon: "📱", title: "Phone Tools", desc: "Spirit level, angle finder and sound meter from your phone's sensors." },
      { href: "/site/records", icon: "🗂️", title: "Site Records", desc: "Variations, punch list, deliveries, contacts and a daily log — CSV export." },
      { href: "/radio", icon: "📻", title: "Radio", desc: "Live radio with station directory and track ID where available." },
    ],
  },
  {
    name: "Reference",
    tools: [
      { href: "/site/quickref", icon: "📐", title: "Quick Reference", desc: "Searchable site rules of thumb — stairs, barriers, heights, falls, courses." },
      { href: "/site/resources", icon: "📋", title: "Resources", desc: "Standards, the NCC, and rules of thumb." },
    ],
  },
];
---

<Base
  title="Site Tools"
  description="Free browser-based tools for trades and estimators. Nothing leaves your device."
  siteNav
>
  <div class="blueprint">
    <p class="eyebrow">Field tools</p>
    <h1>Site Tools</h1>
    <p>
      Free calculators for shopfitting, construction and DIY. Everything runs
      entirely in your browser — no account, no sign-up, nothing uploaded. Print
      to PDF or email a copy to yourself.
    </p>

    <section id="site-recent" class="site-recent" hidden>
      <h2 class="site-group-title">Recently used</h2>
      <ul class="tool-grid" id="site-recent-grid"></ul>
    </section>

    {groups.map((g) => (
      <section>
        <h2 class="site-group-title">{g.name}</h2>
        <ul class="tool-grid">
          {g.tools.map((t) => (
            <li>
              <a class="tool-card" href={t.href} data-tool={t.href}>
                <span class="tool-ico" aria-hidden="true">{t.icon}</span>
                <span class="t">{t.title}</span>
                <span class="d">{t.desc}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="note-foot">
      Nothing you type leaves your browser. <a href="/">← vishvaddi.com</a>
    </p>
  </div>

  <script src="/scripts/site-hub.js" defer></script>
</Base>
