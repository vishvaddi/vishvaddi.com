---
import Base from "../../layouts/Base.astro";
import "../../styles/site.css";
---

<Base
  title="Lattice"
  description="Nested-grid planner — grids inside grids with roll-ups, formulas and links. Local-only."
  siteNav
>
  <div class="blueprint tool lattice">
    <p class="eyebrow"><a href="/site" style="color:inherit;text-decoration:none">Site</a> / Lattice</p>
    <h1>Lattice</h1>
    <p>
      A hierarchical sheet: every cell can hold another grid. Break a job into
      trades, a trade into items, and let costs roll up. <code>=B2*D2</code>
      calculates quantity × rate, <code>[[Sheet]]</code> links between sheets, and pasting a
      spreadsheet range or an indented list keeps its shape. Everything stays in
      this browser.
    </p>

    <p class="lat-help-row">
      <button id="lat-help" class="lat-help-btn" type="button">? Tutorial</button>
    </p>

    <div id="lattice-root" aria-live="polite"></div>

    <p class="note-foot"><a href="/site">← all tools</a></p>
  </div>

  <script>
    import { initLattice } from "../../scripts/site/lattice";
    import { createLatticeTutorial } from "../../scripts/site/lattice-tutorial";
    const root = document.getElementById("lattice-root")!;
    initLattice(root);
    createLatticeTutorial(root, document.getElementById("lat-help")!);
  </script>

  <style>
    .lattice {
      --lat-danger: #b3372f;
    }
    :global([data-theme="dark"]) .lattice {
      --lat-danger: #ff8a7a;
    }
    .lattice :global(.lat-card) { border: 1px solid var(--rule); border-radius: 8px; padding: 1rem 1.1rem; margin: 1rem 0; }
    .lattice :global(.lat-card-title) { font-family: ui-monospace, monospace; font-size: 0.72rem; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 0.35rem; }
    .lattice :global(.lat-blurb) { font-size: 0.85rem; color: var(--muted); margin: 0.2rem 0 0.6rem; }
    .lattice :global(.lat-sheet-row) { display: flex; align-items: center; gap: 0.5rem; border-bottom: 1px solid var(--rule); }
    .lattice :global(.lat-sheet-open) { flex: 1; min-width: 0; text-align: left; background: none; border: none; cursor: pointer; padding: 0.6rem 0; font: inherit; color: var(--fg); }
    .lattice :global(.lat-sheet-name) { font-weight: 600; }
    .lattice :global(.lat-sheet-sub) { font-size: 0.78rem; color: var(--muted); }
    .lattice :global(.lat-del) { background: none; border: none; color: var(--lat-danger); cursor: pointer; font-size: 1rem; min-width: 44px; min-height: 44px; }
    .lattice :global(.lat-tpl-wrap) { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.4rem; }
    .lattice :global(.lat-tpl) { text-align: left; background: var(--code-bg); border: 1px solid var(--rule); border-radius: 8px; padding: 0.5rem 0.75rem; cursor: pointer; font: inherit; color: var(--fg); transition: border-color var(--dur-fast) var(--ease); }
    .lattice :global(.lat-tpl:hover) { border-color: var(--accent); }
    .lattice :global(.lat-tpl-name) { font-size: 0.9rem; font-weight: 600; }
    .lattice :global(.lat-tpl-blurb) { font-size: 0.72rem; color: var(--muted); }
    .lattice :global(.lat-toolbar) { display: flex; align-items: center; gap: 0.4rem; padding: 0.5rem 0 0.4rem; }
    .lattice :global(.lat-tb) { background: var(--code-bg); border: 1px solid var(--rule); border-radius: 6px; color: var(--fg); font: inherit; font-size: 0.85rem; min-width: 40px; min-height: 40px; padding: 0.3rem 0.6rem; cursor: pointer; }
    .lattice :global(.lat-tb:disabled) { opacity: 0.4; cursor: default; }
    .lattice :global(.lat-tb-danger) { color: var(--lat-danger); }
    .lattice :global(.lat-title) { background: none; border: none; border-bottom: 1px dashed transparent; color: var(--fg); font: inherit; font-size: 1rem; font-weight: 600; max-width: 45%; padding: 0.3rem 0.4rem; }
    .lattice :global(.lat-title:focus) { outline: none; border-bottom-color: var(--accent); }
    .lattice :global(.lat-spacer) { flex: 1; }
    .lattice :global(.lat-crumbs) { display: flex; align-items: center; gap: 0.25rem; flex-wrap: wrap; padding: 0 0 0.5rem; }
    .lattice :global(.lat-crumbs button) { background: var(--code-bg); border: 1px solid var(--rule); border-radius: 6px; color: var(--muted); font: inherit; font-size: 0.78rem; padding: 0.25rem 0.6rem; min-height: 32px; cursor: pointer; }
    .lattice :global(.lat-crumb-sep) { color: var(--muted); font-size: 0.78rem; }
    .lattice :global(.lat-wrap) { overflow-x: auto; padding-bottom: 0.25rem; -webkit-overflow-scrolling: touch; }
    .lattice :global(.lat-grid) { display: grid; gap: 3px; background: var(--rule); border: 1px solid var(--rule); border-radius: 6px; padding: 3px; font-size: 93%; }
    .lattice :global(.lat-cell) { position: relative; background: var(--bg); border-radius: 3px; padding: 0.35rem 0.5rem; min-height: 34px; min-width: 0; color: var(--fg); cursor: pointer; display: flex; flex-direction: column; gap: 0.25rem; overflow-wrap: anywhere; }
    .lattice :global(.lat-cell .lat-grid) { cursor: default; }
    .lattice :global(.lat-empty) { background: color-mix(in srgb, var(--bg) 70%, var(--code-bg)); }
    .lattice :global(.lat-selected) { outline: 2px solid var(--accent); outline-offset: -1px; z-index: 1; }
    .lattice :global(.lat-done > .lat-text) { text-decoration: line-through; opacity: 0.5; }
    .lattice :global(.lat-text) { font-size: inherit; line-height: 1.35; white-space: pre-wrap; }
    .lattice :global(.lat-chip) { align-self: flex-start; background: none; border: 1px dashed var(--rule); border-radius: 6px; color: var(--muted); font: inherit; font-size: 0.72rem; padding: 0.15rem 0.5rem; min-height: 28px; cursor: pointer; }
    .lattice :global(.lat-chip:hover) { border-color: var(--accent); color: var(--accent); }
    .lattice :global(.lat-rollup) { position: absolute; top: 2px; right: 4px; font-size: 0.65rem; color: var(--accent); font-variant-numeric: tabular-nums; pointer-events: none; }
    .lattice :global(.lat-formula) { margin-left: 0.3rem; font-size: 0.6rem; color: var(--muted); font-style: italic; }
    .lattice :global(.lat-link) { background: none; border: none; padding: 0; color: var(--accent); font: inherit; text-decoration: underline; text-decoration-style: dotted; cursor: pointer; }
    .lattice :global(.lat-extlink) { color: var(--accent); text-decoration: underline; cursor: pointer; }
    .lattice :global(.lat-extlink)::after { content: " ↗"; font-size: 0.7em; opacity: 0.7; }
    .lattice :global(.lat-code) { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.85em; background: var(--code-bg); border: 1px solid var(--rule); border-radius: 4px; padding: 0 0.25rem; }
    .lattice :global(.lat-check) { background: none; border: none; padding: 0; margin-right: 0.3rem; font-size: 1rem; line-height: 1; color: var(--accent); cursor: pointer; }
    .lattice :global(.lat-backlinks) { margin-top: 0.75rem; padding-top: 0.5rem; border-top: 1px dashed var(--rule); }
    .lattice :global(.lat-backlinks-title) { font-size: 0.7rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.35rem; }
    .lattice :global(.lat-backlink) { display: inline-block; margin: 0 0.35rem 0.35rem 0; padding: 0.15rem 0.5rem; font: inherit; font-size: 0.8rem; background: none; border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); border-radius: 99px; color: var(--accent); cursor: pointer; }
    .lattice :global(.lat-edit) { width: 100%; background: var(--bg); border: 1px solid var(--accent); border-radius: 3px; color: var(--fg); font: inherit; line-height: 1.35; padding: 0.25rem 0.4rem; resize: none; overflow: hidden; }
    .lattice :global(.lat-edit:focus) { outline: none; }
    .lattice :global(.lat-actions) { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0.5rem 0; }
    .lattice :global(.lat-hint) { font-size: 0.75rem; color: var(--muted); padding: 0.25rem 0.1rem; }
    :global(.lat-toast) { position: fixed; bottom: 1.2rem; left: 50%; transform: translateX(-50%); background: var(--fg); color: var(--bg); font-size: 0.85rem; padding: 0.5rem 1rem; border-radius: 8px; z-index: 50; }
    .lattice :global(.lat-linesel) { position: absolute; background: var(--accent); border-radius: 2px; z-index: 2; pointer-events: none; }
    .lattice :global(.lat-multi) { outline: 2px solid color-mix(in srgb, var(--accent) 55%, transparent); outline-offset: -1px; }
    .lattice :global(.lat-b) { font-weight: 700; }
    .lattice :global(.lat-i) { font-style: italic; }
    .lattice :global(.lat-hit) { box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--accent) 70%, transparent); }
    .lattice :global(.lat-tag) { align-self: flex-start; font-size: 0.62rem; color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent); border-radius: 99px; padding: 0 0.4rem; }
    .lattice :global(.lat-search) { background: var(--bg); border: 1px solid var(--rule); border-radius: 6px; color: var(--fg); font: inherit; font-size: 0.8rem; padding: 0.3rem 0.5rem; width: 8rem; }
    .lattice :global(.lat-map-links) { position: absolute; inset: 0; pointer-events: none; }
    .lattice :global(.lat-map-links path) { fill: none; stroke: var(--muted); stroke-width: 1.2; opacity: 0.6; }
    .lattice :global(.lat-map-node) { text-align: left; background: var(--code-bg); border: 1px solid var(--rule); border-radius: 8px; color: var(--fg); font: inherit; font-size: 0.78rem; padding: 0.3rem 0.5rem; cursor: pointer; overflow-wrap: anywhere; }
    .lattice :global(.lat-map-node.lat-selected) { border-color: var(--accent); outline: 1px solid var(--accent); }
    .lattice :global(.lat-done-node) { text-decoration: line-through; opacity: 0.55; }

    .lat-help-row { margin: 0.25rem 0 0; }
    .lat-help-btn { background: var(--code-bg); border: 1px solid var(--rule); border-radius: 6px; color: var(--muted); font: inherit; font-size: 0.8rem; padding: 0.35rem 0.7rem; min-height: 36px; cursor: pointer; }
    .lat-help-btn:hover { border-color: var(--accent); color: var(--accent); }

    /* ── Responsive + touch ──
       The toolbar packs 8 controls into one row and the action bar can render a
       dozen buttons; both wrap rather than squeeze on a phone. Hit targets are
       floored at 44px on coarse pointers — the markdown checkbox grows its tap
       area with a pseudo-element so the text baseline does not shift. */
    .lattice :global(.lat-toolbar) { flex-wrap: wrap; }

    .lattice.lat-app-mode,
    .lattice:fullscreen {
      position: fixed; inset: 0; z-index: 8000; width: 100%; max-width: none;
      height: 100dvh; margin: 0; padding: 0.75rem;
      overflow: auto; background: var(--bg); color: var(--fg);
    }
    .lattice.lat-app-mode > :not(#lattice-root):not(.lat-help-row),
    .lattice:fullscreen > :not(#lattice-root):not(.lat-help-row) { display: none; }
    .lattice.lat-app-mode #lattice-root,
    .lattice:fullscreen #lattice-root { min-height: calc(100dvh - 1.5rem); }
    .lattice.lat-app-mode :global(.lat-toolbar),
    .lattice:fullscreen :global(.lat-toolbar) {
      position: sticky; top: -0.75rem; z-index: 20; margin: -0.75rem -0.75rem 0.5rem;
      padding: 0.65rem 0.75rem; background: color-mix(in srgb, var(--bg) 94%, transparent);
      border-bottom: 1px solid var(--rule); backdrop-filter: blur(12px);
    }
    :global(body.lat-app-open) { overflow: hidden; }

    @media (max-width: 760px) {
      .lattice :global(.lat-spacer) { display: none; }
      .lattice :global(.lat-title) { flex: 1 1 8rem; max-width: none; }
      .lattice :global(.lat-search) { width: auto; flex: 1 1 6rem; min-width: 5rem; }
      .lattice :global(.lat-wrap) { margin-inline: calc(-1 * var(--gutter, 0px)); padding-inline: var(--gutter, 0px); }
      .lattice.lat-app-mode, .lattice:fullscreen { padding: 0.4rem; }
      .lattice.lat-app-mode :global(.lat-toolbar), .lattice:fullscreen :global(.lat-toolbar) { top: -0.4rem; margin: -0.4rem -0.4rem 0.4rem; padding: 0.5rem 0.4rem; }
    }

    @media (pointer: coarse) {
      .lattice :global(.lat-tb) { min-width: 44px; min-height: 44px; }
      .lattice :global(.lat-crumbs button) { min-height: 44px; }
      .lattice :global(.lat-chip) { min-height: 44px; padding: 0.35rem 0.7rem; }
      .lattice :global(.lat-backlink) { min-height: 44px; padding: 0.5rem 0.85rem; }
      .lattice :global(.lat-check) { position: relative; }
      .lattice :global(.lat-check)::after { content: ""; position: absolute; left: 50%; top: 50%; width: 44px; height: 44px; transform: translate(-50%, -50%); }
    }

    /* ── Tutorial overlay ──
       Appended to <body>, so these selectors are top-level :global like .lat-toast. */
    :global(.lat-tut[hidden]) { display: none; }
    :global(.lat-tut) { position: fixed; inset: 0; z-index: 9000; }
    :global(.lat-tut-shade) { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.5); }
    :global(.lat-tut-target) {
      position: relative; z-index: 9001 !important;
      outline: 3px solid var(--accent) !important; outline-offset: 4px;
      border-radius: 6px;
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 25%, transparent), 0 0 24px color-mix(in srgb, var(--accent) 45%, transparent) !important;
    }
    :global(.lat-tut-card) {
      position: absolute; right: 1rem; bottom: 1rem; z-index: 9002;
      width: min(29rem, calc(100vw - 2rem));
      max-height: min(30rem, calc(100vh - 2rem)); overflow-y: auto;
      background: var(--bg); border: 1px solid var(--rule); border-radius: 10px;
      padding: 1rem 1.1rem; box-shadow: 0 14px 44px rgba(0, 0, 0, 0.4);
    }
    :global(.lat-tut-card.lat-tut-browsing) { top: 1rem; max-height: none; }
    :global(.lat-tut-step) { font-family: ui-monospace, monospace; font-size: 0.7rem; letter-spacing: 0.08em; color: var(--accent); }
    :global(.lat-tut-title) { margin: 0.4rem 0 0.5rem; font-size: 1.05rem; }
    :global(.lat-tut-text) { margin: 0 0 0.9rem; font-size: 0.88rem; line-height: 1.55; color: var(--muted); }
    :global(.lat-tut-actions) { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.4rem; }
    :global(.lat-tut-btn) { background: var(--code-bg); border: 1px solid var(--rule); border-radius: 6px; color: var(--fg); font: inherit; font-size: 0.82rem; padding: 0.4rem 0.7rem; min-height: 40px; cursor: pointer; }
    :global(.lat-tut-btn:hover) { border-color: var(--accent); }
    :global(.lat-tut-btn:disabled) { opacity: 0.4; cursor: default; }
    :global(.lat-tut-btn[hidden]) { display: none; }
    :global(.lat-tut-search) { width: 100%; background: var(--bg); border: 1px solid var(--rule); border-radius: 6px; color: var(--fg); font: inherit; font-size: 0.85rem; padding: 0.45rem 0.6rem; margin-bottom: 0.6rem; }
    :global(.lat-tut-sec) { font-family: ui-monospace, monospace; font-size: 0.66rem; letter-spacing: 0.09em; color: var(--accent); margin: 0.9rem 0 0.4rem; }
    :global(.lat-tut-topic) { border-top: 1px solid var(--rule); padding-top: 0.5rem; margin-bottom: 0.5rem; }
    :global(.lat-tut-topic-title) { margin: 0 0 0.25rem; font-size: 0.9rem; }
    :global(.lat-tut-shortcuts) { margin-top: 0.5rem; }
    :global(.lat-tut-sc-row) { display: flex; gap: 0.75rem; padding: 0.22rem 0; font-size: 0.8rem; }
    :global(.lat-tut-key) { flex: 0 0 9.5rem; font-family: ui-monospace, monospace; color: var(--fg); }
    :global(.lat-tut-desc) { color: var(--muted); }

    @media (max-width: 760px) {
      :global(.lat-tut-card) { right: 0.5rem; left: 0.5rem; bottom: 0.5rem; width: auto; max-height: 62vh; }
      :global(.lat-tut-card.lat-tut-browsing) { top: 0.5rem; max-height: none; }
      :global(.lat-tut-key) { flex-basis: 7.5rem; }
    }
  </style>
</Base>
