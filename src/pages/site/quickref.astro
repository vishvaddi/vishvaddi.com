---
import Base from "../../layouts/Base.astro";
import "../../styles/site.css";
---

<Base
  title="Site Quick Reference"
  description="Searchable on-site quick reference for Australian builders — stair and balustrade rules, ceiling heights, waterproofing falls, tiling, brick courses, fixings and more. Indicative figures; verify against the NCC and standards."
  siteNav
>
  <div class="blueprint tool">
    <p class="eyebrow"><a href="/site" style="color:inherit;text-decoration:none">Site</a> / Quick reference</p>
    <h1>Site Quick Reference</h1>
    <p>
      The numbers you google mid-job — stairs, barriers, heights, falls, courses,
      fixings. Type to filter. <strong>Indicative only:</strong> always verify
      against the current NCC, the relevant Australian Standard and your state's
      variations before you build.
    </p>

    <div class="qr-controls">
      <input type="search" id="qr-search" placeholder="Search (e.g. riser, fall, ceiling, balustrade)…" autocomplete="off" />
    </div>
    <div id="qr-list"></div>
    <p class="qr-empty" hidden>No matches — try another term.</p>

    <p class="note-foot">Indicative trade figures, not a compliance document. <a href="/site/resources">Standards &amp; resources →</a></p>
  </div>

  <script>
    import { initQuickRef } from "../../scripts/site/quickref";
    initQuickRef();
  </script>

  <style is:global>
    .qr-controls { margin: 1rem 0; }
    #qr-search {
      width: min(28rem, 100%); padding: 0.55rem 0.75rem; font-size: 1rem;
      font-family: var(--font-sans); color: var(--fg); background: var(--bg);
      border: 1px solid var(--rule); border-radius: 8px;
    }
    .qr-group { margin: 1.5rem 0 0; }
    .qr-group h2 {
      font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--site-accent, #2c63d6); margin: 0 0 0.5rem;
      padding-bottom: 0.3rem; border-bottom: 2px solid var(--site-accent, #2c63d6);
    }
    .qr-item {
      display: grid; grid-template-columns: 1fr auto; gap: 0.2rem 1rem;
      padding: 0.6rem 0; border-bottom: 1px solid var(--rule);
    }
    .qr-item .qr-name { font-weight: 600; }
    .qr-item .qr-val { font-family: var(--font-mono); color: var(--site-accent, #2c63d6); white-space: nowrap; text-align: right; }
    .qr-item .qr-note { grid-column: 1 / -1; font-size: 0.85rem; color: var(--muted); }
    .qr-empty { color: var(--muted); margin-top: 1.5rem; }
  </style>
</Base>
