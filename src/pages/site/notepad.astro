---
import Base from "../../layouts/Base.astro";
import "../../styles/site.css";
---

<Base
  title="Calculation Notepad"
  description="A plain-English calculation notepad for estimators. Type one line per calculation; variables carry down the page."
  siteNav
>
  <div class="blueprint tool">
    <p class="eyebrow"><a href="/site" style="color:inherit;text-decoration:none">Site Tools</a> / Calculation Notepad</p>
    <h1>Calculation Notepad</h1>
    <p>
      Type takeoff-style lines. Use variables, percentages, GST, currency and common metric units.
      Everything runs in this browser.
    </p>

    <div class="notepad-help">
      <strong>Examples</strong>
      <code>sheets = 12</code>
      <code>area = sheets * 2.88 m2</code>
      <code>waste = area * 10%</code>
      <code>total = ($4500 + 10% gst)</code>
    </div>

    <div class="notepad-shell">
      <textarea id="calc-note" spellcheck="false">sheets = 12
sheet area = 2.88 m2
wall area = sheets * sheet area
waste = wall area * 10%
material = $4500
gst total = material * 1.1</textarea>
      <div id="calc-results" class="notepad-results" aria-live="polite"></div>
    </div>

    <div class="btn-row no-print">
      <button type="button" class="btn" id="copy-results">Copy results</button>
      <button type="button" class="btn btn-ghost" id="clear-note">Clear</button>
    </div>

    <p class="disclosure">
      MVP parser: supports arithmetic, brackets, variables, <code>$</code>, <code>%</code>, GST wording, and basic metric area/length units.
    </p>
    <p class="note-foot"><a href="/site">← all tools</a></p>
  </div>

  <script src="/scripts/notepad.js" defer></script>
</Base>
