---
import Base from "../../layouts/Base.astro";
import "../../styles/site.css";
---

<Base
  title="Calculator"
  description="Free SpeedCrunch-style calculator — type expressions with functions, constants and your own variables. History, deg/rad, runs entirely in your browser."
  siteNav
>
  <div class="blueprint tool">
    <p class="eyebrow"><a href="/site" style="color:inherit;text-decoration:none">Site</a> / Calculator</p>
    <h1>Calculator</h1>
    <p>
      Type an expression and press Enter. Use functions, constants and your own
      variables (e.g. <code>r = 3</code> then <code>pi * r^2</code>). <code>ans</code>
      is the last result. ↑/↓ recall previous entries.
    </p>

    <div class="calc-bar">
      <input
        type="text"
        id="calc-input"
        class="calc-input"
        placeholder="e.g.  2 + 2 · sqrt(144) · sin(30) · 5!"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
      />
      <button type="button" id="calc-mode" class="btn btn-ghost" title="Toggle degrees / radians">RAD</button>
      <button type="button" id="calc-clear" class="btn btn-ghost" title="Clear history and variables">Clear</button>
    </div>

    <div id="calc-vars" class="calc-vars" hidden></div>
    <div id="calc-history" class="calc-history" aria-live="polite"></div>

    <details class="calc-ref">
      <summary>Functions &amp; constants</summary>
      <p><strong>Operators:</strong> <code>+ - * / %</code>, power <code>^</code>, factorial <code>!</code>, parentheses.</p>
      <p><strong>Functions:</strong> sin cos tan, asin acos atan, atan2, sinh cosh tanh, ln log log2, sqrt cbrt exp, abs sign round floor ceil, pow hypot min max fact.</p>
      <p><strong>Constants:</strong> pi, e, tau, phi · <strong>Last result:</strong> ans.</p>
      <p><strong>Variables:</strong> assign with <code>name = expression</code>; reuse anywhere.</p>
    </details>

    <p class="note-foot">Nothing you type leaves your browser. <a href="/site">← all tools</a></p>
  </div>

  <style>
    .calc-bar { display: flex; gap: 0.5rem; align-items: stretch; margin: 1rem 0 0.5rem; }
    .calc-input {
      flex: 1; font-family: var(--font-mono); font-size: 1.15rem;
      padding: 0.6rem 0.8rem; border: 1px solid var(--rule); border-radius: 6px;
      background: var(--bg); color: var(--fg); min-width: 0;
    }
    .calc-input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
    .calc-vars { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.5rem 0; }
    .calc-var {
      font-family: var(--font-mono); font-size: 0.8rem; cursor: pointer;
      padding: 0.2rem 0.5rem; border: 1px solid var(--rule); border-radius: 999px;
      background: var(--code-bg); color: var(--fg);
    }
    .calc-history { display: flex; flex-direction: column; gap: 0.25rem; margin-top: 0.5rem; }
    .calc-row {
      display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
      padding: 0.45rem 0.6rem; border-bottom: 1px solid var(--rule);
    }
    .calc-expr {
      font-family: var(--font-mono); font-size: 0.95rem; color: var(--muted);
      background: none; border: none; cursor: pointer; text-align: left; padding: 0;
    }
    .calc-expr:hover { color: var(--fg); }
    .calc-row .calc-out { font-family: var(--font-mono); font-size: 1.05rem; font-weight: 600; white-space: nowrap; }
    .calc-row.err .calc-out { color: var(--accent-dark); font-weight: 400; font-size: 0.85rem; }
    .calc-ref { margin-top: 1.5rem; font-size: 0.85rem; color: var(--muted); }
    .calc-ref summary { cursor: pointer; color: var(--fg); }
    .calc-ref code { font-size: 0.8rem; }
  </style>

  <script>
    import { initCalculator } from "../../scripts/site/calculator";
    initCalculator();
  </script>
</Base>
