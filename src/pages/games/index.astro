---
import Base from "../../layouts/Base.astro";
import { TOOL_ICONS, TOOL_ICON_FALLBACK } from "../../data/tool-icons";

const games = [
  { href: "/games/deep-swarm/", title: "Deep Swarm", desc: "Deep-sea horror survival. Pilot a survey sub into a trench that notices you." },
  { href: "/games/last-cast/", title: "Last Cast", desc: "Alien xeno-survey fishing on a dying skiff. Slow, heavy, weather-driven survival." },
  { href: "/games/carromancy/", title: "Carromancy", desc: "Mystical carrom roguelike. Read the board, bend the flick and outplay rivals across a changing journey." },
  { href: "/games/big2", title: "Big 2", desc: "The classic shedding card game as a roguelike. Outplay the family across a 12-table run." },
];
---

<Base title="Games" description="Four small games. Nothing to install.">
  <h1 class="lede">Games</h1>
  <p>Small games, made slowly. More to come.</p>

  <ul class="game-grid">
    {games.map((g, i) => (
      <li class="reveal" style={`--i: ${i}`}>
        <a class="game-card" href={g.href}>
          <span class="game-ico" aria-hidden="true" set:html={TOOL_ICONS[g.href] ?? TOOL_ICON_FALLBACK} />
          <span class="t">{g.title}</span>
          <span class="d">{g.desc}</span>
        </a>
      </li>
    ))}
  </ul>

  <style>
    .game-grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--gap-2); margin-top: 1.5rem; }
    .game-card { display: flex; flex-direction: column; gap: 0.35rem; padding: 0.9rem 1rem; border: 1px solid var(--rule); border-radius: var(--radius); text-decoration: none; color: var(--fg); transition: border-color .2s var(--ease, ease); }
    .game-card:hover { border-color: var(--accent); }
    .game-card:hover .game-ico { color: var(--accent); }
    .game-ico { display: block; width: 24px; height: 24px; color: var(--muted); transition: color .2s var(--ease, ease); }
    .game-ico svg { display: block; width: 100%; height: 100%; }
    .game-card .t { font-weight: 600; }
    .game-card .d { font-size: 0.88rem; color: var(--muted); }
  </style>
</Base>
