---
import Base from "../layouts/Base.astro";
---

<Base title="Transit" description="Sydney public transport — TfNSW trip planner.">
  <h1>Transit</h1>

  <!-- API key setup panel -->
  <div id="setup-panel" style="display: none; padding: 1rem; background: var(--code-bg); border-radius: 4px; margin-bottom: 1.5rem;">
    <p style="font-family: var(--font-sans); font-size: 0.875rem; margin-top: 0;">
      A TfNSW API key is required. Get one free at
      <a href="https://opendata.transport.nsw.gov.au/" target="_blank" rel="noopener">opendata.transport.nsw.gov.au</a>.
    </p>
    <div style="display: flex; gap: 0.5rem;">
      <input
        id="api-key-input"
        type="text"
        placeholder="Paste API key…"
        style="flex: 1; font-family: var(--font-mono); font-size: 0.8125rem; padding: 0.4rem 0.6rem; background: var(--bg); border: 1px solid var(--rule); color: var(--fg); border-radius: 3px; min-width: 0;"
      />
      <button
        id="api-key-save-btn"
        style="font-family: var(--font-sans); font-size: 0.8125rem; padding: 0.4rem 0.75rem; background: var(--accent); color: #fff; border: none; border-radius: 3px; cursor: pointer; white-space: nowrap;"
      >Save</button>
    </div>
    <p style="font-size: 0.8125rem; color: var(--muted); margin-bottom: 0;">
      Or use <a href="https://mobile.tripview.com.au/" target="_blank" rel="noopener">TripView</a> in the meantime.
    </p>
  </div>

  <!-- Main UI (hidden until key set) -->
  <div id="main-ui" style="display: none;">

    <!-- Favourite stop -->
    <div style="margin-bottom: 1.5rem;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
        <h2 style="margin: 0; font-size: 1rem;">Next departures</h2>
        <button
          id="change-fav-btn"
          style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--muted); background: none; border: none; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; padding: 0;"
        >Change stop</button>
      </div>
      <div id="fav-stop-name" style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--muted); margin-bottom: 0.5rem;"></div>
      <div id="departures-list"></div>
    </div>

    <hr />

    <!-- Trip planner -->
    <h2 style="font-size: 1rem; margin-bottom: 0.75rem;">Trip planner</h2>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 0.75rem;">
      <div>
        <label style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--muted); display: block; margin-bottom: 0.25rem;">From</label>
        <div style="position: relative;">
          <input
            id="origin-input"
            type="text"
            placeholder="Stop or suburb…"
            autocomplete="off"
            style="width: 100%; box-sizing: border-box; font-family: var(--font-sans); font-size: 0.875rem; padding: 0.4rem 0.6rem; background: var(--code-bg); border: 1px solid var(--rule); color: var(--fg); border-radius: 3px;"
          />
          <div id="origin-suggestions" class="suggestions"></div>
        </div>
      </div>
      <div>
        <label style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--muted); display: block; margin-bottom: 0.25rem;">To</label>
        <div style="position: relative;">
          <input
            id="dest-input"
            type="text"
            placeholder="Stop or suburb…"
            autocomplete="off"
            style="width: 100%; box-sizing: border-box; font-family: var(--font-sans); font-size: 0.875rem; padding: 0.4rem 0.6rem; background: var(--code-bg); border: 1px solid var(--rule); color: var(--fg); border-radius: 3px;"
          />
          <div id="dest-suggestions" class="suggestions"></div>
        </div>
      </div>
    </div>

    <button
      id="plan-btn"
      style="font-family: var(--font-sans); font-size: 0.875rem; padding: 0.45rem 1rem; background: var(--accent); color: #fff; border: none; border-radius: 3px; cursor: pointer; margin-bottom: 1rem;"
    >Plan trip</button>

    <div id="journey-results"></div>

    <!-- Stop finder for favouriting -->
    <details id="stop-finder-panel" style="margin-top: 1.5rem;">
      <summary style="cursor: pointer; font-family: var(--font-sans); font-size: 0.875rem; color: var(--muted); user-select: none;">Set favourite stop</summary>
      <div style="margin-top: 0.75rem; position: relative;">
        <input
          id="fav-search-input"
          type="text"
          placeholder="Search for a stop…"
          autocomplete="off"
          style="width: 100%; box-sizing: border-box; font-family: var(--font-sans); font-size: 0.875rem; padding: 0.4rem 0.6rem; background: var(--code-bg); border: 1px solid var(--rule); color: var(--fg); border-radius: 3px;"
        />
        <div id="fav-suggestions" class="suggestions"></div>
      </div>
    </details>

  </div>

  <!-- API key change link (shown when key exists) -->
  <div id="reset-key-wrap" style="display: none; margin-top: 1.5rem;">
    <button
      id="reset-key-btn"
      style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--muted); background: none; border: none; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; padding: 0;"
    >Change API key</button>
  </div>
</Base>

<style>
  .suggestions {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg);
    border: 1px solid var(--rule);
    border-top: none;
    border-radius: 0 0 3px 3px;
    z-index: 20;
    max-height: 200px;
    overflow-y: auto;
    display: none;
  }
  .suggestions.open { display: block; }
  .suggestion-item {
    padding: 0.4rem 0.65rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .suggestion-item:hover { background: var(--code-bg); }

  .journey-card {
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .journey-legs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
  }
  .leg-chip {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.15rem 0.4rem;
    background: var(--code-bg);
    border-radius: 3px;
    white-space: nowrap;
  }
  .journey-meta {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .dep-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }
  .dep-row:first-child { border-top: 1px solid var(--rule); }
  .dep-time {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .dep-status-ontime { color: var(--accent); }
  .dep-status-delayed { color: #ef8b66; }
</style>

<script>
  const BASE = "https://api.transport.nsw.gov.au/v1/tp";

  const MODE_EMOJI = {
    1: "🚆", // train
    2: "🚌", // bus
    3: "⛴️", // ferry
    4: "🚋", // light rail
    5: "🚌", // coach
    7: "🚌", // school bus
    9: "🚆", // intercity
    11: "🚌",
    99: "🚶",
  };

  let apiKey = "";
  let originStop = null;
  let destStop = null;

  function getKey() {
    try { return localStorage.getItem("tfnsw_apikey") || ""; } catch (_) { return ""; }
  }

  function saveKey(k) {
    try { localStorage.setItem("tfnsw_apikey", k); } catch (_) {}
  }

  function getFavStop() {
    try {
      const raw = localStorage.getItem("tfnsw_fav_stop");
      return raw ? JSON.parse(raw) : null;
    } catch (_) { return null; }
  }

  function saveFavStop(stop) {
    try { localStorage.setItem("tfnsw_fav_stop", JSON.stringify(stop)); } catch (_) {}
  }

  function headers() {
    return { Authorization: "apikey " + apiKey };
  }

  function timeFmt(isoStr) {
    if (!isoStr) return "";
    const d = new Date(isoStr);
    return d.toLocaleTimeString("en-AU", { hour: "2-digit", minute: "2-digit", hour12: false });
  }

  async function stopFinder(query) {
    const url = `${BASE}/stop_finder?outputFormat=rapidJSON&type_sf=any&name_sf=${encodeURIComponent(query)}`;
    const res = await fetch(url, { headers: headers() });
    const json = await res.json();
    const locations = json.locations || [];
    return locations.slice(0, 8).map(loc => ({
      id: loc.id,
      name: loc.disassembledName || loc.name,
      type: loc.type,
    }));
  }

  let debounceTimers = {};

  function setupAutocomplete(inputId, suggestionsId, onSelect) {
    const input = document.getElementById(inputId);
    const box = document.getElementById(suggestionsId);

    input.addEventListener("input", () => {
      clearTimeout(debounceTimers[inputId]);
      const q = input.value.trim();
      if (q.length < 2) { box.classList.remove("open"); return; }
      debounceTimers[inputId] = setTimeout(async () => {
        try {
          const results = await stopFinder(q);
          box.innerHTML = results.map((s, i) =>
            `<div class="suggestion-item" data-idx="${i}">${s.name}</div>`
          ).join("");
          box._results = results;
          box.classList.toggle("open", results.length > 0);
        } catch (_) {
          box.classList.remove("open");
        }
      }, 350);
    });

    box.addEventListener("click", e => {
      const item = e.target.closest(".suggestion-item");
      if (!item) return;
      const idx = parseInt(item.dataset.idx, 10);
      const stop = box._results[idx];
      input.value = stop.name;
      box.classList.remove("open");
      onSelect(stop);
    });

    document.addEventListener("click", e => {
      if (!input.contains(e.target) && !box.contains(e.target)) {
        box.classList.remove("open");
      }
    });
  }

  function modeEmoji(modeId) {
    return MODE_EMOJI[modeId] || "🚌";
  }

  async function planTrip() {
    if (!originStop || !destStop) {
      document.getElementById("journey-results").innerHTML =
        '<p style="color: var(--muted); font-size: 0.875rem;">Select both stops first.</p>';
      return;
    }
    const results = document.getElementById("journey-results");
    results.innerHTML = '<p style="color: var(--muted); font-size: 0.875rem;">Planning…</p>';

    const now = new Date();
    const date = now.toISOString().slice(0, 10).replace(/-/g, "");
    const time = now.toTimeString().slice(0, 5).replace(":", "");

    const url = `${BASE}/trip?outputFormat=rapidJSON&type_origin=any&name_origin=${encodeURIComponent(originStop.id)}&type_destination=any&name_destination=${encodeURIComponent(destStop.id)}&itdDate=${date}&itdTime=${time}&calcNumberOfTrips=5`;

    try {
      const res = await fetch(url, { headers: headers() });
      const json = await res.json();
      const journeys = (json.journeys || []).slice(0, 5);

      if (!journeys.length) {
        results.innerHTML = '<p style="color: var(--muted); font-size: 0.875rem;">No journeys found.</p>';
        return;
      }

      results.innerHTML = journeys.map(j => {
        const legs = j.legs || [];
        const depTime = legs[0]?.origin?.departureTimeEstimated || legs[0]?.origin?.departureTimePlanned;
        const arrTime = legs[legs.length - 1]?.destination?.arrivalTimeEstimated || legs[legs.length - 1]?.destination?.arrivalTimePlanned;
        const changes = legs.filter(l => l.transportation?.product?.class !== 99).length - 1;
        const durationMins = Math.round(((new Date(arrTime) - new Date(depTime)) / 60000));

        const legChips = legs
          .filter(l => l.transportation?.product?.class !== 99)
          .map(l => {
            const cls = l.transportation?.product?.class;
            const name = l.transportation?.disassembledName || l.transportation?.name || "";
            return `<span class="leg-chip">${modeEmoji(cls)} ${name}</span>`;
          }).join("");

        return `
          <div class="journey-card">
            <div class="journey-legs">${legChips}</div>
            <div class="journey-meta">
              <span><span style="font-family: var(--font-mono);">${timeFmt(depTime)} → ${timeFmt(arrTime)}</span></span>
              <span>${durationMins} min</span>
              ${changes > 0 ? `<span>${changes} change${changes !== 1 ? "s" : ""}</span>` : ""}
            </div>
          </div>
        `;
      }).join("");
    } catch (err) {
      results.innerHTML = '<p style="color: var(--muted); font-size: 0.875rem;">Failed to fetch journeys. Check your API key.</p>';
    }
  }

  async function loadDepartures(stop) {
    const list = document.getElementById("departures-list");
    const nameEl = document.getElementById("fav-stop-name");
    if (!stop) {
      nameEl.textContent = "No favourite stop set. Use 'Set favourite stop' below.";
      list.innerHTML = "";
      return;
    }
    nameEl.textContent = stop.name;
    list.innerHTML = '<p style="color: var(--muted); font-size: 0.875rem;">Loading…</p>';

    const now = new Date();
    const date = now.toISOString().slice(0, 10).replace(/-/g, "");
    const time = now.toTimeString().slice(0, 5).replace(":", "");

    const url = `${BASE}/departure_mon?outputFormat=rapidJSON&type_dm=any&name_dm=${encodeURIComponent(stop.id)}&itdDate=${date}&itdTime=${time}&mode=direct&noDv=yes`;

    try {
      const res = await fetch(url, { headers: headers() });
      const json = await res.json();
      const deps = (json.stopEvents || []).slice(0, 8);

      if (!deps.length) {
        list.innerHTML = '<p style="color: var(--muted); font-size: 0.875rem;">No departures found.</p>';
        return;
      }

      list.innerHTML = deps.map(dep => {
        const planned = dep.departureTimePlanned;
        const estimated = dep.departureTimeEstimated;
        const delayed = estimated && estimated !== planned;
        const statusClass = delayed ? "dep-status-delayed" : "dep-status-ontime";
        const statusText = delayed ? "Delayed" : "On time";
        const cls = dep.transportation?.product?.class;
        const name = dep.transportation?.disassembledName || dep.transportation?.name || "";
        const dest = dep.transportation?.destination?.name || "";

        return `
          <div class="dep-row">
            <span>${modeEmoji(cls)} <strong style="font-family: var(--font-sans);">${name}</strong> → ${dest}</span>
            <span style="display: flex; gap: 0.75rem; align-items: baseline;">
              <span class="dep-time">${timeFmt(estimated || planned)}</span>
              <span class="${statusClass}" style="font-family: var(--font-sans); font-size: 0.75rem;">${statusText}</span>
            </span>
          </div>
        `;
      }).join("");
    } catch (err) {
      list.innerHTML = '<p style="color: var(--muted); font-size: 0.875rem;">Failed to load departures.</p>';
    }
  }

  function init() {
    apiKey = getKey();

    if (!apiKey) {
      document.getElementById("setup-panel").style.display = "block";
      document.getElementById("main-ui").style.display = "none";
      document.getElementById("reset-key-wrap").style.display = "none";
    } else {
      document.getElementById("setup-panel").style.display = "none";
      document.getElementById("main-ui").style.display = "block";
      document.getElementById("reset-key-wrap").style.display = "block";

      setupAutocomplete("origin-input", "origin-suggestions", stop => { originStop = stop; });
      setupAutocomplete("dest-input", "dest-suggestions", stop => { destStop = stop; });
      setupAutocomplete("fav-search-input", "fav-suggestions", stop => {
        saveFavStop(stop);
        loadDepartures(stop);
        document.getElementById("stop-finder-panel").removeAttribute("open");
      });

      const fav = getFavStop();
      loadDepartures(fav);

      document.getElementById("plan-btn").addEventListener("click", planTrip);

      document.getElementById("change-fav-btn").addEventListener("click", () => {
        document.getElementById("stop-finder-panel").setAttribute("open", "");
        document.getElementById("fav-search-input").focus();
      });
    }
  }

  document.getElementById("api-key-save-btn").addEventListener("click", () => {
    const input = document.getElementById("api-key-input");
    const k = input.value.trim();
    if (!k) return;
    saveKey(k);
    input.value = "";
    init();
  });

  document.getElementById("reset-key-btn").addEventListener("click", () => {
    saveKey("");
    document.getElementById("main-ui").style.display = "none";
    document.getElementById("reset-key-wrap").style.display = "none";
    document.getElementById("setup-panel").style.display = "block";
  });

  init();
</script>
