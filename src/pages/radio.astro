---
import Base from "../layouts/Base.astro";
---

<Base title="Radio" description="Live radio player — Australian stations.">
  <h1>Radio</h1>
  <p class="radio-kicker">LIVE RECEIVER / AU + WORLD / 600+ STATIONS</p>
  <p class="hub-related" aria-label="Related music pages">Also in Music: <a href="/studio">Studio</a> <a href="/audio">Audio tools</a></p>

  <!-- Radio cabinet -->
  <div class="radio-cabinet">
    <div class="radio-brand" aria-hidden="true">
      <span>VISHVADDI</span>
      <span>RX-26</span>
    </div>

    <!-- Top row: speaker grille + LCD -->
    <div class="radio-top">

      <div class="speaker-grille" aria-hidden="true"></div>

      <div class="lcd-display">
        <div class="lcd-station" id="lcd-station">STANDBY</div>
        <div class="lcd-bottom-row">
          <span class="lcd-status" id="lcd-status">STANDBY</span>
          <span class="lcd-signal" id="lcd-signal">▮▮▯▯▯</span>
          <div class="lcd-bars" id="lcd-bars">
            <span class="lbar"></span>
            <span class="lbar"></span>
            <span class="lbar"></span>
            <span class="lbar"></span>
            <span class="lbar"></span>
            <span class="lbar"></span>
            <span class="lbar"></span>
            <span class="lbar"></span>
          </div>
        </div>
      </div>

    </div>

    <!-- Tuner frequency scale -->
    <div class="tuner-scale">
      <div class="tuner-freq-labels" aria-hidden="true">
        <span>88</span>
        <span>94</span>
        <span>100</span>
        <span>106</span>
        <span class="tuner-fm-label">FM</span>
      </div>
      <div class="tuner-track">
        <div class="tuner-ticks" aria-hidden="true">
          <span class="tick"></span><span class="tick"></span><span class="tick tall"></span>
          <span class="tick"></span><span class="tick"></span><span class="tick tall"></span>
          <span class="tick"></span><span class="tick"></span><span class="tick tall"></span>
          <span class="tick"></span><span class="tick"></span><span class="tick tall"></span>
          <span class="tick"></span>
        </div>
        <div class="tuner-needle" id="tuner-needle"></div>
      </div>
    </div>

    <!-- Preset buttons -->
    <div class="presets-row">
      <div id="favourites-list" class="presets-btns"></div>
    </div>

    <!-- Controls row -->
    <div class="controls-row">
      <span class="vol-label">VOL</span>
      <input
        id="volume-slider"
        type="range"
        min="0"
        max="1"
        step="0.02"
        value="0.8"
        class="vol-slider"
        aria-label="Volume"
      />
      <button id="play-pause-btn" class="play-btn" aria-label="Play/pause">&#9654;</button>
      <button id="favourite-btn" class="radio-action-btn" type="button" aria-label="Add current station to favourites" aria-pressed="false">♡</button>
      <button id="random-station-btn" class="radio-action-btn" type="button" aria-label="Play a random station matching the current filters">↝</button>
      <button id="mini-player-btn" class="radio-action-btn" type="button" aria-label="Open persistent mini player">▣</button>
    </div>

    <div class="track-id-row" aria-live="polite">
      <div class="track-id-copy">
        <span class="track-id-label">TRACK ID</span>
        <span class="track-id-title" id="track-id-title">NO TRACK DATA YET</span>
      </div>
      <div class="track-id-actions">
        <button id="track-id-btn" class="track-id-btn" type="button">ID</button>
      </div>
    </div>

    <!-- Tune row -->
    <div class="tune-row">
      <span class="vol-label">TUNE</span>
      <button
        class="station-toggle"
        id="station-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="station-bay"
      >
        <span class="station-toggle-led" aria-hidden="true"></span>
        <span class="station-toggle-copy">
          <span class="station-toggle-label">CHANNEL SELECT</span>
          <span class="station-toggle-name" id="sp-trigger">SELECT STATION</span>
        </span>
        <span class="station-count" id="station-count">18 CH</span>
        <span class="station-toggle-chevron" aria-hidden="true"></span>
      </button>
    </div>

    <section class="station-bay" id="station-bay" aria-label="Station directory" hidden>
      <div class="station-bay-head">
        <label class="station-search-wrap">
          <span class="sr-only">Search stations</span>
          <span class="station-search-icon" aria-hidden="true"></span>
          <input
            class="station-search"
            id="station-search"
            type="search"
            placeholder="FIND STATION OR GENRE"
            autocomplete="off"
          />
        </label>
        <button class="station-close" id="station-close" type="button" aria-label="Close station directory">CLOSE</button>
      </div>
      <div class="station-filters" aria-label="Filter stations">
        <button class="station-filter active" type="button" data-filter="all">ALL</button>
        <button class="station-filter" type="button" data-filter="preset">PRESETS</button>
        <button class="station-filter" type="button" data-filter="favourite">FAVOURITES</button>
        <button class="station-filter" type="button" data-filter="au">AU</button>
        <button class="station-filter" type="button" data-filter="world">WORLD</button>
        <button class="station-filter" type="button" data-filter="music">MUSIC</button>
        <button class="station-filter" type="button" data-filter="talk">TALK</button>
        <button class="station-filter" type="button" data-filter="chill">CHILL</button>
      </div>
      <div class="station-list-head" aria-hidden="true">
        <span>CH</span>
        <span>STATION / BAND</span>
        <span>SIGNAL</span>
      </div>
      <div class="station-list" id="sp-list" role="listbox" aria-label="Stations"></div>
      <div class="station-empty" id="station-empty" hidden>NO CHANNELS FOUND</div>
      <div class="station-directory-status" id="station-directory-status">LOADING AU DIRECTORY...</div>
    </section>

  </div>
  <!-- end cabinet -->

  <audio id="radio-audio" style="display:none"></audio>
  <script src="/scripts/radio.js" defer></script>

</Base>

<style is:global>
  .radio-kicker {
    margin: -0.6rem 0 0.9rem;
    color: var(--muted, #7f8aa3);
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
  }

  /* ── Cabinet shell ── */
  .radio-cabinet {
    position: relative;
    background:
      linear-gradient(160deg, rgba(55,212,255, 0.025), transparent 35%),
      linear-gradient(160deg, #121a2e, #0a0e1a);
    border-radius: 16px;
    max-width: 540px;
    /* retro-cyberpunk: neon halo and faint scanlines over the cabinet */
    box-shadow: 0 0 0 1px #2a3458, 0 8px 40px rgba(0,0,0,0.7), 0 0 48px rgba(55,212,255,0.10), 0 0 90px rgba(255,45,149,0.06), inset 0 1px 0 rgba(55,212,255,0.07);
    background-image: repeating-linear-gradient(0deg, rgba(255,255,255,0.012) 0, rgba(255,255,255,0.012) 1px, transparent 1px, transparent 3px), linear-gradient(160deg, rgba(55,212,255,0.04), transparent 35%), linear-gradient(160deg, #121a2e, #0a0e1a);
    margin: 1.5rem auto;
    box-shadow:
      0 0 0 1px #2a3458,
      0 8px 40px rgba(0,0,0,0.7),
      inset 0 1px 0 rgba(55,212,255, 0.07);
    padding: 18px 20px 16px;
  }

  .radio-brand {
    display: flex;
    justify-content: space-between;
    margin: -2px 1px 9px;
    color: rgba(55,212,255, 0.52);
    font: 600 0.55rem/1 monospace;
    letter-spacing: 0.18em;
  }

  /* ── Top row ── */
  .radio-top {
    display: flex;
    gap: 14px;
    align-items: stretch;
    margin-bottom: 10px;
  }

  /* ── Speaker grille ── */
  .speaker-grille {
    flex-shrink: 0;
    width: 120px;
    min-height: 80px;
    border-radius: 6px;
    border: 1px solid #1f2742;
    background:
      radial-gradient(circle, rgba(55,212,255, 0.55) 1.5px, transparent 1.5px),
      #0a0d18;
    background-size: 12px 12px;
    background-position: 6px 6px;
    box-shadow: inset 0 2px 6px rgba(0,0,0,0.6);
  }

  /* ── LCD display ── */
  .lcd-display {
    flex: 1;
    background: #0a0516;
    border: 1px solid #2a1040;
    border-radius: 6px;
    padding: 10px 14px;
    box-shadow: inset 0 2px 10px rgba(0,0,0,0.8);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 8px;
    min-height: 80px;
  }

  .lcd-station {
    color: #ff2d95;
    text-shadow: 0 0 10px rgba(255,45,149, 0.5);
    font-family: monospace;
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0.04em;
  }

  .lcd-bottom-row {
    display: flex;
    align-items: flex-end;
    gap: 10px;
  }

  .track-id-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin: 8px 0 10px;
    padding: 7px 8px;
    border: 1px solid #1f2742;
    border-radius: 6px;
    background: rgba(10,5,22, 0.72);
    box-shadow: inset 0 1px 5px rgba(0,0,0,0.55);
  }

  .track-id-copy {
    min-width: 0;
  }

  .track-id-label {
    display: block;
    color: rgba(255,45,149, 0.42);
    font: 700 0.55rem/1 monospace;
    letter-spacing: 0.16em;
    margin-bottom: 3px;
  }

  .track-id-title {
    display: block;
    max-width: 330px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #ff2d95;
    text-shadow: 0 0 8px rgba(255,45,149, 0.35);
    font: 700 0.72rem/1.2 monospace;
    letter-spacing: 0.04em;
  }

  .track-id-actions {
    display: flex;
    gap: 5px;
    flex-shrink: 0;
  }

  .track-id-btn {
    border: 1px solid #2a3458;
    border-radius: 4px;
    background: linear-gradient(180deg, #161c33, #0a0e1a);
    color: #1fb6e6;
    cursor: pointer;
    font: 700 0.62rem/1 monospace;
    letter-spacing: 0.09em;
    padding: 0.45rem 0.5rem;
    box-shadow: inset 0 1px 0 rgba(55,212,255, 0.12);
  }

  .track-id-btn:hover {
    border-color: #2ec5f5;
    color: #a6ecff;
  }

  .track-id-btn:disabled {
    opacity: 0.5;
    cursor: wait;
  }

  .lcd-status {
    font-family: monospace;
    font-size: 0.65rem;
    color: rgba(255,45,149, 0.55);
    letter-spacing: 0.08em;
    flex-shrink: 0;
  }

  .lcd-signal {
    font-family: monospace;
    font-size: 0.6rem;
    color: rgba(255,45,149, 0.4);
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  /* ── LCD EQ bars ── */
  .lcd-bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 18px;
    margin-left: auto;
  }

  .lbar {
    display: block;
    width: 3px;
    border-radius: 1px;
    background: #ff2d95;
    box-shadow: 0 0 3px rgba(255,45,149, 0.4);
    height: 3px;
    transition: height 0.1s ease-out;
  }

  /* ── Tuner scale ── */
  .tuner-scale {
    margin-bottom: 10px;
  }

  .tuner-freq-labels {
    display: flex;
    justify-content: space-between;
    padding: 0 4px;
    margin-bottom: 2px;
  }

  .tuner-freq-labels span {
    font-family: monospace;
    font-size: 0.6rem;
    color: rgba(55,212,255, 0.4);
    letter-spacing: 0.03em;
  }

  .tuner-fm-label {
    color: rgba(55,212,255, 0.55) !important;
  }

  .tuner-track {
    position: relative;
    background: #070a12;
    border-radius: 4px;
    height: 22px;
    border: 1px solid #1f2742;
    overflow: hidden;
  }

  .tuner-ticks {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-around;
    padding: 0 8px;
  }

  .tick {
    display: block;
    width: 1px;
    height: 5px;
    background: rgba(55,212,255, 0.25);
    margin-bottom: 2px;
  }

  .tick.tall {
    height: 9px;
    background: rgba(55,212,255, 0.4);
  }

  .tuner-needle {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, #37d4ff, #1fb6e6);
    box-shadow: 0 0 6px rgba(55,212,255, 0.8);
    border-radius: 1px;
    left: 50%;
    transform: translateX(-50%);
    transition: left 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* ── Preset buttons ── */
  .presets-row {
    margin-bottom: 10px;
  }

  .presets-btns {
    display: flex;
    gap: 6px;
  }

  .preset-btn {
    flex: 1;
    min-width: 0;
    padding: 8px 6px;
    border: 1px solid #243050;
    border-radius: 8px;
    background: linear-gradient(to bottom, #161c33, #0d1222);
    color: rgba(55,212,255, 0.65);
    font: 0.7rem/1.3 monospace;
    text-align: center;
    cursor: pointer;
    transition: color 0.15s, box-shadow 0.15s, border-color 0.15s, transform 0.15s;
  }

  .preset-btn:hover,
  .preset-btn:focus-visible {
    color: #37d4ff;
    border-color: #3a4a7a;
    outline: none;
  }

  .preset-btn:active { transform: translateY(1px); }
  .preset-btn.active {
    color: #37d4ff;
    border-color: #3a4a7a;
    box-shadow: 0 0 10px rgba(55,212,255, 0.25);
  }

  /* ── Controls row ── */
  .controls-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .vol-label {
    font-family: monospace;
    font-size: 0.6rem;
    color: rgba(55,212,255, 0.5);
    letter-spacing: 0.1em;
    flex-shrink: 0;
  }

  .vol-slider {
    flex: 1;
    accent-color: #1fb6e6;
    cursor: pointer;
  }

  .play-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: none;
    border: 1.5px solid rgba(55,212,255, 0.55);
    color: rgba(55,212,255, 0.8);
    font-size: 0.85rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: border-color 0.15s, color 0.15s, box-shadow 0.15s;
  }

  .play-btn:hover {
    border-color: #37d4ff;
    color: #37d4ff;
    box-shadow: 0 0 8px rgba(55,212,255, 0.3);
  }

  .radio-action-btn {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    border: 1px solid #2a3458;
    border-radius: 7px;
    background: linear-gradient(180deg, #161c33, #0a0e1a);
    color: rgba(55,212,255, 0.78);
    cursor: pointer;
    font: 700 1rem/1 monospace;
  }
  .radio-action-btn:hover,
  .radio-action-btn:focus-visible,
  .radio-action-btn[aria-pressed="true"] {
    border-color: #2ec5f5;
    color: #a6ecff;
    outline: none;
    box-shadow: 0 0 8px rgba(55,212,255, 0.2);
  }

  /* ── Tune row ── */
  .tune-row {
    margin-top: 10px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 10px;
  }

  .station-toggle {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 9px;
    width: 100%;
    min-width: 0;
    padding: 7px 9px;
    border: 1px solid #243050;
    border-radius: 5px;
    background:
      linear-gradient(180deg, rgba(55,212,255, 0.035), transparent),
      #0a0d18;
    box-shadow: inset 0 1px 4px rgba(0,0,0,0.7);
    color: rgba(55,212,255, 0.85);
    cursor: pointer;
    text-align: left;
  }

  .station-toggle:hover,
  .station-toggle:focus-visible,
  .station-toggle[aria-expanded="true"] {
    border-color: #3a4a7a;
    outline: none;
  }

  .station-toggle-led {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2f3f6e;
    box-shadow: inset 0 0 2px rgba(0,0,0,0.8);
  }

  .station-toggle.has-station .station-toggle-led {
    background: #37d4ff;
    box-shadow: 0 0 7px rgba(55,212,255, 0.7);
  }

  .station-toggle-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 1px;
  }

  .station-toggle-label {
    color: rgba(55,212,255, 0.44);
    font: 0.5rem/1 monospace;
    letter-spacing: 0.12em;
  }

  .station-toggle-name {
    min-width: 0;
    color: #37d4ff;
    font: 0.72rem/1.25 monospace;
    letter-spacing: 0.03em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .station-count {
    color: rgba(55,212,255, 0.58);
    font: 0.58rem/1 monospace;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .station-toggle-chevron {
    width: 7px;
    height: 7px;
    border-right: 1px solid rgba(55,212,255, 0.65);
    border-bottom: 1px solid rgba(55,212,255, 0.65);
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.18s;
  }

  .station-toggle[aria-expanded="true"] .station-toggle-chevron {
    transform: rotate(225deg) translate(-2px, -2px);
  }

  .station-bay {
    margin-top: 9px;
    overflow: hidden;
    border: 1px solid #243050;
    border-radius: 7px;
    background:
      repeating-linear-gradient(0deg, rgba(55,212,255, 0.012) 0, rgba(55,212,255, 0.012) 1px, transparent 1px, transparent 3px),
      #070a12;
    box-shadow: inset 0 2px 8px rgba(0,0,0,0.72);
  }

  .station-bay[hidden] { display: none; }

  .station-bay-head {
    display: flex;
    gap: 7px;
    padding: 8px;
    border-bottom: 1px solid rgba(42,52,88, 0.65);
  }

  .station-search-wrap {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .station-search-icon {
    position: absolute;
    top: 50%;
    left: 9px;
    width: 8px;
    height: 8px;
    border: 1px solid rgba(55,212,255, 0.55);
    border-radius: 50%;
    transform: translateY(-60%);
    pointer-events: none;
  }

  .station-search-icon::after {
    content: "";
    position: absolute;
    right: -4px;
    bottom: -3px;
    width: 5px;
    border-top: 1px solid rgba(55,212,255, 0.55);
    transform: rotate(45deg);
    transform-origin: left;
  }

  .station-search {
    width: 100%;
    border: 1px solid #1f2742;
    border-radius: 4px;
    background: #05070e;
    color: #37d4ff;
    padding: 7px 8px 7px 26px;
    font: 0.65rem/1 monospace;
    letter-spacing: 0.05em;
  }

  .station-search::placeholder { color: rgba(55,212,255, 0.35); }
  .station-search:focus {
    border-color: #3a4a7a;
    outline: none;
    box-shadow: 0 0 0 1px rgba(55,212,255, 0.08);
  }

  .station-close {
    border: 1px solid #1f2742;
    border-radius: 4px;
    background: #0d1222;
    color: rgba(55,212,255, 0.56);
    padding: 0 9px;
    font: 0.55rem/1 monospace;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .station-close:hover,
  .station-close:focus-visible {
    color: #37d4ff;
    border-color: #3a4a7a;
    outline: none;
  }

  .station-filters {
    display: flex;
    gap: 4px;
    padding: 7px 8px;
    overflow-x: auto;
    border-bottom: 1px solid rgba(42,52,88, 0.5);
    scrollbar-width: thin;
  }

  .station-filter {
    flex: 0 0 auto;
    border: 1px solid #1f2742;
    border-radius: 999px;
    background: transparent;
    color: rgba(55,212,255, 0.46);
    padding: 4px 8px 3px;
    font: 0.52rem/1 monospace;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .station-filter:hover,
  .station-filter:focus-visible,
  .station-filter.active {
    border-color: #3a4a7a;
    color: #37d4ff;
    outline: none;
  }

  .station-filter.active { background: rgba(55,212,255, 0.07); }

  .station-list-head,
  .station-row {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) 54px;
    gap: 8px;
    align-items: center;
  }

  .station-list-head {
    padding: 6px 9px 5px;
    color: rgba(55,212,255, 0.32);
    font: 0.48rem/1 monospace;
    letter-spacing: 0.1em;
  }

  .station-list-head span:last-child { text-align: right; }

  .station-list {
    max-height: 270px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-color: #2a3458 #070a12;
    scrollbar-width: thin;
  }

  .station-row {
    width: 100%;
    min-width: 0;
    padding: 7px 9px;
    border: 0;
    border-top: 1px solid rgba(42,52,88, 0.35);
    background: transparent;
    color: rgba(55,212,255, 0.72);
    text-align: left;
    cursor: pointer;
  }

  .station-row:hover,
  .station-row:focus-visible {
    background: rgba(55,212,255, 0.055);
    color: #37d4ff;
    outline: none;
  }

  .station-row.active {
    background: linear-gradient(90deg, rgba(55,212,255, 0.11), rgba(55,212,255, 0.02));
    color: #37d4ff;
  }

  .station-channel {
