---
import Base from "../layouts/Base.astro";
---

<Base
  title="Studio"
  description="VishAmp Studio — a browser drum machine, synth and mixer in a classic late-'90s skin. Web Audio; nothing is recorded or uploaded."
>
  <h1>Studio</h1>
  <p>
    A Web-Audio workstation — a step-sequencer drum machine, a subtractive synth
    (play the on-screen keys or your <strong>A–K</strong> row), and a mixer,
    dressed in the skin of a certain late-'90s media player. Nothing is recorded
    or uploaded; it all runs in your browser.
  </p>

  <div class="wa-wrap"><div id="studio"></div></div>

  <p style="font-size:0.85rem;color:var(--muted)">
    Hit <strong>▶</strong> to run the pattern, click the grid to program beats,
    and switch tabs for <strong>Synth</strong>, <strong>Mixer</strong> and
    <strong>Export</strong>. <strong>⤢ Flip</strong> goes fullscreen (or rotates
    to landscape on a phone). Audio starts on your first click (browser policy).
  </p>

  <script>
    import { initStudio } from "../scripts/site/studio";
    initStudio();
  </script>
</Base>
