---
import Base from "../layouts/Base.astro";
---

<Base
  title="Studio"
  description="VishAmp Studio — a browser drum machine, synth and mixer in a classic late-'90s skin. Web Audio; nothing is recorded or uploaded."
>
  <h1>Studio</h1>
  <p>
    An MPC-style Web-Audio workstation for hip hop and jungle: perform on 16
    pads, record or chop breaks, sequence variations, build songs and resample
    through a modular device rack. Nothing is uploaded.
  </p>

  <div class="wa-wrap"><div id="studio"></div></div>

  <p style="font-size:0.85rem;color:var(--muted)">
    Work left to right through <strong>Create</strong>,
    <strong>Sequence</strong>, <strong>Arrange</strong> and <strong>Mix</strong>.
    The selected-pad controls and transport stay available while you move.
    <strong>⤢ Flip</strong> goes fullscreen. Audio starts on your first click.
  </p>

  <script>
    import { initStudio } from "../scripts/site/studio";
    initStudio();
  </script>
</Base>
