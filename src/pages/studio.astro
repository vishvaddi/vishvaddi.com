---
import Base from "../layouts/Base.astro";
// pro.ts inserts the Pro upsell panel via requirePro() when exporting
// MP3/stems; its styles live in site.css (shared with every other gated
// tool) rather than duplicated into studio.css.
import "../styles/site.css";
---

<Base
  title="Studio"
  description="VishAmp Studio — an audio-reactive browser drum machine, synth, clip arranger and mixer. Web Audio; nothing is recorded or uploaded."
  immersive={true}
>
  <div class="wa-wrap"><div id="studio" aria-label="VishAmp browser music workstation"></div></div>

  <script>
    import { initStudio } from "../scripts/site/studio";
    initStudio();
  </script>
</Base>
