---
import Base from "../layouts/Base.astro";
import { shopCollections } from "../data/shop";

const affiliateTag = import.meta.env.PUBLIC_AMAZON_ASSOCIATE_TAG || "";
const amazon = (query: string) => {
  const url = new URL("https://www.amazon.com.au/s");
  url.searchParams.set("k", query);
  if (affiliateTag) url.searchParams.set("tag", affiliateTag);
  return url.toString();
};
---

<Base
  title="Shop"
  description="Curated gear lists for preparedness, field tools and home resilience."
>
  <p class="eyebrow"><a href="/prepping">Prepping</a> / Shop</p>
  <h1>Shop</h1>
  <p>
    Curated search links for gear worth comparing. This works best as a field-notes
    list: every item needs a reason, and anything untested should stay clearly marked.
  </p>

  <nav class="bag-jump" aria-label="Shop categories">
    {shopCollections.map((group) => <a href={`#${group.id}`}>{group.title}</a>)}
  </nav>

  {shopCollections.map((group) => (
    <section class="shop-group reveal" id={group.id}>
      <h2>{group.title}</h2>
      <p class="shop-intro">{group.intro}</p>
      <ul class="gear-list">
        {group.items.map((item) => (
          <li>
            <a href={amazon(item.query)} target="_blank" rel="sponsored nofollow noopener">
              {item.name} ↗
            </a>
            <span class="gear-why">{item.why}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <p class="gear-disclosure">
    Links open Amazon AU searches so you can compare current sellers and prices.
    {affiliateTag
      ? " As an Amazon Associate I earn from qualifying purchases, at no cost to you."
      : " These are plain links at present; no affiliate tracking is active."}
  </p>

  <style>
    .bag-jump { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.25rem 0; }
    .bag-jump a { font-size: 0.85rem; padding: 0.3rem 0.7rem; border: 1px solid var(--rule); border-radius: 999px; text-decoration: none; color: var(--fg); }
    .bag-jump a:hover { border-color: var(--accent); }
    .shop-group { margin-top: 2.25rem; scroll-margin-top: 1rem; }
    .shop-intro { color: var(--muted); font-size: 0.95rem; margin-top: 0.25rem; }
    .gear-list { list-style: none; padding: 0; margin: 0.75rem 0 0; }
    .gear-list li { padding: 0.6rem 0; border-bottom: 1px solid var(--rule); }
    .gear-list a { font-weight: 600; }
    .gear-why { display: block; color: var(--muted); font-size: 0.92rem; margin-top: 0.15rem; }
    .gear-disclosure { margin-top: 2.5rem; font-size: 0.82rem; color: var(--muted); font-style: italic; }
  </style>
</Base>
