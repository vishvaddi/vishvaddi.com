---
import Base from "../layouts/Base.astro";
import "../styles/site.css";
---

<Base
  title="Pro"
  description="vishvaddi.com Pro — every tool stays free and unlimited; Pro unlocks exports, saved projects, cross-device sync and MP3/stem export."
>
  <div class="blueprint tool">
    <p class="eyebrow">Pro</p>
    <h1>Pro</h1>
    <p>
      Every tool and feature on this site is free, with no limits on use. Pro is an optional
      add-on for people who want more than the browser tab: exports, saved
      projects, cross-device sync and Studio's MP3/stem export.
    </p>

    <h2>Free</h2>
    <p>
      Every calculator, optimiser, tracker, dashboard and editor here — every
      feature, unlimited use, no account, no watermark, nothing that expires or
      throttles. Files never leave your browser unless a page says otherwise.
      Exports are capped at <span id="free-limit-copy">1 export</span> every 30
      days; Pro removes that limit.
    </p>

    <h2>Pro adds</h2>
    <ul>
      <li>PDF, CSV, project and image exports on the tools that support them</li>
      <li>Saved projects you can reopen and re-export later</li>
      <li>Cross-device sync for tools with a "Sync across devices" toggle</li>
      <li>MP3 and stem export in Studio — WAV master export stays free for everyone</li>
    </ul>

    <div id="pro-plans"></div>

    <h2>Updates</h2>
    <p>One email when something new lands — no other list, no spam.</p>
    <form id="waitlist-form" class="waitlist-form" novalidate>
      <label for="waitlist-email" class="sr-only">Email address</label>
      <input type="email" id="waitlist-email" name="email" placeholder="you@example.com" maxlength="254" required autocomplete="email" />
      <button type="submit" class="btn">Keep me posted</button>
      <p id="waitlist-status" class="waitlist-status" role="status" aria-live="polite" hidden></p>
    </form>

    <h2>Questions</h2>
    <p><strong>Cancel any time.</strong> Manage or cancel from Stripe's customer portal link, sent with your receipt once you've subscribed.</p>
    <p><strong>Refunds.</strong> Within 14 days of your first payment, email <a href="mailto:vishvaddi@gmail.com">vishvaddi@gmail.com</a> for a full refund, no questions asked.</p>
    <p><strong>Your data.</strong> Everything you make with these tools stays in your browser unless you turn sync on for a specific tool — Pro doesn't change that.</p>

    <p class="note-foot">See <a href="/terms">terms</a> and <a href="/privacy">privacy</a> for the rest. <a href="/site">← all tools</a></p>
  </div>

  <script>
    import { mountPro, proState, onProChanged, freeLimitLabel, track, type ProStatus } from "../scripts/site/pro";
    mountPro(document.getElementById("pro-plans")!);

    // Free section copy derives from the configured quota (Addendum 3,
    // docs/PRO_PLAN.md) instead of hardcoding it — freeLimit only arrives once
    // /api/pro/status has answered, so this updates in place when it does.
    const freeLimitEl = document.getElementById("free-limit-copy");
    const updateFreeLimitCopy = (status: ProStatus) => {
      if (freeLimitEl && typeof status.freeLimit === "number") freeLimitEl.textContent = freeLimitLabel(status.freeLimit);
    };
    updateFreeLimitCopy(proState());
    onProChanged(updateFreeLimitCopy);

    const waitlistForm = document.getElementById("waitlist-form") as HTMLFormElement;
    const waitlistEmail = document.getElementById("waitlist-email") as HTMLInputElement;
    const waitlistStatus = document.getElementById("waitlist-status") as HTMLParagraphElement;
    waitlistForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const email = waitlistEmail.value.trim();
      const say = (text: string) => { waitlistStatus.textContent = text; waitlistStatus.hidden = false; };
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || email.length > 254) {
        say("That doesn't look like a valid email address.");
        return;
      }
      const submitBtn = waitlistForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      submitBtn.disabled = true;
      try {
        const res = await fetch("/api/waitlist", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, source: "updates" }),
        });
        if (res.ok) {
          say("Done — you'll hear from me when something new lands.");
          track("waitlist_signup");
          waitlistForm.reset();
        } else if (res.status === 429) {
          say("Too many requests from this connection today — try again tomorrow.");
        } else {
          say("That didn't work — check the address and try again.");
        }
      } catch {
        say("Couldn't reach the server — check your connection and try again.");
      } finally {
        submitBtn.disabled = false;
      }
    });
  </script>
</Base>
