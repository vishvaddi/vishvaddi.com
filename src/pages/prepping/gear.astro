---
import Base from "../../layouts/Base.astro";
import "../../styles/prepping.css";

type Item = { name: string; why: string };
type Bag = { id: string; title: string; blurb: string; items: Item[] };

const bags: Bag[] = [
  {
    id: "ghb",
    title: "Get Home Bag (GHB)",
    blurb: "Small, light, lives in your car or at work. One job: get you home on foot if transport and phones go down. Think one day, urban.",
    items: [
      { name: "Comfortable walking shoes + spare socks", why: "You can't walk 20 km home in dress shoes. The single most-skipped item." },
      { name: "1 L water + compact filter", why: "Refill from any tap or creek on the way." },
      { name: "Energy bars / nuts", why: "Keep moving without stopping to find food." },
      { name: "Power bank + charging cable", why: "Phone is your map and comms — keep it alive." },
      { name: "Compact first-aid kit + personal meds", why: "Blisters and minor injuries on a long walk." },
      { name: "Headtorch", why: "If the walk runs into the night." },
      { name: "Multi-tool + small cash", why: "Fix problems; pay when EFTPOS is down." },
      { name: "N95 mask + light rain shell", why: "Smoke, dust, weather on the route." },
      { name: "Paper map of your city / route home", why: "No battery, no signal needed." },
    ],
  },
  {
    id: "bob",
    title: "Bug Out Bag (BOB)",
    blurb: "72-hour evacuation kit — grab it and go when you have to leave home (fire, flood). Organised by the survival “Cs”. Tuned for Australian conditions.",
    items: [
      { name: "Fixed-blade knife (full tang)", why: "The one tool you can't improvise. Cutting, batoning, food." },
      { name: "Ferro rod + stormproof lighter", why: "Two ignition methods; ferro works wet." },
      { name: "Tarp (3×3 m) + emergency bivvy", why: "Shelter and warmth, lighter than a tent." },
      { name: "Steel water bottle + squeeze filter + tablets", why: "Carry, boil, filter, chemically treat — redundancy." },
      { name: "35–45 L pack", why: "72 hrs of kit, still light enough to move fast." },
      { name: "Paracord (550, 30 m) + gorilla tape", why: "Shelter, repairs, a hundred uses." },
      { name: "First-aid kit + snake bandages", why: "AU essential — pressure-immobilisation for snake bite." },
      { name: "Headtorch + spare batteries", why: "Hands-free light after dark." },
      { name: "Compass + paper map", why: "Navigate without signal or battery." },
      { name: "3 days food + merino layer + rain shell", why: "Calories and core temperature." },
      { name: "PLB (personal locator beacon)", why: "Gets rescue to you when you're remote." },
    ],
  },
  {
    id: "inch",
    title: "INCH Bag (I'm Never Coming Home)",
    blurb: "The worst-case load: you're not returning. Long-term, self-sufficient living out of one pack. Heavier and bigger — capability over weight.",
    items: [
      { name: "65 L+ pack with frame", why: "Carries weeks of kit and the means to make more." },
      { name: "Full bushcraft knife + hatchet + folding saw", why: "Process wood for shelter, fire and tools indefinitely." },
      { name: "Tent or hammock + season-rated sleeping bag", why: "Durable shelter for the long haul, not just a night." },
      { name: "Stove + pot + extra fuel / cook kit", why: "Cook and purify daily without burning yourself out." },
      { name: "High-capacity gravity filter + tablets", why: "Water for weeks, not days." },
      { name: "Fishing kit + snare wire + repair kit", why: "Procure food once your supplies run out." },
      { name: "Heirloom seed pack + foraging guide", why: "Grow food where you settle — the long game." },
      { name: "Extended first aid + antibiotics + sutures", why: "No hospital is coming. Austere medicine." },
      { name: "Foldable solar panel + power bank + AA/AAA rechargeables", why: "Keep light, comms and navigation running off-grid." },
      { name: "Radio (UHF/AM) + compass + maps + PLB", why: "Information and rescue without the grid." },
      { name: "Documents (encrypted USB + hard copies) + cash", why: "Identity, records and barter when systems are down." },
      { name: "Spare boots + clothing + sewing kit", why: "Clothing wears out; you have to maintain it." },
    ],
  },
];

const loadouts = [
  { id: "blackout", title: "Blackout · 24 hours", items: ["Headtorch + spare batteries", "Power banks charged", "Battery radio", "Drinking water", "No-cook food", "Manual can opener", "Cash", "Medication"] },
  { id: "evacuate", title: "Evacuate · 15 minutes", items: ["Go bag", "Phones + chargers", "Wallet, keys and documents", "Medication", "Water", "Protective clothing", "Pet carriers and supplies", "Bushfire or flood route checked"] },
  { id: "vehicle", title: "Vehicle breakdown", items: ["Water", "First-aid kit", "Hi-vis vest", "Torch", "Warning triangle", "Tyre inflator + gauge", "Jump starter", "Paper map", "Sun and rain protection"] },
  { id: "daywalk", title: "Remote day walk", items: ["PLB", "Offline map + compass", "2 L water + treatment", "Food + reserve snack", "First-aid and snake bandages", "Headtorch", "Warm and waterproof layers", "Sun protection", "Emergency shelter"] },
  { id: "home72", title: "Shelter at home · 72 hours", items: ["9 L water per person minimum", "Three days shelf-stable food", "First-aid and medication", "Lighting", "Radio", "Charged power banks", "Hygiene supplies", "Cash", "Written contacts"] },
];
---

<Base
  title="Go Bags"
  description="Three tiers of survival bag — Get Home, Bug Out, and INCH — each with a curated kit list and the reasoning behind every pick. Australian context."
>
  <nav class="prep-modes" aria-label="Prepping sections">
    <a href="/prepping">Guide</a>
    <a href="/prepping/gear" class="active">Gear</a>
    <a href="/prepping/health">Health</a>
    <a href="/prepping/tools">Field tools</a>
    <a href="/prepping/pack">Pack list</a>
    <a href="/prepping/science">Science</a>
    <a href="/prepping/fitness">Fitness</a>
    <a href="/prepping/planting">Planting</a>
    <a href="/prepping/howto">How-to</a>
    <a href="/prepping/knots">Knots</a>
  </nav>

  <article>
    <p class="eyebrow"><a href="/prepping">Prepping</a> / Go bags</p>
    <h1>Go bags</h1>
    <p>
      Three bags for three situations, smallest to largest: a <strong>Get Home</strong>
      bag for the daily what-if, a <strong>Bug Out</strong> bag for a 72-hour
      evacuation, and an <strong>INCH</strong> bag for not coming back. Buy once,
      buy right. Tuned for Australian conditions.
    </p>

    <nav class="bag-jump">
      {bags.map((b) => <a href={`#${b.id}`}>{b.title}</a>)}
    </nav>

    <section class="reveal loadout-builder" aria-labelledby="loadout-title">
      <p class="eyebrow">Task loadouts</p>
      <h2 id="loadout-title">Pack for the failure, not the fantasy</h2>
      <p>Select a scenario, then mark what is actually ready. Progress is stored only in this browser.</p>
      <label class="loadout-select">Scenario
        <select id="loadout-select">
          {loadouts.map((loadout) => <option value={loadout.id}>{loadout.title}</option>)}
        </select>
      </label>
      <p class="loadout-progress" id="loadout-progress" aria-live="polite"></p>
      <div id="loadout-lists">
        {loadouts.map((loadout) => (
          <fieldset class="loadout-list" data-loadout={loadout.id} hidden={loadout.id !== loadouts[0].id}>
            <legend>{loadout.title}</legend>
            {loadout.items.map((item, index) => (
              <label><input type="checkbox" data-item={`${loadout.id}:${index}`} /> <span>{item}</span></label>
            ))}
          </fieldset>
        ))}
      </div>
      <button class="loadout-reset" id="loadout-reset" type="button">Clear this scenario</button>
    </section>

    {bags.map((b) => (
      <section class="reveal bag-group" id={b.id}>
        <h2>{b.title}</h2>
        <p class="bag-blurb">{b.blurb}</p>
        <ul class="gear-list">
          {b.items.map((it) => (
            <li>
              <strong>{it.name}</strong>
              <span class="gear-why">{it.why}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}

  </article>

  <style>
    .bag-jump { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.25rem 0; }
    .bag-jump a { font-size: 0.85rem; padding: 0.3rem 0.7rem; border: 1px solid var(--rule); border-radius: 999px; text-decoration: none; color: var(--fg); }
    .bag-jump a:hover { border-color: var(--accent); }
    .bag-group { margin-top: 2.25rem; scroll-margin-top: 1rem; }
    .bag-blurb { color: var(--muted); font-size: 0.95rem; margin-top: 0.25rem; }
    .gear-list { list-style: none; padding: 0; margin: 0.75rem 0 0; }
    .gear-list li { padding: 0.6rem 0; border-bottom: 1px solid var(--rule); }
    .gear-why { display: block; color: var(--muted); font-size: 0.92rem; margin-top: 0.15rem; }
    .loadout-builder { margin: 2rem 0 2.5rem; padding: 1rem; border: 1px solid var(--rule); border-radius: 10px; }
    .loadout-builder h2 { margin-top: 0; }
    .loadout-select { display: grid; gap: 0.3rem; max-width: 28rem; font-weight: 600; }
    .loadout-select select { min-height: 44px; padding: 0.55rem; border: 1px solid var(--rule); border-radius: 6px; background: var(--bg); color: var(--fg); }
    .loadout-progress { font-family: var(--font-mono); font-size: 0.85rem; color: var(--muted); }
    .loadout-list { display: grid; gap: 0.4rem; margin: 0 0 0.8rem; padding: 0.8rem; border: 1px solid var(--rule); border-radius: 7px; }
    .loadout-list[hidden] { display: none; }
    .loadout-list label { display: flex; gap: 0.6rem; align-items: center; min-height: 40px; }
    .loadout-list input { width: 20px; height: 20px; }
    .loadout-list input:checked + span { color: var(--muted); text-decoration: line-through; }
    .loadout-reset { min-height: 40px; padding: 0.45rem 0.7rem; border: 1px solid var(--rule); border-radius: 6px; background: transparent; color: var(--fg); cursor: pointer; }
  </style>

  <script>
    const select = document.getElementById("loadout-select") as HTMLSelectElement | null;
    const progress = document.getElementById("loadout-progress");
    const lists = Array.from(document.querySelectorAll<HTMLElement>("[data-loadout]"));
    const storageKey = "vv_prepping_loadouts_v1";
    let state: Record<string, boolean> = {};
    try { state = JSON.parse(localStorage.getItem(storageKey) || "{}"); } catch { state = {}; }
    const update = () => {
      const active = select?.value || "blackout";
      lists.forEach((list) => { list.hidden = list.dataset.loadout !== active; });
      const checks = Array.from(document.querySelectorAll<HTMLInputElement>(`[data-loadout="${active}"] input`));
      checks.forEach((check) => { check.checked = !!state[check.dataset.item || ""]; });
      const ready = checks.filter((check) => check.checked).length;
      if (progress) progress.textContent = `${ready} / ${checks.length} ready · ${checks.length - ready} missing`;
    };
    document.querySelectorAll<HTMLInputElement>("[data-item]").forEach((check) => check.addEventListener("change", () => {
      state[check.dataset.item || ""] = check.checked;
      localStorage.setItem(storageKey, JSON.stringify(state));
      update();
    }));
    select?.addEventListener("change", update);
    document.getElementById("loadout-reset")?.addEventListener("click", () => {
      const prefix = `${select?.value}:`;
      Object.keys(state).filter((key) => key.startsWith(prefix)).forEach((key) => delete state[key]);
      localStorage.setItem(storageKey, JSON.stringify(state));
      update();
    });
    update();
  </script>
</Base>
