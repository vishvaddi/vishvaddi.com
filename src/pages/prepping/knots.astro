---
import Base from "../../layouts/Base.astro";
import "../../styles/prepping.css";

const knots = [
  {
    id: "figure-eight", reference: "https://www.animatedknots.com/figure-8-knot", name: "Figure Eight", job: "Stop a rope running through a hole or device.", caution: "Leave a tail at least ten rope diameters long.",
    steps: [
      "Make a bight and cross the working end over the standing part.",
      "Take the working end behind the standing part.",
      "Pass the working end through the first loop and dress the knot.",
    ],
  },
  {
    id: "bowline", reference: "https://www.animatedknots.com/bowline-knot", name: "Bowline", job: "Make a fixed loop for a shelter line or tying to a post.", caution: "Can shake loose when unloaded. Check the tail and dressing each time; not for climbing or rescue.",
    steps: [
      "Form a small loop with the working end on top.",
      "Bring the working end up through the loop and around the standing part.",
      "Return through the small loop, hold the loop size and dress firmly.",
    ],
  },
  {
    id: "sheet-bend", reference: "https://www.animatedknots.com/sheet-bend-knot", name: "Sheet Bend", job: "Join two ropes, including ropes of unequal diameter.", caution: "Put the thinner rope around the thicker rope’s bight; use a double sheet bend when security matters.",
    steps: [
      "Make a bight in the thicker rope.",
      "Pass the thinner rope up through the bight and around both legs.",
      "Tuck the thinner working end beneath itself; both tails finish on the same side.",
    ],
  },
  {
    id: "round-turn", reference: "https://www.animatedknots.com/round-turn-two-half-hitches-knot", name: "Round Turn + Two Half Hitches", job: "Secure a loaded line to a post, tree or ring with controlled tension.", caution: "Protect living trees from rope damage and inspect the hitches after loading.",
    steps: [
      "Take a full round turn around the anchor.",
      "Wrap the working end around the standing part and through to form a half hitch.",
      "Repeat beside the first hitch and pull both snug.",
    ],
  },
  {
    id: "adjustable-grip", reference: "https://www.animatedknots.com/adjustable-grip-hitch-knot", name: "Adjustable Grip Hitch", job: "Tension a tent guyline, ridge line or clothesline, then slide to adjust.", caution: "Test it on your actual cord; slick modern line may need an extra wrap.",
    steps: [
      "Run the working end around the anchor and back beside the standing part.",
      "Wrap twice around the standing part, working towards the anchor.",
      "Wrap around BOTH ropes, then tuck the working end under this last wrap. Dress and test; adjust only when unloaded, well away from the anchor.",
    ],
  },
  {
    id: "truckers-hitch", reference: "https://www.animatedknots.com/truckers-hitch-knot", name: "Trucker’s Hitch", job: "Create mechanical advantage for tarps and securing non-critical loads.", caution: "High tension can damage rope and anchors. Use rated restraints for road cargo.",
    steps: [
      "Form a slip loop in the standing part, well away from the anchor: twist a small loop, then pull a bight of the standing part through it. This slipped-overhand loop shakes out after use.",
      "Take the working end around the anchor and back up through the slip loop.",
      "Haul the free end to tension, then lock it with two half hitches.",
    ],
  },
  {
    id: "alpine-butterfly", reference: "https://www.animatedknots.com/alpine-butterfly-loop-knot", name: "Alpine Butterfly", job: "Make a strong fixed loop in the middle of a rope, loadable in three directions.", caution: "Dress the two shoulders symmetrically before loading.",
    steps: [
      "Make two overlapping turns in a bight.",
      "Fold the outer loop behind the crossing turns.",
      "Bring that loop up through the centre and pull all three parts to dress.",
    ],
  },
  {
    id: "square-lashing", reference: "https://www.animatedknots.com/square-lashing-knot", name: "Square Lashing", job: "Bind two poles crossing at roughly a right angle for a shelter or frame.", caution: "Start and finish with secure hitches; frapping turns provide the final stiffness.",
    support: true,
    steps: [
      "Start with a clove hitch on the upright and trap the tail.",
      "Take three firm wrapping turns around both poles.",
      "Add two tight frapping turns between the poles, then finish with a clove hitch.",
    ],
  },
];
---

<Base title="Essential Survival Knots" description="An animated guide to eight practical knots for shelter, joining, tensioning and hauling.">
  <nav class="prep-modes" aria-label="Prepping sections">
    <a href="/prepping">Guide</a><a href="/prepping/gear">Gear</a><a href="/prepping/health">Health</a><a href="/prepping/tools">Field tools</a><a href="/prepping/pack">Pack list</a><a href="/prepping/science">Science</a><a href="/prepping/fitness">Fitness</a><a href="/prepping/planting">Planting</a><a href="/prepping/howto">How-to</a><a href="/prepping/knots" class="active">Knots</a>
  </nav>

  <article class="knots-guide">
    <p class="eyebrow">Field skills / original diagrams</p>
    <h1>Eight knots worth knowing cold</h1>
    <p>Choose by job, practise with real cord, then test close to the ground. The clips reveal expanded rope paths. Use the tying demonstration linked under each knot to learn the hand movements, then dress your knot and check it.</p>
    <aside class="knot-warning"><strong>Not for climbing or life support.</strong> Knots reduce rope strength and can fail when poorly dressed, shock-loaded or tied in unsuitable cord. Use rated equipment and qualified instruction where failure could injure someone.</aside>

    <div class="knot-index" aria-label="Jump to knot">
      {knots.map((knot) => <a href={`#${knot.id}`}>{knot.name}</a>)}
    </div>
    <div class="mastery-bar">
      <button type="button" id="knot-test-me">Test me</button>
      <span id="knot-mastery-summary">Loading practice history…</span>
      <button type="button" id="knot-reset">Reset practice</button>
    </div>

    <div class="knot-grid">
      {knots.map((knot) => (
        <section class="knot-card" id={knot.id} data-knot={knot.id}>
          <header><div><h2>{knot.name}</h2><p>{knot.job}</p></div><span class="knot-count">1 / {knot.steps.length}</span></header>
          <div class="knot-stage">
            <video data-knot-animation src={`/media/knots/${knot.id}-step-1.mp4`} poster={`/media/knots/${knot.id}-step-1.webp`} muted playsinline preload="none" aria-label={`${knot.name}, step 1. Use the controls below to play or scrub.`}></video>
          </div>
          <p class="knot-step" aria-live="polite">{knot.steps[0]}</p>
          <div class="knot-controls">
            <button type="button" data-action="prev" aria-label={`Previous ${knot.name} step`}>←</button>
            <button type="button" data-action="play" aria-label={`Play ${knot.name} step`}>Play step</button>
            <button type="button" data-action="next" aria-label={`Next ${knot.name} step`}>→</button>
            <label>Speed <select data-knot-speed aria-label={`${knot.name} playback speed`}><option value="0.5">Extra slow</option><option value="1" selected>Slow</option><option value="1.5">Practice</option></select></label>
          </div>
          <label class="knot-timeline">Step progress <input data-knot-seek type="range" min="0" max="100" value="0" step="0.1" aria-label={`Scrub ${knot.name} step`} /></label>
          <p class="knot-playback-status" data-playback-status role="status">Paused. Play when your rope is ready.</p>
          <div class="practice-controls">
            <button type="button" data-action="practice">Practise blind</button>
            <button type="button" data-action="correct" hidden>I tied it correctly</button>
            <button type="button" data-action="reveal" hidden>Reveal steps</button>
            <span data-mastery-status>Not practised</span>
          </div>
          <p class="knot-caution"><strong>Check:</strong> {knot.caution}</p>
          <p class="knot-source"><a href={knot.reference} rel="external">Tying demonstration and technique reference ↗</a></p>
        </section>
      ))}
    </div>

    <h2>Fast selection</h2>
    <ul><li><strong>Stop:</strong> Figure Eight.</li><li><strong>Fixed loop:</strong> Bowline; Alpine Butterfly in the middle of a rope.</li><li><strong>Join:</strong> Sheet Bend.</li><li><strong>Anchor:</strong> Round Turn + Two Half Hitches.</li><li><strong>Adjust:</strong> Adjustable Grip Hitch.</li><li><strong>Tension:</strong> Trucker’s Hitch.</li><li><strong>Build:</strong> Square Lashing.</li></ul>
    <p class="knot-source">Technique cross-checked against <a href="https://www.animatedknots.com/" rel="external">Animated Knots by Grog</a>. Their illustrations are copyrighted; every diagram and animation on this page is an original, simplified teaching graphic.</p>
  </article>

  <script type="application/json" id="knot-data" set:html={JSON.stringify(knots)}></script>
  <script src="/scripts/prepping-knots.js" defer></script>
</Base>

<style>
  .knots-guide { max-width: 56rem; margin-inline: auto; }
  .knot-warning { margin: 1rem 0; padding: 0.9rem 1rem; border-left: 4px solid #b42318; background: color-mix(in srgb, #b42318 8%, transparent); }
  .knot-index { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1.2rem 0; }
  .knot-index a { padding: 0.35rem 0.6rem; border: 1px solid var(--rule); border-radius: 999px; color: var(--fg); text-decoration: none; font-size: 0.82rem; }
  .knot-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); gap: 1rem; }
  .knot-card { scroll-margin-top: 1rem; padding: 1rem; border: 1px solid var(--rule); border-radius: 10px; }
  .knot-card header { display: flex; justify-content: space-between; gap: 1rem; }
  .knot-card h2 { margin: 0; font-size: 1.15rem; }
  .knot-card header p { margin: 0.25rem 0 0; color: var(--muted); font-size: 0.9rem; }
  .knot-count { flex: 0 0 auto; font: 0.75rem var(--font-mono); color: var(--muted); }
  .knot-stage { position: relative; margin: 0.8rem 0; border-radius: 8px; overflow: hidden; background: color-mix(in srgb, var(--fg) 5%, transparent); }
  .knot-stage video { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: contain; background: #111820; }
  .knot-timeline { display: flex; align-items: center; gap: 0.7rem; margin-top: 0.7rem; font-size: 0.8rem; color: var(--muted); }
  .knot-timeline input { flex: 1; min-width: 0; min-height: 44px; }
  .knot-playback-status { min-height: 2.5em; font-size: 0.8rem; color: var(--muted); }
  .knot-step { min-height: 3.2em; font-size: 0.92rem; }
  .knot-controls { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .knot-controls button, .knot-controls select { min-height: 40px; padding: 0.4rem 0.65rem; border: 1px solid var(--rule); border-radius: 6px; background: var(--bg); color: var(--fg); }
  .knot-controls label { margin-left: auto; color: var(--muted); font-size: 0.8rem; }
  .knot-caution, .knot-source { color: var(--muted); font-size: 0.84rem; }
  .mastery-bar, .practice-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 0.55rem; }
  .mastery-bar { margin: 0 0 1rem; padding: 0.75rem; border: 1px solid var(--rule); border-radius: 8px; }
  .mastery-bar span { flex: 1; color: var(--muted); font-size: 0.85rem; }
  .mastery-bar button, .practice-controls button { min-height: 40px; padding: 0.4rem 0.65rem; border: 1px solid var(--rule); border-radius: 6px; background: var(--bg); color: var(--fg); }
  .practice-controls { margin-top: 0.7rem; }
  .practice-controls span { margin-left: auto; color: var(--muted); font: 0.75rem var(--font-mono); }
  .knot-card.practice-blind .knot-stage video, .knot-card.practice-blind .knot-step, .knot-card.practice-blind .knot-controls, .knot-card.practice-blind .knot-timeline, .knot-card.practice-blind .knot-playback-status { visibility: hidden; }
  .knot-card.practice-blind .knot-stage::after { content: "Tie this knot from memory for the job above. Check dressing, tail length and the caution before revealing."; position: absolute; inset: 0; display: grid; place-items: center; padding: 1rem; border: 1px dashed var(--rule); border-radius: 8px; color: var(--muted); text-align: center; }
</style>
